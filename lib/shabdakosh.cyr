# shabdakosh.cyr -- bundled distribution
# Version: 3.1.4
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/shabdakosh.deps):
include "lib/mmap.cyr"

# --- error.cyr ---

# error.cyr — shabdakosh error codes, built on sakshi's packed-i64 error model.
#
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other — the entry file (src/main.cyr / tests/*.tcyr) orders
# includes; the stdlib (incl. sakshi) auto-resolves from cyrius.cyml [deps].
#
# Also the home of the crate's shared L0 primitives (SHBDK_PH_NONE, shbdk_copyz)
# — see the sections below.
#
# Ports 3.1.3:rust-old/src/error.rs (the `ShabdakoshError` enum — #[non_exhaustive],
# 4 variants). Rust carried a String payload per variant + a thiserror Display;
# the Cyrius port drops the payloads and builds on sakshi (साक्षी — the AGNOS
# error/tracing substrate): each error is a packed i64 `[ctx][category][code]`.
# 0 == ok, non-zero == error. Diagnostic text lives in shbdk_err_name().
#
# CONVENTION: a fallible fn returns a packed shabda error (0 == ok) and writes
# any payload to an out-param, OR returns a payload pointer with 0 meaning
# "none" — disambiguate with shbdk_is_err(). No thiserror/Display; sakshi does
# the packing (sakshi_err_new / sakshi_err_code / sakshi_err_category).
#
# NAMING: every top-level symbol is `shbdk_`/`SHBDK_`-prefixed (flat link
# namespace; coexists with svara / varna / sakshi).

# ================================================================
# Error codes (was `enum ShabdakoshError`). One per Rust variant, in order.
# Stored in bits 0-15 of a sakshi packed error; kept above sakshi's common
# ErrCode block (0..7) to avoid collision.
# ================================================================
var SHBDK_ERR_DICT_PARSE         = 0x0101;   # DictParseError(String)
var SHBDK_ERR_UNKNOWN_SYMBOL     = 0x0102;   # UnknownSymbol(String)
var SHBDK_ERR_PHONEME_NOT_IN_INV = 0x0103;   # PhonemeNotInInventory { phoneme, language }
var SHBDK_ERR_UNKNOWN_LANGUAGE   = 0x0104;   # UnknownLanguage(String)

# ================================================================
# Shared phoneme sentinel. A svara phoneme is an ordinal 0..100; this is the
# "no phoneme" value (Rust's Option::None on a phoneme lookup). Lives in the L0
# base so every module (arpabet, ipa, ...) shares ONE definition (flat namespace).
# ================================================================
var SHBDK_PH_NONE = (0 - 1);

# ================================================================
# Shared L0 primitive: NUL-terminated byte copy.
#
# Lives here for the same reason SHBDK_PH_NONE does — error.cyr is the L0 base
# every build/test entry includes first, so this is the one place a helper can
# sit without coupling two sibling modules or breaking a module's independence
# (detect.cyr and notation.cyr link without the dictionary keystone, and
# binary.cyr links without the text-format module).
#
# 3.0.5: collapses five near-identical copies — _shbdk_fmt_dup and
# _shbdk_fmt_lower_dup (format/mod.cyr), _shbdk_bin_dup (format/binary.cyr),
# _shbdk_trie_dup_n (trie.cyr), _shbdk_dupz (validate.cyr) and
# _shbdk_substr_cstr (notation.cyr) — which differed only in how they addressed
# the source. They also disagreed on the alloc-failure sentinel (0 vs ""), and
# a 0 would have been dereferenced by several callers; "" is now uniform.
# ================================================================
# Fresh NUL-terminated copy of the `len` bytes at `src`. A negative length is
# clamped to 0; on allocation failure returns "" (a readable empty cstr), never 0.
#
# CALLER NOTE: the failure sentinel is a string LITERAL, i.e. read-only memory.
# Anything that writes back into the returned buffer (only _shbdk_fmt_lower_dup
# does today) must drive its loop off the copy's own NUL rather than the length
# it asked for, so the failure path stays a no-op instead of storing into rodata.
#must_use
fn shbdk_copyz(src, len): cstring {
    if (len < 0) { len = 0; }
    var out = alloc(len + 1);
    if (out == 0) { return ""; }
    memcpy(out, src, len);
    store8(out + len, 0);
    return out;
}

# Lexicographic byte compare of two cstrings: -1 if a<b, 0 if equal, 1 if a>b.
#
# 3.0.5: was duplicated byte-for-byte as _shbdk_cstr_cmp (detect.cyr) and
# _shbdk_wordcmp (validate.cyr). The backlog kept them apart because sharing
# would have coupled two sibling modules — but L0 is not a sibling, so hoisting
# it here costs nothing beyond detect.tcyr gaining the error.cyr include that
# every other entry already has.
#must_use
fn shbdk_cstrcmp(a, b): i64 {
    var i = 0;
    var ca = 0;
    var cb = 0;
    while (1 == 1) {
        ca = load8(a + i);
        cb = load8(b + i);
        if (ca != cb) {
            if (ca < cb) { return (0 - 1); }
            return 1;
        }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Shared L0 text primitives: UTF-8, Unicode whitespace / punctuation, lowercase.
#
# 3.1.3: the tokenizers (notation parse, coverage, the CMUdict / IPA readers) split
# and trimmed on ASCII whitespace only, coverage stripped ASCII punctuation only,
# and lookups lowercased ASCII only, so "hello<NBSP>world" was one token, a
# curly-quoted word never matched, and "ÉCOLE" never found "école". These give
# every module the Unicode behaviour from one definition. The tables are the
# stdlib's lib/unicode (casefold + categories), which the bayan fold carries.
# ================================================================
# Decode the code point at p[i] (p[i..n) readable) into store64(out). Returns its
# byte length (1..4). An ill-formed sequence (stray continuation byte, overlong,
# surrogate, > U+10FFFF, truncated) decodes as U+FFFD with length 1, so the byte
# after it is never swallowed (Unicode 3.9, "maximal subpart" substitution).
fn shbdk_utf8_decode(p, i, n, out): i64 {
    var b0 = load8(p + i);
    if (b0 < 128) { store64(out, b0); return 1; }
    var need = 0;
    var cp = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { need = 1; cp = b0 & 31; }
    if (b0 >= 224 && b0 <= 239) {
        need = 2;
        cp = b0 & 15;
        if (b0 == 224) { lo = 160; }   # E0 A0..BF: no overlongs
        if (b0 == 237) { hi = 159; }   # ED 80..9F: no surrogates
    }
    if (b0 >= 240 && b0 <= 244) {
        need = 3;
        cp = b0 & 7;
        if (b0 == 240) { lo = 144; }   # F0 90..BF: no overlongs
        if (b0 == 244) { hi = 143; }   # F4 80..8F: <= U+10FFFF
    }
    if (need == 0 || i + need >= n) { store64(out, 65533); return 1; }   # bytes i+1..i+need must be < n
    var k = 1;
    var c = 0;
    while (k <= need) {
        c = load8(p + i + k);
        if (k == 1) {
            if (c < lo || c > hi) { store64(out, 65533); return 1; }
        } else {
            if ((c & 192) != 128) { store64(out, 65533); return 1; }
        }
        cp = (cp << 6) | (c & 63);
        k = k + 1;
    }
    store64(out, cp);
    return need + 1;
}

# Decode the code point that ENDS at p[e] (bytes [s, e) readable) into out.
# Returns its byte length, or 0 if e <= s. A malformed tail decodes as one byte.
fn shbdk_utf8_decode_before(p, s, e, out): i64 {
    if (e <= s) { store64(out, 0); return 0; }
    var j = e - 1;
    while (j > s && e - j < 4 && (load8(p + j) & 192) == 128) { j = j - 1; }
    if (shbdk_utf8_decode(p, j, e, out) == e - j) { return e - j; }
    store64(out, 65533);
    return 1;
}

# 1 if `cp` has the Unicode White_Space property (what Rust's split_whitespace
# and trim use): TAB..CR, space, NEL, NBSP, OGHAM SPACE, U+2000..200A, LINE and
# PARAGRAPH SEPARATOR, NNBSP, MMSP, IDEOGRAPHIC SPACE.
#must_use
fn shbdk_cp_is_ws(cp): i64 {
    if (cp == 32) { return 1; }
    if (cp >= 9 && cp <= 13) { return 1; }
    if (cp < 133) { return 0; }
    if (cp == 133 || cp == 160 || cp == 5760) { return 1; }
    if (cp >= 8192 && cp <= 8202) { return 1; }
    if (cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288) { return 1; }
    return 0;
}

# Byte length of the whitespace code point at p[i] (p[i..n) readable), or 0.
#must_use
fn shbdk_ws_len(p, i, n): i64 {
    var b = load8(p + i);
    if (b < 128) { return shbdk_cp_is_ws(b); }
    var cpb[8];
    var k = shbdk_utf8_decode(p, i, n, &cpb);
    if (shbdk_cp_is_ws(load64(&cpb)) == 1) { return k; }
    return 0;
}

# Byte length of the whitespace code point ending at p[e] (bytes [s, e)), or 0.
#must_use
fn shbdk_ws_len_before(p, s, e): i64 {
    if (e <= s) { return 0; }
    var b = load8(p + e - 1);
    if (b < 128) { return shbdk_cp_is_ws(b); }
    var cpb[8];
    var k = shbdk_utf8_decode_before(p, s, e, &cpb);
    if (shbdk_cp_is_ws(load64(&cpb)) == 1) { return k; }
    return 0;
}

# 1 if `cp` is punctuation or a symbol: in ASCII exactly Rust's
# is_ascii_punctuation set, elsewhere General Category P* or S* (curly quotes,
# guillemets, dashes, the ellipsis, CJK and fullwidth punctuation, currency, emoji).
#must_use
fn shbdk_cp_is_punct(cp): i64 {
    if (cp < 128) {
        if (cp >= 33 && cp <= 47) { return 1; }    # ! " # $ % & ' ( ) * + , - . /
        if (cp >= 58 && cp <= 64) { return 1; }    # : ; < = > ? @
        if (cp >= 91 && cp <= 96) { return 1; }    # [ \ ] ^ _ `
        if (cp >= 123 && cp <= 126) { return 1; }  # { | } ~
        return 0;
    }
    var gc = unicode_category(cp);
    if (gc >= GC_PC && gc <= GC_SO) { return 1; }
    return 0;
}

# 1 if `cp` is a cased letter (for the final-sigma rule).
fn _shbdk_cp_is_cased(cp): i64 {
    var gc = unicode_category(cp);
    if (gc == GC_LU || gc == GC_LL || gc == GC_LT) { return 1; }
    return 0;
}

# 1 if `cp` is case-ignorable (marks, format characters, modifiers, and the
# word-internal apostrophes / periods / colons Unicode lists).
fn _shbdk_cp_is_case_ignorable(cp): i64 {
    if (cp == 39 || cp == 46 || cp == 58 || cp == 94 || cp == 96 || cp == 183) { return 1; }
    if (cp == 8216 || cp == 8217 || cp == 8228 || cp == 8231) { return 1; }
    var gc = unicode_category(cp);
    if (gc == GC_MN || gc == GC_ME || gc == GC_CF || gc == GC_LM || gc == GC_SK) { return 1; }
    return 0;
}

# Is the capital sigma at p[i..i+2) word-final? (Rust's to_lowercase rule: a cased
# letter before it and none after it, skipping case-ignorable code points.)
fn _shbdk_sigma_is_final(p, i, n): i64 {
    var cpb[8];
    var j = i;
    var k = 0;
    var before = 0;
    while (j > 0) {
        k = shbdk_utf8_decode_before(p, 0, j, &cpb);
        if (_shbdk_cp_is_case_ignorable(load64(&cpb)) == 0) {
            before = _shbdk_cp_is_cased(load64(&cpb));
            break;
        }
        j = j - k;
    }
    if (before == 0) { return 0; }
    j = i + 2;
    while (j < n) {
        k = shbdk_utf8_decode(p, j, n, &cpb);
        if (_shbdk_cp_is_case_ignorable(load64(&cpb)) == 0) {
            if (_shbdk_cp_is_cased(load64(&cpb)) == 1) { return 0; }
            return 1;
        }
        j = j + k;
    }
    return 1;
}

# Fresh NUL-terminated lowercase copy of the n bytes at p, with Rust's
# str::to_lowercase semantics: every code point's Unicode lowercase mapping, U+0130
# to "i" + U+0307, and a capital sigma to final ς at the end of a word. ASCII input
# takes a byte loop. On allocation failure returns "" (as shbdk_copyz does).
#must_use
fn shbdk_lower_n(p, n): cstring {
    var i = 0;
    var ascii = 1;
    while (i < n) {
        if (load8(p + i) >= 128) { ascii = 0; break; }
        i = i + 1;
    }
    var out = 0;
    var c = 0;
    if (ascii == 1) {
        out = alloc(n + 1);
        if (out == 0) { return ""; }
        i = 0;
        while (i < n) {
            c = load8(p + i);
            if (c >= 65 && c <= 90) { c = c + 32; }
            store8(out + i, c);
            i = i + 1;
        }
        store8(out + n, 0);
        return out;
    }
    out = alloc(n * 2 + 4);   # a lowercase mapping grows a code point by at most 1 byte
    if (out == 0) { return ""; }
    var cpb[8];
    var o = 0;
    var k = 0;
    var cp = 0;
    i = 0;
    while (i < n) {
        k = shbdk_utf8_decode(p, i, n, &cpb);
        cp = load64(&cpb);
        if (cp == 65533 && k == 1 && load8(p + i) >= 128) {
            store8(out + o, load8(p + i));   # keep an ill-formed byte as it was
            o = o + 1;
        } else {
            if (cp == 304) {
                o = o + _uc_emit_utf8(out + o, 105);
                o = o + _uc_emit_utf8(out + o, 775);
            } else {
                if (cp == 931) {
                    if (_shbdk_sigma_is_final(p, i, n) == 1) { cp = 962; } else { cp = 963; }
                } else {
                    cp = unicode_to_lower(cp);
                }
                o = o + _uc_emit_utf8(out + o, cp);
            }
        }
        i = i + k;
    }
    store8(out + o, 0);
    return out;
}

# shbdk_lower_n over a whole cstr. A null cstr gives "".
#must_use
fn shbdk_lower_cstr(s): cstring {
    if (s == 0) { return ""; }
    return shbdk_lower_n(s, strlen(s));
}

# 1 if lowercasing the cstr would leave it unchanged (the lookup fast path: no
# copy). One pass over ASCII; at the first non-ASCII byte the rest is decoded and
# each code point must be its own lowercase mapping.
#must_use
fn shbdk_is_lower_cstr(s): i64 {
    var i = 0;
    var c = load8(s);
    while (c != 0) {
        if (c >= 65) {
            if (c <= 90) { return 0; }
            if (c >= 128) { return _shbdk_is_lower_tail(s, i); }
        }
        i = i + 1;
        c = load8(s + i);
    }
    return 1;
}

# The non-ASCII half of shbdk_is_lower_cstr, from byte i.
fn _shbdk_is_lower_tail(s, i): i64 {
    var n = i + strlen(s + i);
    var c = 0;
    var k = 0;
    var cpb[8];
    while (i < n) {
        c = load8(s + i);
        if (c < 128) {
            if (c >= 65 && c <= 90) { return 0; }
            i = i + 1;
        } else {
            k = shbdk_utf8_decode(s, i, n, &cpb);
            c = load64(&cpb);
            if (c == 304 || c == 931) { return 0; }
            if (c != 65533 && unicode_to_lower(c) != c) { return 0; }
            i = i + k;
        }
    }
    return 1;
}

# ================================================================
# Diagnostics (3.1.3) — the detail the Rust carried in DictParseError(String).
#
# A parser that fails still returns 0 (or a packed error); the reason is now kept
# here, as the Rust's message was: "line 3: unknown ARPABET symbol 'XX1'". Each
# parse entry point clears it on entry, so after a failed call it describes that
# failure; after a successful one it is "".
# ================================================================
var _SHBDK_LAST_ERROR = "";

# Why the last failed parse / load failed, or "" (never null).
#must_use
fn shbdk_last_error(): cstring {
    return _SHBDK_LAST_ERROR;
}

# Forget the last diagnostic.
fn shbdk_clear_error(): i64 {
    _SHBDK_LAST_ERROR = "";
    return 0;
}

# Record `msg` and return 0, so a failing parser can `return _shbdk_fail("...")`.
fn _shbdk_fail(msg): i64 {
    _SHBDK_LAST_ERROR = msg;
    return 0;
}

# Record "line N: <msg><detail><tail>" and return 0. `detail` / `tail` may be 0
# (omitted); `detail` is a cstr, or a byte range [ds, de) of `src` when src != 0.
fn _shbdk_fail_line(line, msg, src, ds, de, tail): i64 {
    var sb = str_builder_new();
    if (line > 0) {
        str_builder_add_cstr(sb, "line ");
        str_builder_add_int(sb, line);
        str_builder_add_cstr(sb, ": ");
    }
    str_builder_add_cstr(sb, msg);
    if (src != 0) {
        var i = ds;
        while (i < de) { str_builder_add_byte(sb, load8(src + i)); i = i + 1; }
    }
    if (tail != 0) { str_builder_add_cstr(sb, tail); }
    _SHBDK_LAST_ERROR = str_data(str_builder_build(sb));
    return 0;
}

# 1 if p[0..n) is well-formed UTF-8 (no stray continuation, overlong, surrogate or
# truncated sequence). Text inputs must be: an ill-formed byte would otherwise
# reach a key and every export after it (JSON / XML) would be invalid.
#must_use
fn shbdk_utf8_valid(p, n): i64 {
    var cpb[8];
    var i = 0;
    var k = 0;
    while (i < n) {
        if (load8(p + i) < 128) {
            i = i + 1;
        } else {
            k = shbdk_utf8_decode(p, i, n, &cpb);
            if (k == 1 && load64(&cpb) == 65533) {
                # U+FFFD itself is 3 bytes, so a 1-byte U+FFFD is always a decode failure
                return 0;
            }
            i = i + k;
        }
    }
    return 1;
}

# ================================================================
# CMUdict text rules shared by the runtime reader (format/mod.cyr) and the data
# generator (programs/gen_cmudict.cyr), so the two read a file the same way (3.1.3).
# ================================================================
# 1 if input[vs..ve) is a decimal number as Rust's f32::from_str reads one:
# [+-] then digits[.digits] | .digits, then an optional [eE][+-]digits.
#
# 3.1.3: the old check only looked at the character set, so `1.2.3`, `1e`, `.`,
# `1-2`, `1e+` and `.e5` loaded as the numeric prefix f64_parse_ok took.
fn shbdk_decimal_syntax(input, vs, ve): i64 {
    var i = vs;
    var c = 0;
    if (i < ve) {
        c = load8(input + i);
        if (c == 43 || c == 45) { i = i + 1; }
    }
    var int_digits = 0;
    while (i < ve && load8(input + i) >= 48 && load8(input + i) <= 57) { int_digits = int_digits + 1; i = i + 1; }
    var frac_digits = 0;
    if (i < ve && load8(input + i) == 46) {
        i = i + 1;
        while (i < ve && load8(input + i) >= 48 && load8(input + i) <= 57) { frac_digits = frac_digits + 1; i = i + 1; }
    }
    if (int_digits + frac_digits == 0) { return 0; }
    if (i < ve) {
        c = load8(input + i);
        if (c != 101 && c != 69) { return 0; }
        i = i + 1;
        if (i < ve) {
            c = load8(input + i);
            if (c == 43 || c == 45) { i = i + 1; }
        }
        var exp_digits = 0;
        while (i < ve && load8(input + i) >= 48 && load8(input + i) <= 57) { exp_digits = exp_digits + 1; i = i + 1; }
        if (exp_digits == 0) { return 0; }
    }
    if (i != ve) { return 0; }
    return 1;
}

# End of the word in input[s..e) once a trailing CMUdict variant marker `(digits)`
# is cut, or e if there is none. Only a marker AFTER at least one character counts,
# so the real CMUdict words "(PAREN" and ")CLOSE-PAREN" stay whole.
#
# 3.1.3: the word was everything before the first '(' (as in the Rust), so
# "(PAREN" stored the empty word and "a(b" stored "a".
fn shbdk_cmudict_word_end(input, s, e): i64 {
    if (e - s < 4) { return e; }
    if (load8(input + e - 1) != 41) { return e; }   # ')'
    var j = e - 2;
    while (j > s && load8(input + j) >= 48 && load8(input + j) <= 57) { j = j - 1; }
    if (j == e - 2) { return e; }                    # no digits
    if (load8(input + j) != 40) { return e; }        # '('
    if (j == s) { return e; }                        # nothing before the marker
    return j;
}

# ================================================================
# Constructors — pack the shabda code + a sakshi category into an i64 error.
# ================================================================
#must_use
fn shbdk_err_dict_parse(): i64 {
    return sakshi_err_new(SHBDK_ERR_DICT_PARSE, ERR_CAT_PARSE);
}

# An unrecognized ARPABET symbol was encountered (ERR_CAT_PARSE).
#must_use
fn shbdk_err_unknown_symbol(): i64 {
    return sakshi_err_new(SHBDK_ERR_UNKNOWN_SYMBOL, ERR_CAT_PARSE);
}

# A phoneme is not in the target language's inventory (ERR_CAT_RUNTIME).
#must_use
fn shbdk_err_phoneme_not_in_inventory(): i64 {
    return sakshi_err_new(SHBDK_ERR_PHONEME_NOT_IN_INV, ERR_CAT_RUNTIME);
}

# An unknown language code was provided (ERR_CAT_CONFIG).
#must_use
fn shbdk_err_unknown_language(): i64 {
    return sakshi_err_new(SHBDK_ERR_UNKNOWN_LANGUAGE, ERR_CAT_CONFIG);
}

# ================================================================
# Predicates + diagnostics (thin over sakshi, prefixed for the shabda surface).
# ================================================================
# 1 if `err` is an error (non-zero), 0 otherwise.
#must_use
fn shbdk_is_err(err): i64 {
    return sakshi_is_err(err);
}

# 1 if `err` is ok (zero), 0 otherwise.
#must_use
fn shbdk_is_ok(err): i64 {
    return sakshi_is_ok(err);
}

# Static diagnostic text for a shabda error (was thiserror's Display). Takes a
# packed error, matches on its code field. The final arm is the
# #[non_exhaustive] fallback. Returns `cstring` (not `i64`) so println/fmt
# dispatch on the pointer type and print the text, not the address.
#must_use
fn shbdk_err_name(err): cstring {
    var code = sakshi_err_code(err);
    if (code == SHBDK_ERR_DICT_PARSE)         { return "dictionary parse error"; }
    if (code == SHBDK_ERR_UNKNOWN_SYMBOL)     { return "unknown ARPABET symbol"; }
    if (code == SHBDK_ERR_PHONEME_NOT_IN_INV) { return "phoneme not in inventory"; }
    if (code == SHBDK_ERR_UNKNOWN_LANGUAGE)   { return "unknown language"; }
    if (sakshi_is_err(err) == 0)               { return "ok"; }   # 3.1.3: was `code == 0`, which
    return "unknown error";                    # named a category-only error "ok"
}

# --- arpabet.cyr ---

# arpabet.cyr — ARPABET <-> svara phoneme mapping.
#
# Ports 3.1.3:rust-old/src/arpabet.rs. svara phonemes are the SVARA_PH_* integer
# ordinals (0..100) provided by the svara bundle; "no phoneme" is the sentinel
# SHBDK_PH_NONE (-1) (Rust's Option::None). ARPABET vowels carry a stress digit
# (0/1/2) stripped before lookup; unstressed AH (0) is schwa, stressed AH is
# cup-v.
#
# programs/gen_cmudict.cyr (the base-dict codegen) includes THIS file, so the
# generated data and the runtime share one mapping (the Rust duplicated it in
# build.rs).
#
# 3.1.3: IY is the FLEECE vowel /iː/ (SVARA_PH_VOWEL_LONG_I). The Rust mapped it to
# SVARA_PH_VOWEL_E, /e/, which svara synthesises with /e/ formants ("see" said as
# "say") and which varna's English inventory does not have. In the other direction
# /iː/ and /i/ both write IY1 (ARPABET marks no length), and /e/ writes nothing:
# ARPABET has no plain /e/ (EY is the diphthong /eɪ/), as it has no /a/ or /o/.
#
# Included after lib/svara.cyr (SVARA_PH_*) and src/error.cyr (SHBDK_PH_NONE) —
# the entry file orders it.

# Byte-exact compare of the first `len` bytes of cstr `sym` against cstr `lit`
# (matches only if `lit` is also exactly `len` long). Internal helper — lets the
# lookup run over a base symbol without allocating a truncated copy.
fn _shbdk_arp_eq(sym, len, lit): i64 {
    if (strlen(lit) != len) { return 0; }
    var i = 0;
    while (i < len) {
        if (load8(sym + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Core lookup over the first `len` bytes of `sym`. Both public entry points call
# this. Returns a SVARA_PH_* ordinal or SHBDK_PH_NONE.
fn _shbdk_arpabet_lookup(sym, len): i64 {
    # --- Vowels ---
    if (_shbdk_arp_eq(sym, len, "AA")) { return SVARA_PH_VOWEL_OPEN_A; }
    if (_shbdk_arp_eq(sym, len, "AE")) { return SVARA_PH_VOWEL_ASH; }
    if (_shbdk_arp_eq(sym, len, "AH")) { return SVARA_PH_VOWEL_CUP_V; }
    if (_shbdk_arp_eq(sym, len, "AO")) { return SVARA_PH_VOWEL_OPEN_O; }
    if (_shbdk_arp_eq(sym, len, "AW")) { return SVARA_PH_DIPH_AU; }
    if (_shbdk_arp_eq(sym, len, "AY")) { return SVARA_PH_DIPH_AI; }
    if (_shbdk_arp_eq(sym, len, "EH")) { return SVARA_PH_VOWEL_OPEN_E; }
    if (_shbdk_arp_eq(sym, len, "ER")) { return SVARA_PH_VOWEL_BIRD; }
    if (_shbdk_arp_eq(sym, len, "EY")) { return SVARA_PH_DIPH_EI; }
    if (_shbdk_arp_eq(sym, len, "IH")) { return SVARA_PH_VOWEL_NEAR_I; }
    if (_shbdk_arp_eq(sym, len, "IY")) { return SVARA_PH_VOWEL_LONG_I; }   # FLEECE /iː/ (3.1.3; was /e/)
    if (_shbdk_arp_eq(sym, len, "OW")) { return SVARA_PH_DIPH_OU; }
    if (_shbdk_arp_eq(sym, len, "OY")) { return SVARA_PH_DIPH_OI; }
    if (_shbdk_arp_eq(sym, len, "UH")) { return SVARA_PH_VOWEL_NEAR_U; }
    if (_shbdk_arp_eq(sym, len, "UW")) { return SVARA_PH_VOWEL_U; }
    # --- Consonants ---
    if (_shbdk_arp_eq(sym, len, "B"))  { return SVARA_PH_PLOSIVE_B; }
    if (_shbdk_arp_eq(sym, len, "CH")) { return SVARA_PH_AFFR_CH; }
    if (_shbdk_arp_eq(sym, len, "D"))  { return SVARA_PH_PLOSIVE_D; }
    if (_shbdk_arp_eq(sym, len, "DH")) { return SVARA_PH_FRIC_DH; }
    if (_shbdk_arp_eq(sym, len, "F"))  { return SVARA_PH_FRIC_F; }
    if (_shbdk_arp_eq(sym, len, "G"))  { return SVARA_PH_PLOSIVE_G; }
    if (_shbdk_arp_eq(sym, len, "HH")) { return SVARA_PH_FRIC_H; }
    if (_shbdk_arp_eq(sym, len, "JH")) { return SVARA_PH_AFFR_J; }
    if (_shbdk_arp_eq(sym, len, "K"))  { return SVARA_PH_PLOSIVE_K; }
    if (_shbdk_arp_eq(sym, len, "L"))  { return SVARA_PH_LATERAL_L; }
    if (_shbdk_arp_eq(sym, len, "M"))  { return SVARA_PH_NASAL_M; }
    if (_shbdk_arp_eq(sym, len, "N"))  { return SVARA_PH_NASAL_N; }
    if (_shbdk_arp_eq(sym, len, "NG")) { return SVARA_PH_NASAL_NG; }
    if (_shbdk_arp_eq(sym, len, "P"))  { return SVARA_PH_PLOSIVE_P; }
    if (_shbdk_arp_eq(sym, len, "R"))  { return SVARA_PH_APPROX_R; }
    if (_shbdk_arp_eq(sym, len, "S"))  { return SVARA_PH_FRIC_S; }
    if (_shbdk_arp_eq(sym, len, "SH")) { return SVARA_PH_FRIC_SH; }
    if (_shbdk_arp_eq(sym, len, "T"))  { return SVARA_PH_PLOSIVE_T; }
    if (_shbdk_arp_eq(sym, len, "TH")) { return SVARA_PH_FRIC_TH; }
    if (_shbdk_arp_eq(sym, len, "V"))  { return SVARA_PH_FRIC_V; }
    if (_shbdk_arp_eq(sym, len, "W"))  { return SVARA_PH_APPROX_W; }
    if (_shbdk_arp_eq(sym, len, "Y"))  { return SVARA_PH_APPROX_J; }
    if (_shbdk_arp_eq(sym, len, "Z"))  { return SVARA_PH_FRIC_Z; }
    if (_shbdk_arp_eq(sym, len, "ZH")) { return SVARA_PH_FRIC_ZH; }
    return SHBDK_PH_NONE;
}

# ARPABET symbol (WITHOUT stress digit) -> svara phoneme ordinal, or
# SHBDK_PH_NONE. (Rust arpabet_to_phoneme.)
#must_use
fn shbdk_arpabet_to_phoneme(sym): i64 {
    return _shbdk_arpabet_lookup(sym, strlen(sym));
}

# Trailing stress digit of an ARPABET symbol: 0/1/2, or SHBDK_PH_NONE if the
# last char isn't a stress digit. (Rust strip_stress's Option<u8> half.)
#must_use
fn shbdk_arpabet_stress(sym): i64 {
    var len = strlen(sym);
    if (len == 0) { return SHBDK_PH_NONE; }
    var last = load8(sym + len - 1);
    if (last == 48) { return 0; }   # '0'
    if (last == 49) { return 1; }   # '1'
    if (last == 50) { return 2; }   # '2'
    return SHBDK_PH_NONE;
}

# Byte length of the base symbol (without a trailing stress digit). (Rust
# strip_stress's &str half — a length rather than an allocated slice.)
#must_use
fn shbdk_arpabet_base_len(sym): i64 {
    var len = strlen(sym);
    if (len == 0) { return 0; }
    var last = load8(sym + len - 1);
    if (last == 48) { return len - 1; }
    if (last == 49) { return len - 1; }
    if (last == 50) { return len - 1; }
    return len;
}

# ARPABET symbol (possibly with stress digit) -> svara phoneme, handling the
# AH/schwa distinction: unstressed AH (0) -> schwa; stressed AH -> cup-v.
# (Rust arpabet_to_phoneme_with_stress.)
#must_use
fn shbdk_arpabet_to_phoneme_with_stress(sym): i64 {
    var base_len = shbdk_arpabet_base_len(sym);
    # Special case: unstressed AH is schwa.
    if (shbdk_arpabet_stress(sym) == 0) {
        if (_shbdk_arp_eq(sym, base_len, "AH")) { return SVARA_PH_VOWEL_SCHWA; }
    }
    return _shbdk_arpabet_lookup(sym, base_len);
}

# svara phoneme ordinal -> ARPABET symbol (vowels emit stress digit "1", schwa
# "AH0"), or 0 (null cstr) for phonemes with no ARPABET equivalent. (Rust
# phoneme_to_arpabet.)
#must_use
fn shbdk_phoneme_to_arpabet(ph): cstring {
    # --- Vowels ---
    if (ph == SVARA_PH_VOWEL_OPEN_A) { return "AA1"; }
    if (ph == SVARA_PH_VOWEL_ASH)    { return "AE1"; }
    if (ph == SVARA_PH_VOWEL_SCHWA)  { return "AH0"; }
    if (ph == SVARA_PH_VOWEL_CUP_V)  { return "AH1"; }
    if (ph == SVARA_PH_VOWEL_OPEN_O) { return "AO1"; }
    if (ph == SVARA_PH_DIPH_AU)      { return "AW1"; }
    if (ph == SVARA_PH_DIPH_AI)      { return "AY1"; }
    if (ph == SVARA_PH_VOWEL_OPEN_E) { return "EH1"; }
    if (ph == SVARA_PH_VOWEL_BIRD)   { return "ER1"; }
    if (ph == SVARA_PH_DIPH_EI)      { return "EY1"; }
    if (ph == SVARA_PH_VOWEL_NEAR_I) { return "IH1"; }
    if (ph == SVARA_PH_VOWEL_LONG_I) { return "IY1"; }
    if (ph == SVARA_PH_VOWEL_I)      { return "IY1"; }   # ARPABET marks no length: /i/ is IY too
    if (ph == SVARA_PH_DIPH_OU)      { return "OW1"; }
    if (ph == SVARA_PH_DIPH_OI)      { return "OY1"; }
    if (ph == SVARA_PH_VOWEL_NEAR_U) { return "UH1"; }
    if (ph == SVARA_PH_VOWEL_U)      { return "UW1"; }
    # --- Consonants ---
    if (ph == SVARA_PH_PLOSIVE_B) { return "B"; }
    if (ph == SVARA_PH_AFFR_CH)   { return "CH"; }
    if (ph == SVARA_PH_PLOSIVE_D) { return "D"; }
    if (ph == SVARA_PH_FRIC_DH)   { return "DH"; }
    if (ph == SVARA_PH_FRIC_F)    { return "F"; }
    if (ph == SVARA_PH_PLOSIVE_G) { return "G"; }
    if (ph == SVARA_PH_FRIC_H)    { return "HH"; }
    if (ph == SVARA_PH_AFFR_J)    { return "JH"; }
    if (ph == SVARA_PH_PLOSIVE_K) { return "K"; }
    if (ph == SVARA_PH_LATERAL_L) { return "L"; }
    if (ph == SVARA_PH_NASAL_M)   { return "M"; }
    if (ph == SVARA_PH_NASAL_N)   { return "N"; }
    if (ph == SVARA_PH_NASAL_NG)  { return "NG"; }
    if (ph == SVARA_PH_PLOSIVE_P) { return "P"; }
    if (ph == SVARA_PH_APPROX_R)  { return "R"; }
    if (ph == SVARA_PH_FRIC_S)    { return "S"; }
    if (ph == SVARA_PH_FRIC_SH)   { return "SH"; }
    if (ph == SVARA_PH_PLOSIVE_T) { return "T"; }
    if (ph == SVARA_PH_FRIC_TH)   { return "TH"; }
    if (ph == SVARA_PH_FRIC_V)    { return "V"; }
    if (ph == SVARA_PH_APPROX_W)  { return "W"; }
    if (ph == SVARA_PH_APPROX_J)  { return "Y"; }
    if (ph == SVARA_PH_FRIC_Z)    { return "Z"; }
    if (ph == SVARA_PH_FRIC_ZH)   { return "ZH"; }
    return 0;   # null cstr == None
}

# --- ipa.cyr ---

# ipa.cyr — IPA <-> svara phoneme mapping + a greedy IPA-transcription parser.
#
# Ports 3.1.3:rust-old/src/ipa.rs. IPA symbols are multi-byte UTF-8, so where the Rust
# parser sliced on Unicode chars this works on BYTES: exact lookups compare whole
# cstrs (streq), and the parser does greedy LONGEST-BYTE-PREFIX matching
# (5-byte tie-bar affricates down to 1-byte ASCII). svara phonemes are SVARA_PH_*
# ordinals; "no phoneme" is SHBDK_PH_NONE (from error.cyr).
#
# Included after lib/svara.cyr (SVARA_PH_*) and src/error.cyr — the entry orders it.

# 1 if the bytes of cstr `ipa` starting at `pos` begin with cstr `lit` (whole of
# `lit`). Stops at the first mismatch, so it never reads past `ipa`'s NUL.
fn _shbdk_ipa_starts_with(ipa, pos, lit): i64 {
    var n = strlen(lit);
    var j = 0;
    while (j < n) {
        if (load8(ipa + pos + j) != load8(lit + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# ---- The symbol table --------------------------------------------------------
# 3.1.3: the bridge covers every svara phoneme that has an IPA symbol (0..99; 100 is
# silence). The Rust's, and the port's through 3.1.2, covered 46: the extended vowels
# (y ø œ ɯ ɤ ɨ ʉ), the uvular / retroflex / pharyngeal / lateral consonants, the
# trills, clicks, ejectives and implosives were dropped on export and skipped on
# parse, so German ç, Hindi ɦ or a Spanish trill vanished from a lexicon.
#
# Two more accuracy fixes ride along: an affricate is written with its tie bar
# (t͡ʃ, d͡ʒ — the unambiguous IPA, and varna's spelling), and `r` is the alveolar
# TRILL, as IPA defines it (it read as the English approximant ɹ). The parser
# still reads a bare tʃ / dʒ as the affricate (the common broad spelling, and what
# 3.1.2 wrote), but a bare ts / dz / pf is a cluster ("cats" is t + s): only the tie
# bar or a ligature (ʦ ʣ ʧ ʤ) makes those an affricate.

# Canonical IPA for a svara phoneme ordinal, or 0 (null cstr) for silence / an
# out-of-range value. (Rust phoneme_to_ipa.)
#must_use
fn shbdk_phoneme_to_ipa(ph): cstring {
    if (ph == SVARA_PH_VOWEL_A) { return "a"; }
    if (ph == SVARA_PH_VOWEL_E) { return "e"; }
    if (ph == SVARA_PH_VOWEL_I) { return "i"; }
    if (ph == SVARA_PH_VOWEL_O) { return "o"; }
    if (ph == SVARA_PH_VOWEL_U) { return "u"; }
    if (ph == SVARA_PH_VOWEL_SCHWA) { return "ə"; }
    if (ph == SVARA_PH_VOWEL_OPEN_O) { return "ɔ"; }
    if (ph == SVARA_PH_VOWEL_ASH) { return "æ"; }
    if (ph == SVARA_PH_VOWEL_NEAR_I) { return "ɪ"; }
    if (ph == SVARA_PH_VOWEL_NEAR_U) { return "ʊ"; }
    if (ph == SVARA_PH_VOWEL_OPEN_A) { return "ɑ"; }
    if (ph == SVARA_PH_VOWEL_OPEN_E) { return "ɛ"; }
    if (ph == SVARA_PH_VOWEL_CUP_V) { return "ʌ"; }
    if (ph == SVARA_PH_VOWEL_BIRD) { return "ɜ"; }
    if (ph == SVARA_PH_VOWEL_LONG_I) { return "iː"; }
    if (ph == SVARA_PH_DIPH_AI) { return "aɪ"; }
    if (ph == SVARA_PH_DIPH_AU) { return "aʊ"; }
    if (ph == SVARA_PH_DIPH_OI) { return "ɔɪ"; }
    if (ph == SVARA_PH_DIPH_EI) { return "eɪ"; }
    if (ph == SVARA_PH_DIPH_OU) { return "oʊ"; }
    if (ph == SVARA_PH_PLOSIVE_P) { return "p"; }
    if (ph == SVARA_PH_PLOSIVE_B) { return "b"; }
    if (ph == SVARA_PH_PLOSIVE_T) { return "t"; }
    if (ph == SVARA_PH_PLOSIVE_D) { return "d"; }
    if (ph == SVARA_PH_PLOSIVE_K) { return "k"; }
    if (ph == SVARA_PH_PLOSIVE_G) { return "ɡ"; }
    if (ph == SVARA_PH_FRIC_F) { return "f"; }
    if (ph == SVARA_PH_FRIC_V) { return "v"; }
    if (ph == SVARA_PH_FRIC_S) { return "s"; }
    if (ph == SVARA_PH_FRIC_Z) { return "z"; }
    if (ph == SVARA_PH_FRIC_SH) { return "ʃ"; }
    if (ph == SVARA_PH_FRIC_ZH) { return "ʒ"; }
    if (ph == SVARA_PH_FRIC_TH) { return "θ"; }
    if (ph == SVARA_PH_FRIC_DH) { return "ð"; }
    if (ph == SVARA_PH_FRIC_H) { return "h"; }
    if (ph == SVARA_PH_NASAL_M) { return "m"; }
    if (ph == SVARA_PH_NASAL_N) { return "n"; }
    if (ph == SVARA_PH_NASAL_NG) { return "ŋ"; }
    if (ph == SVARA_PH_AFFR_CH) { return "t͡ʃ"; }
    if (ph == SVARA_PH_AFFR_J) { return "d͡ʒ"; }
    if (ph == SVARA_PH_GLOTTAL_STOP) { return "ʔ"; }
    if (ph == SVARA_PH_TAP_FLAP) { return "ɾ"; }
    if (ph == SVARA_PH_LATERAL_L) { return "l"; }
    if (ph == SVARA_PH_APPROX_R) { return "ɹ"; }
    if (ph == SVARA_PH_APPROX_W) { return "w"; }
    if (ph == SVARA_PH_APPROX_J) { return "j"; }
    if (ph == SVARA_PH_VOWEL_Y) { return "y"; }
    if (ph == SVARA_PH_VOWEL_FRONT_ROUND_O) { return "ø"; }
    if (ph == SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O) { return "œ"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_BACK_UNROUNDED) { return "ɯ"; }
    if (ph == SVARA_PH_VOWEL_MID_BACK_UNROUNDED) { return "ɤ"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_CENTRAL) { return "ɨ"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_CENTRAL_ROUNDED) { return "ʉ"; }
    if (ph == SVARA_PH_PLOSIVE_UVULAR_Q) { return "q"; }
    if (ph == SVARA_PH_PLOSIVE_UVULAR_G) { return "ɢ"; }
    if (ph == SVARA_PH_PLOSIVE_RETRO_T) { return "ʈ"; }
    if (ph == SVARA_PH_PLOSIVE_RETRO_D) { return "ɖ"; }
    if (ph == SVARA_PH_FRIC_BILABIAL_PH) { return "ɸ"; }
    if (ph == SVARA_PH_FRIC_BILABIAL_B) { return "β"; }
    if (ph == SVARA_PH_FRIC_PALATAL_C) { return "ç"; }
    if (ph == SVARA_PH_FRIC_PALATAL_J) { return "ʝ"; }
    if (ph == SVARA_PH_FRIC_UVULAR_CH) { return "χ"; }
    if (ph == SVARA_PH_FRIC_UVULAR_R) { return "ʁ"; }
    if (ph == SVARA_PH_FRIC_PHARYNGEAL_H) { return "ħ"; }
    if (ph == SVARA_PH_FRIC_PHARYNGEAL_A) { return "ʕ"; }
    if (ph == SVARA_PH_FRIC_RETRO_S) { return "ʂ"; }
    if (ph == SVARA_PH_FRIC_RETRO_Z) { return "ʐ"; }
    if (ph == SVARA_PH_FRIC_LATERAL_S) { return "ɬ"; }
    if (ph == SVARA_PH_FRIC_LATERAL_Z) { return "ɮ"; }
    if (ph == SVARA_PH_FRIC_GLOTTAL_H) { return "ɦ"; }
    if (ph == SVARA_PH_NASAL_RETRO) { return "ɳ"; }
    if (ph == SVARA_PH_NASAL_PALATAL) { return "ɲ"; }
    if (ph == SVARA_PH_NASAL_UVULAR) { return "ɴ"; }
    if (ph == SVARA_PH_TRILL_BILABIAL) { return "ʙ"; }
    if (ph == SVARA_PH_TRILL_ALVEOLAR) { return "r"; }
    if (ph == SVARA_PH_TRILL_UVULAR) { return "ʀ"; }
    if (ph == SVARA_PH_APPROX_RETRO) { return "ɻ"; }
    if (ph == SVARA_PH_LATERAL_PALATAL) { return "ʎ"; }
    if (ph == SVARA_PH_LATERAL_VELAR) { return "ʟ"; }
    if (ph == SVARA_PH_FLAP_RETRO) { return "ɽ"; }
    if (ph == SVARA_PH_FLAP_LATERAL) { return "ɺ"; }
    if (ph == SVARA_PH_AFFR_TS) { return "t͡s"; }
    if (ph == SVARA_PH_AFFR_DZ) { return "d͡z"; }
    if (ph == SVARA_PH_AFFR_RETRO) { return "ʈ͡ʂ"; }
    if (ph == SVARA_PH_AFFR_RETRO_VOICED) { return "ɖ͡ʐ"; }
    if (ph == SVARA_PH_AFFR_PF) { return "p͡f"; }
    if (ph == SVARA_PH_AFFR_LATERAL) { return "t͡ɬ"; }
    if (ph == SVARA_PH_CLICK_BILABIAL) { return "ʘ"; }
    if (ph == SVARA_PH_CLICK_DENTAL) { return "ǀ"; }
    if (ph == SVARA_PH_CLICK_ALVEOLAR) { return "ǃ"; }
    if (ph == SVARA_PH_CLICK_PALATAL) { return "ǂ"; }
    if (ph == SVARA_PH_CLICK_LATERAL) { return "ǁ"; }
    if (ph == SVARA_PH_EJECTIVE_P) { return "pʼ"; }
    if (ph == SVARA_PH_EJECTIVE_T) { return "tʼ"; }
    if (ph == SVARA_PH_EJECTIVE_K) { return "kʼ"; }
    if (ph == SVARA_PH_EJECTIVE_S) { return "sʼ"; }
    if (ph == SVARA_PH_EJECTIVE_CH) { return "t͡ʃʼ"; }
    if (ph == SVARA_PH_IMPLOSIVE_B) { return "ɓ"; }
    if (ph == SVARA_PH_IMPLOSIVE_D) { return "ɗ"; }
    if (ph == SVARA_PH_IMPLOSIVE_G) { return "ɠ"; }
    return 0;   # null cstr == None
}

# The parse table lives in its own anonymous mapping (never the bump arena: a
# consumer's alloc_reset() must not pull it out from under the next lookup; and not
# static data, which would add 22 KB to every binary). Rows are sorted by first
# byte, then longest symbol first, so the greedy match takes t͡ʃ before t and aɪ
# before a; START[b] .. START[b + 1] are the rows that start with byte b. Each
# table below is an address inside the mapping, in 8-byte slots.
var _SHBDK_IPA_SYM = 0;     # 128 rows: symbol cstr (a string literal)
var _SHBDK_IPA_PH = 0;      # 128 rows: svara phoneme
var _SHBDK_IPA_LEN = 0;     # 128 rows: symbol byte length
var _SHBDK_IPA_START = 0;   # 257 slots: first byte -> first row
var _SHBDK_IPA_EXT = 0;     # 101 slots: phoneme -> how many longer symbols start with its canonical one
var _SHBDK_IPA_CONT = 0;    # 101 * 16 slots: phoneme * 16 + j -> the rest of the j-th such symbol
var _SHBDK_IPA_CB = 0;      # 101 * 32 bytes: phoneme * 32 + byte / 8 -> bitmap of those rests' first bytes
var _SHBDK_IPA_BYTES = 24576;
var _SHBDK_IPA_ROWS = 0;
var _SHBDK_IPA_READY = 0;

fn _shbdk_ipa_add(sym, ph): i64 {
    var r = _SHBDK_IPA_ROWS;
    if (r >= 128) { return 0; }   # the mapping holds 128 rows (120 are used)
    store64(_SHBDK_IPA_SYM + r * 8, sym);
    store64(_SHBDK_IPA_PH + r * 8, ph);
    store64(_SHBDK_IPA_LEN + r * 8, strlen(sym));
    _SHBDK_IPA_ROWS = r + 1;
    return 0;
}

# 1 if row a sorts before row b: first byte ascending, then longer symbol first.
fn _shbdk_ipa_row_before(a, b): i64 {
    var fa = load8(load64(_SHBDK_IPA_SYM + a * 8));
    var fb = load8(load64(_SHBDK_IPA_SYM + b * 8));
    if (fa != fb) { return fa < fb; }
    return load64(_SHBDK_IPA_LEN + a * 8) > load64(_SHBDK_IPA_LEN + b * 8);
}

fn _shbdk_ipa_swap(a, b): i64 {
    var t = load64(_SHBDK_IPA_SYM + a * 8);
    store64(_SHBDK_IPA_SYM + a * 8, load64(_SHBDK_IPA_SYM + b * 8));
    store64(_SHBDK_IPA_SYM + b * 8, t);
    t = load64(_SHBDK_IPA_PH + a * 8);
    store64(_SHBDK_IPA_PH + a * 8, load64(_SHBDK_IPA_PH + b * 8));
    store64(_SHBDK_IPA_PH + b * 8, t);
    t = load64(_SHBDK_IPA_LEN + a * 8);
    store64(_SHBDK_IPA_LEN + a * 8, load64(_SHBDK_IPA_LEN + b * 8));
    store64(_SHBDK_IPA_LEN + b * 8, t);
    return 0;
}

fn _shbdk_ipa_tab(): i64 {
    if (_SHBDK_IPA_READY == 1) { return 1; }
    var mem = mmap_anon(_SHBDK_IPA_BYTES);
    if (mem == 0) {
        # no anonymous mapping (AGNOS): fall back to the allocator, zeroed
        mem = alloc(_SHBDK_IPA_BYTES);
        var z = 0;
        while (z < _SHBDK_IPA_BYTES) { store64(mem + z, 0); z = z + 8; }
    }
    _SHBDK_IPA_SYM = mem;
    _SHBDK_IPA_PH = mem + 1024;
    _SHBDK_IPA_LEN = mem + 2048;
    _SHBDK_IPA_START = mem + 3072;
    _SHBDK_IPA_EXT = mem + 5128;
    _SHBDK_IPA_CONT = mem + 5936;
    _SHBDK_IPA_CB = mem + 18864;
    _SHBDK_IPA_ROWS = 0;
    # canonical symbols first, so an exact lookup finds the canonical row
    _shbdk_ipa_add("a", SVARA_PH_VOWEL_A);
    _shbdk_ipa_add("e", SVARA_PH_VOWEL_E);
    _shbdk_ipa_add("i", SVARA_PH_VOWEL_I);
    _shbdk_ipa_add("o", SVARA_PH_VOWEL_O);
    _shbdk_ipa_add("u", SVARA_PH_VOWEL_U);
    _shbdk_ipa_add("ə", SVARA_PH_VOWEL_SCHWA);
    _shbdk_ipa_add("ɔ", SVARA_PH_VOWEL_OPEN_O);
    _shbdk_ipa_add("æ", SVARA_PH_VOWEL_ASH);
    _shbdk_ipa_add("ɪ", SVARA_PH_VOWEL_NEAR_I);
    _shbdk_ipa_add("ʊ", SVARA_PH_VOWEL_NEAR_U);
    _shbdk_ipa_add("ɑ", SVARA_PH_VOWEL_OPEN_A);
    _shbdk_ipa_add("ɛ", SVARA_PH_VOWEL_OPEN_E);
    _shbdk_ipa_add("ʌ", SVARA_PH_VOWEL_CUP_V);
    _shbdk_ipa_add("ɜ", SVARA_PH_VOWEL_BIRD);
    _shbdk_ipa_add("iː", SVARA_PH_VOWEL_LONG_I);
    _shbdk_ipa_add("aɪ", SVARA_PH_DIPH_AI);
    _shbdk_ipa_add("aʊ", SVARA_PH_DIPH_AU);
    _shbdk_ipa_add("ɔɪ", SVARA_PH_DIPH_OI);
    _shbdk_ipa_add("eɪ", SVARA_PH_DIPH_EI);
    _shbdk_ipa_add("oʊ", SVARA_PH_DIPH_OU);
    _shbdk_ipa_add("p", SVARA_PH_PLOSIVE_P);
    _shbdk_ipa_add("b", SVARA_PH_PLOSIVE_B);
    _shbdk_ipa_add("t", SVARA_PH_PLOSIVE_T);
    _shbdk_ipa_add("d", SVARA_PH_PLOSIVE_D);
    _shbdk_ipa_add("k", SVARA_PH_PLOSIVE_K);
    _shbdk_ipa_add("ɡ", SVARA_PH_PLOSIVE_G);
    _shbdk_ipa_add("f", SVARA_PH_FRIC_F);
    _shbdk_ipa_add("v", SVARA_PH_FRIC_V);
    _shbdk_ipa_add("s", SVARA_PH_FRIC_S);
    _shbdk_ipa_add("z", SVARA_PH_FRIC_Z);
    _shbdk_ipa_add("ʃ", SVARA_PH_FRIC_SH);
    _shbdk_ipa_add("ʒ", SVARA_PH_FRIC_ZH);
    _shbdk_ipa_add("θ", SVARA_PH_FRIC_TH);
    _shbdk_ipa_add("ð", SVARA_PH_FRIC_DH);
    _shbdk_ipa_add("h", SVARA_PH_FRIC_H);
    _shbdk_ipa_add("m", SVARA_PH_NASAL_M);
    _shbdk_ipa_add("n", SVARA_PH_NASAL_N);
    _shbdk_ipa_add("ŋ", SVARA_PH_NASAL_NG);
    _shbdk_ipa_add("t͡ʃ", SVARA_PH_AFFR_CH);
    _shbdk_ipa_add("d͡ʒ", SVARA_PH_AFFR_J);
    _shbdk_ipa_add("ʔ", SVARA_PH_GLOTTAL_STOP);
    _shbdk_ipa_add("ɾ", SVARA_PH_TAP_FLAP);
    _shbdk_ipa_add("l", SVARA_PH_LATERAL_L);
    _shbdk_ipa_add("ɹ", SVARA_PH_APPROX_R);
    _shbdk_ipa_add("w", SVARA_PH_APPROX_W);
    _shbdk_ipa_add("j", SVARA_PH_APPROX_J);
    _shbdk_ipa_add("y", SVARA_PH_VOWEL_Y);
    _shbdk_ipa_add("ø", SVARA_PH_VOWEL_FRONT_ROUND_O);
    _shbdk_ipa_add("œ", SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O);
    _shbdk_ipa_add("ɯ", SVARA_PH_VOWEL_CLOSE_BACK_UNROUNDED);
    _shbdk_ipa_add("ɤ", SVARA_PH_VOWEL_MID_BACK_UNROUNDED);
    _shbdk_ipa_add("ɨ", SVARA_PH_VOWEL_CLOSE_CENTRAL);
    _shbdk_ipa_add("ʉ", SVARA_PH_VOWEL_CLOSE_CENTRAL_ROUNDED);
    _shbdk_ipa_add("q", SVARA_PH_PLOSIVE_UVULAR_Q);
    _shbdk_ipa_add("ɢ", SVARA_PH_PLOSIVE_UVULAR_G);
    _shbdk_ipa_add("ʈ", SVARA_PH_PLOSIVE_RETRO_T);
    _shbdk_ipa_add("ɖ", SVARA_PH_PLOSIVE_RETRO_D);
    _shbdk_ipa_add("ɸ", SVARA_PH_FRIC_BILABIAL_PH);
    _shbdk_ipa_add("β", SVARA_PH_FRIC_BILABIAL_B);
    _shbdk_ipa_add("ç", SVARA_PH_FRIC_PALATAL_C);
    _shbdk_ipa_add("ʝ", SVARA_PH_FRIC_PALATAL_J);
    _shbdk_ipa_add("χ", SVARA_PH_FRIC_UVULAR_CH);
    _shbdk_ipa_add("ʁ", SVARA_PH_FRIC_UVULAR_R);
    _shbdk_ipa_add("ħ", SVARA_PH_FRIC_PHARYNGEAL_H);
    _shbdk_ipa_add("ʕ", SVARA_PH_FRIC_PHARYNGEAL_A);
    _shbdk_ipa_add("ʂ", SVARA_PH_FRIC_RETRO_S);
    _shbdk_ipa_add("ʐ", SVARA_PH_FRIC_RETRO_Z);
    _shbdk_ipa_add("ɬ", SVARA_PH_FRIC_LATERAL_S);
    _shbdk_ipa_add("ɮ", SVARA_PH_FRIC_LATERAL_Z);
    _shbdk_ipa_add("ɦ", SVARA_PH_FRIC_GLOTTAL_H);
    _shbdk_ipa_add("ɳ", SVARA_PH_NASAL_RETRO);
    _shbdk_ipa_add("ɲ", SVARA_PH_NASAL_PALATAL);
    _shbdk_ipa_add("ɴ", SVARA_PH_NASAL_UVULAR);
    _shbdk_ipa_add("ʙ", SVARA_PH_TRILL_BILABIAL);
    _shbdk_ipa_add("r", SVARA_PH_TRILL_ALVEOLAR);
    _shbdk_ipa_add("ʀ", SVARA_PH_TRILL_UVULAR);
    _shbdk_ipa_add("ɻ", SVARA_PH_APPROX_RETRO);
    _shbdk_ipa_add("ʎ", SVARA_PH_LATERAL_PALATAL);
    _shbdk_ipa_add("ʟ", SVARA_PH_LATERAL_VELAR);
    _shbdk_ipa_add("ɽ", SVARA_PH_FLAP_RETRO);
    _shbdk_ipa_add("ɺ", SVARA_PH_FLAP_LATERAL);
    _shbdk_ipa_add("t͡s", SVARA_PH_AFFR_TS);
    _shbdk_ipa_add("d͡z", SVARA_PH_AFFR_DZ);
    _shbdk_ipa_add("ʈ͡ʂ", SVARA_PH_AFFR_RETRO);
    _shbdk_ipa_add("ɖ͡ʐ", SVARA_PH_AFFR_RETRO_VOICED);
    _shbdk_ipa_add("p͡f", SVARA_PH_AFFR_PF);
    _shbdk_ipa_add("t͡ɬ", SVARA_PH_AFFR_LATERAL);
    _shbdk_ipa_add("ʘ", SVARA_PH_CLICK_BILABIAL);
    _shbdk_ipa_add("ǀ", SVARA_PH_CLICK_DENTAL);
    _shbdk_ipa_add("ǃ", SVARA_PH_CLICK_ALVEOLAR);
    _shbdk_ipa_add("ǂ", SVARA_PH_CLICK_PALATAL);
    _shbdk_ipa_add("ǁ", SVARA_PH_CLICK_LATERAL);
    _shbdk_ipa_add("pʼ", SVARA_PH_EJECTIVE_P);
    _shbdk_ipa_add("tʼ", SVARA_PH_EJECTIVE_T);
    _shbdk_ipa_add("kʼ", SVARA_PH_EJECTIVE_K);
    _shbdk_ipa_add("sʼ", SVARA_PH_EJECTIVE_S);
    _shbdk_ipa_add("t͡ʃʼ", SVARA_PH_EJECTIVE_CH);
    _shbdk_ipa_add("ɓ", SVARA_PH_IMPLOSIVE_B);
    _shbdk_ipa_add("ɗ", SVARA_PH_IMPLOSIVE_D);
    _shbdk_ipa_add("ɠ", SVARA_PH_IMPLOSIVE_G);
    # accepted alternates (parse only)
    _shbdk_ipa_add("ɝ", SVARA_PH_VOWEL_BIRD);
    _shbdk_ipa_add("ɚ", SVARA_PH_VOWEL_BIRD);
    _shbdk_ipa_add("g", SVARA_PH_PLOSIVE_G);
    _shbdk_ipa_add("tʃ", SVARA_PH_AFFR_CH);
    _shbdk_ipa_add("dʒ", SVARA_PH_AFFR_J);
    _shbdk_ipa_add("t͜ʃ", SVARA_PH_AFFR_CH);
    _shbdk_ipa_add("d͜ʒ", SVARA_PH_AFFR_J);
    _shbdk_ipa_add("t͜s", SVARA_PH_AFFR_TS);
    _shbdk_ipa_add("d͜z", SVARA_PH_AFFR_DZ);
    _shbdk_ipa_add("ʈ͜ʂ", SVARA_PH_AFFR_RETRO);
    _shbdk_ipa_add("ɖ͜ʐ", SVARA_PH_AFFR_RETRO_VOICED);
    _shbdk_ipa_add("p͜f", SVARA_PH_AFFR_PF);
    _shbdk_ipa_add("t͜ɬ", SVARA_PH_AFFR_LATERAL);
    _shbdk_ipa_add("t͜ʃʼ", SVARA_PH_EJECTIVE_CH);
    _shbdk_ipa_add("tʃʼ", SVARA_PH_EJECTIVE_CH);
    _shbdk_ipa_add("ʧ", SVARA_PH_AFFR_CH);
    _shbdk_ipa_add("ʤ", SVARA_PH_AFFR_J);
    _shbdk_ipa_add("ʦ", SVARA_PH_AFFR_TS);
    _shbdk_ipa_add("ʣ", SVARA_PH_AFFR_DZ);
    _shbdk_ipa_add("ɫ", SVARA_PH_LATERAL_L);
    # stable insertion sort (canonical rows stay ahead of alternates of equal length)
    var n = _SHBDK_IPA_ROWS;
    var i = 1;
    var j = 0;
    while (i < n) {
        j = i;
        while (j > 0 && _shbdk_ipa_row_before(j, j - 1) == 1) { _shbdk_ipa_swap(j, j - 1); j = j - 1; }
        i = i + 1;
    }
    var b = 0;
    var r = 0;
    while (b <= 256) {
        while (r < n && load8(load64(_SHBDK_IPA_SYM + r * 8)) < b) { r = r + 1; }
        store64(_SHBDK_IPA_START + b * 8, r);
        b = b + 1;
    }
    # which canonical symbols are a strict prefix of another symbol: only those can
    # merge with the next one, so only those need _shbdk_ipa_would_merge
    var p = 0;
    var cs = 0;
    var cl = 0;
    var q = 0;
    var ext = 0;
    while (p < 101) {
        ext = 0;
        cs = shbdk_phoneme_to_ipa(p);
        if (cs != 0) {
            cl = strlen(cs);
            q = load64(_SHBDK_IPA_START + load8(cs) * 8);
            while (q < load64(_SHBDK_IPA_START + (load8(cs) + 1) * 8)) {
                if (ext < 16 && load64(_SHBDK_IPA_LEN + q * 8) > cl && memeq(load64(_SHBDK_IPA_SYM + q * 8), cs,
                    cl) == 1) {
                    store64(_SHBDK_IPA_CONT + (p * 16 + ext) * 8, load64(_SHBDK_IPA_SYM + q * 8) + cl);
                    var fb = load8(load64(_SHBDK_IPA_SYM + q * 8) + cl);
                    var cbi = _SHBDK_IPA_CB + p * 32 + (fb >> 3);
                    store8(cbi, load8(cbi) | (1 << (fb & 7)));
                    ext = ext + 1;
                }
                q = q + 1;
            }
        }
        store64(_SHBDK_IPA_EXT + p * 8, ext);
        p = p + 1;
    }
    _SHBDK_IPA_READY = 1;
    return 1;
}

# Exact whole-string IPA symbol -> svara phoneme ordinal, or SHBDK_PH_NONE.
# (Rust ipa_to_phoneme.) Accepts the canonical symbols and the alternates above.
#must_use
fn shbdk_ipa_to_phoneme(ipa): i64 {
    if (ipa == 0) { return SHBDK_PH_NONE; }
    _shbdk_ipa_tab();
    var f = load8(ipa);
    var r = load64(_SHBDK_IPA_START + f * 8);
    var e = load64(_SHBDK_IPA_START + (f + 1) * 8);
    while (r < e) {
        if (streq(load64(_SHBDK_IPA_SYM + r * 8), ipa) == 1) { return load64(_SHBDK_IPA_PH + r * 8); }
        r = r + 1;
    }
    return SHBDK_PH_NONE;
}

# Longest phoneme match at byte `pos`. Returns (byte_len << 8) | phoneme on a
# match (phoneme is 0..100, fits the low byte), or 0 if nothing matches.
fn _shbdk_ipa_match_at(ipa, pos): i64 {
    _shbdk_ipa_tab();
    var f = load8(ipa + pos);
    var r = load64(_SHBDK_IPA_START + f * 8);
    var e = load64(_SHBDK_IPA_START + (f + 1) * 8);
    while (r < e) {
        if (_shbdk_ipa_starts_with(ipa, pos, load64(_SHBDK_IPA_SYM + r * 8)) == 1) {
            return (load64(_SHBDK_IPA_LEN + r * 8) << 8) | load64(_SHBDK_IPA_PH + r * 8);
        }
        r = r + 1;
    }
    return 0;
}

# Byte length of an IPA marker at `pos` (stress ˈ ˌ, length ː, syllable/enclosing
# . / [ ] and space), or 0 if `pos` isn't a marker.
fn _shbdk_ipa_marker_len(ipa, pos): i64 {
    var b = load8(ipa + pos);
    if (b == 46) { return 1; }   # '.'
    if (b == 47) { return 1; }   # '/'
    if (b == 91) { return 1; }   # '['
    if (b == 93) { return 1; }   # ']'
    if (b == 32) { return 1; }   # ' '
    if (_shbdk_ipa_starts_with(ipa, pos, "ˈ") == 1) { return 2; }   # primary stress
    if (_shbdk_ipa_starts_with(ipa, pos, "ˌ") == 1) { return 2; }   # secondary stress
    if (_shbdk_ipa_starts_with(ipa, pos, "ː") == 1) { return 2; }   # standalone length mark
    return 0;
}

# Parse a full IPA transcription into a vec of svara phoneme ordinals (greedy
# longest-match; strips markers; skips unrecognized bytes). (Rust parse_ipa_word.)
#must_use
fn shbdk_parse_ipa_word(ipa): i64 {
    var out = vec_new();
    var n = strlen(ipa);
    var i = 0;
    while (i < n) {
        var m = _shbdk_ipa_match_at(ipa, i);
        if (m != 0) {
            vec_push(out, m & 255);
            i = i + (m >> 8);
        } else {
            var skip = _shbdk_ipa_marker_len(ipa, i);
            if (skip > 0) {
                i = i + skip;
            } else {
                i = i + 1;   # unrecognized byte — skip silently
            }
        }
    }
    return out;
}

# Convert a vec of svara phoneme ordinals to an IPA cstr. (Rust phonemes_to_ipa.)
#
# 3.1.3: where two adjacent symbols would read back as ONE longer symbol — [a, ɪ] as
# the diphthong aɪ, [t, ʃ] as the affricate (a bare tʃ still reads as one, the
# common broad spelling and what 3.1.2 wrote) — a syllable break "." goes between
# them, so the transcription reads back as the same phonemes. Two vowels that do
# not form a diphthong are in hiatus, and an English t + ʃ that is not the
# affricate spans a syllable boundary, so the "." is also the right IPA there.
#must_use
fn shbdk_phonemes_to_ipa(phonemes): cstring {
    var sb = str_builder_new();
    var n = vec_len(phonemes);
    var i = 0;
    var prev = 0;
    var s = 0;
    var ph = 0;
    var prev_ph = 0 - 1;
    _shbdk_ipa_tab();
    while (i < n) {
        ph = vec_get(phonemes, i);
        s = shbdk_phoneme_to_ipa(ph);
        if (s != 0) {
            if (prev_ph >= 0 && _shbdk_ipa_would_merge(prev_ph, s) == 1) { str_builder_add_cstr(sb, "."); }
            str_builder_add_cstr(sb, s);
            prev_ph = ph;
        }
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# 1 if the reader, at the start of phoneme `a`'s symbol directly followed by the
# symbol `b`, would take a longer symbol than `a`'s: some symbol is `a`'s followed
# by a continuation that `b` begins with.
fn _shbdk_ipa_would_merge(a, b): i64 {
    var n = load64(_SHBDK_IPA_EXT + a * 8);
    if (n == 0) { return 0; }
    var c0 = load8(b);
    if (((load8(_SHBDK_IPA_CB + a * 32 + (c0 >> 3)) >> (c0 & 7)) & 1) == 0) { return 0; }
    var j = 0;
    var cont = 0;
    while (j < n) {
        cont = load64(_SHBDK_IPA_CONT + (a * 16 + j) * 8);
        if (load8(cont) == c0) {
            if (_shbdk_ipa_starts_with(b, 0, cont) == 1) { return 1; }
        }
        j = j + 1;
    }
    return 0;
}

# --- entry.cyr ---

# entry.cyr — dictionary entry types: pronunciations with frequency + region.
#
# Ports 3.1.3:rust-old/src/dictionary/entry.rs (Pronunciation, Region, DictEntry).
# Phoneme-agnostic: a Pronunciation stores a vec of svara phoneme ordinals (i64)
# and never references SVARA_PH_* itself, so this module needs only stdlib
# (vec / str / math). Option<f32> frequency and Option<Region> use sentinels.
#
# Serialization of the container types (Pronunciation / DictEntry) is hand-written
# in the format layer (permanent code), per the locked serde stance — not here.
# Region (a scalar) round-trips via its code (shbdk_region_from_code/_code).
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkPronunciation layout (24 bytes): [0]=phonemes(vec of i64) [8]=frequency(f64
#   bits, SHBDK_FREQ_NONE when absent) [16]=region(SHBDK_REGION_* or _NONE).
# ShbdkDictEntry layout (8 bytes): [0]=pronunciations(vec of ShbdkPronunciation*).

# ---- Region (#[non_exhaustive] enum) -----------------------------------------
var SHBDK_REGION_GA   = 0;          # GeneralAmerican
var SHBDK_REGION_RP   = 1;          # ReceivedPronunciation
var SHBDK_REGION_NONE = (0 - 1);    # Option<Region>::None

# Parse a region short code -> SHBDK_REGION_* or SHBDK_REGION_NONE.
#must_use
fn shbdk_region_from_code(code): i64 {
    if (streq(code, "GA") == 1) { return SHBDK_REGION_GA; }
    if (streq(code, "RP") == 1) { return SHBDK_REGION_RP; }
    return SHBDK_REGION_NONE;
}

# Region -> short code cstr ("GA"/"RP"), or 0 for NONE/unknown. (Also Display.)
#must_use
fn shbdk_region_code(region): cstring {
    if (region == SHBDK_REGION_GA) { return "GA"; }
    if (region == SHBDK_REGION_RP) { return "RP"; }
    return 0;
}

# ---- Pronunciation -----------------------------------------------------------
# f64 -1.0 bit pattern: Option<f32>::None sentinel AND the value the frequency
# sort treats None as (matches Rust's unwrap_or(-1.0)).
var SHBDK_FREQ_NONE = 0xBFF0000000000000;

# new(phonemes) — no frequency / region metadata. Takes the vec over (not copied).
#must_use
fn shbdk_pronunciation_new(phonemes): i64 {
    var p = alloc(24);
    store64(p + 0, phonemes);
    store64(p + 8, SHBDK_FREQ_NONE);
    store64(p + 16, SHBDK_REGION_NONE);
    return p;
}

# 1 if `f` (f64 bits) is a frequency: 0.0 <= f <= 1.0. NaN, the infinities and
# anything outside the range are not.
#
# 3.1.3: the documented contract is now enforced. The Rust (and the port through
# 3.1.2) stored any f32, so `@freq=5`, `nan` or `-1` loaded; a NaN made the variant
# sort non-total (the Rust panicked on one past 20 variants), and an exact -1.0
# collided with the "no frequency" sentinel. No valid frequency equals the
# sentinel now.
#must_use
fn shbdk_frequency_is_valid(f): i64 {
    if (f64_ge(f, 0) == 1 && f64_ge(0x3FF0000000000000, f) == 1) { return 1; }
    return 0;
}

# Builder: set relative frequency (f64 bits, 0.0-1.0). Mutates + returns self. A
# value that is not a frequency (shbdk_frequency_is_valid) is not stored: the
# pronunciation keeps the frequency it had.
#must_use
fn shbdk_pronunciation_with_frequency(p, frequency): i64 {
    if (shbdk_frequency_is_valid(frequency) == 0) { return p; }
    store64(p + 8, frequency);
    return p;
}

# Write the shortest decimal text of frequency `f` that reads back (f64_parse) as
# exactly `f` into buf (>= 32 bytes, NUL-terminated); returns its length. "0.5",
# "0.85", "1", "0.3333333333333333".
#
# 3.1.3: this replaces a fixed 6 decimals, which wrote 1/3 as 0.333333 and 1e-9 as
# 0 — a frequency did not survive its own export. A value too small for 18
# decimals (below 1e-18) is written with 18.
fn shbdk_frequency_text(f, buf): i64 {
    var d = 1;
    var n = 0;
    var back = alloc(8);
    while (d <= 18) {
        n = _shbdk_freq_fixed(f, buf, d);
        if (back != 0) {
            if (f64_parse_ok(buf, back) == 1 && load64(back) == f) { return n; }
        }
        d = d + 1;
    }
    return _shbdk_freq_fixed(f, buf, 18);
}

# fmt_float_buf with `d` decimals, trailing zeros and a bare '.' trimmed, NUL-terminated.
fn _shbdk_freq_fixed(f, buf, d): i64 {
    var n = fmt_float_buf(f, buf, d);
    while (n > 0 && load8(buf + n - 1) == 48) { n = n - 1; }   # '0'
    if (n > 0 && load8(buf + n - 1) == 46) { n = n - 1; }      # '.'
    if (n == 0) { store8(buf, 48); n = 1; }
    store8(buf + n, 0);
    return n;
}

# Builder: set regional variant. Mutates + returns self. A value that is not a
# SHBDK_REGION_* region leaves the pronunciation's region as it was.
#must_use
fn shbdk_pronunciation_with_region(p, region): i64 {
    # 3.1.3: only a real region is stored (a stray value reached the exporters,
    # where shbdk_region_code gave a null cstr and to_cmudict / to_json crashed).
    if (shbdk_region_code(region) == 0) { return p; }
    store64(p + 16, region);
    return p;
}

# Phoneme sequence (vec of i64 ordinals).
#must_use
fn shbdk_pronunciation_phonemes(p): i64 {
    return load64(p + 0);
}

# Relative frequency (f64 bits); SHBDK_FREQ_NONE if unset.
#must_use
fn shbdk_pronunciation_frequency(p): i64 {
    return load64(p + 8);
}

# 1 if a frequency is set, 0 otherwise (Option::is_some).
#must_use
fn shbdk_pronunciation_has_frequency(p): i64 {
    if (load64(p + 8) != SHBDK_FREQ_NONE) { return 1; }
    return 0;
}

# Regional variant (SHBDK_REGION_*); SHBDK_REGION_NONE if unset.
#must_use
fn shbdk_pronunciation_region(p): i64 {
    return load64(p + 16);
}

# 1 if a region is set, 0 otherwise.
#must_use
fn shbdk_pronunciation_has_region(p): i64 {
    if (load64(p + 16) != SHBDK_REGION_NONE) { return 1; }
    return 0;
}

# Deep copy of a pronunciation: a fresh struct over a fresh phoneme vec, so the
# copy shares nothing mutable with the original. (Rust derived Clone.)
#must_use
fn shbdk_pronunciation_clone(p): i64 {
    var phon = load64(p + 0);
    var out = vec_new();
    var n = vec_len(phon);
    var i = 0;
    while (i < n) {
        vec_push(out, vec_get(phon, i));
        i = i + 1;
    }
    var c = alloc(24);
    if (c == 0) { return 0; }
    store64(c + 0, out);
    store64(c + 8, load64(p + 8));
    store64(c + 16, load64(p + 16));
    return c;
}

# ---- DictEntry ---------------------------------------------------------------
# Insertion sort of a pronunciation vec by frequency DESC (None = -1.0 sorts
# last). Stable (equal frequencies keep insertion order), matching Rust sort_by.
fn _shbdk_sort_by_frequency(prons): i64 {
    var n = vec_len(prons);
    var i = 1;
    var cur = 0;
    var cur_f = 0;
    var j = 0;
    var placed = 0;
    var pj = 0;
    var fj = 0;
    var shift = 0;
    while (i < n) {
        cur = vec_get(prons, i);
        cur_f = load64(cur + 8);
        j = i - 1;
        placed = 0;
        while (placed == 0) {
            if (j < 0) {
                placed = 1;
            } else {
                pj = vec_get(prons, j);
                fj = load64(pj + 8);
                # Shift pj right iff cur strictly outranks pj: cur_f > fj, with
                # BOTH non-NaN. No f64_gt in stdlib, so: (cur_f >= fj) AND NOT
                # (fj >= cur_f). A NaN operand makes both f64_ge checks 0, so a
                # NaN frequency never shifts and stays in place — matching Rust's
                # partial_cmp().unwrap_or(Equal) + stable sort.
                shift = 0;
                if (f64_ge(cur_f, fj) == 1) {
                    if (f64_ge(fj, cur_f) == 0) {
                        shift = 1;
                    }
                }
                if (shift == 1) {
                    vec_set(prons, j + 1, pj);
                    j = j - 1;
                } else {
                    placed = 1;
                }
            }
        }
        vec_set(prons, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Entry with a single pronunciation.
#must_use
fn shbdk_dict_entry_new(pronunciation): i64 {
    var e = alloc(8);
    var prons = vec_new();
    vec_push(prons, pronunciation);
    store64(e + 0, prons);
    return e;
}

# Fresh copy of a phoneme vec (vec of i64 ordinals).
#must_use
fn shbdk_phonemes_clone(v): i64 {
    var out = vec_new();
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        vec_push(out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# Entry from a phoneme vec (single pronunciation, no metadata). The vec is copied,
# as the Rust's `from_phonemes(&[Phoneme])` did (3.1.3: it was shared, so a caller
# reusing its buffer rewrote the entry). shbdk_pronunciation_new, like the Rust's
# `Pronunciation::new(Vec)`, takes the vec over instead.
#must_use
fn shbdk_dict_entry_from_phonemes(phonemes): i64 {
    return shbdk_dict_entry_new(shbdk_pronunciation_new(shbdk_phonemes_clone(phonemes)));
}

# Entry from a vec of pronunciations. Returns 0 (None) if empty; else sorts by
# frequency descending.
#must_use
fn shbdk_dict_entry_from_pronunciations(prons): i64 {
    if (vec_len(prons) == 0) { return 0; }
    _shbdk_sort_by_frequency(prons);
    var e = alloc(8);
    store64(e + 0, prons);
    return e;
}

# Deep copy of an entry: a fresh pronunciation vec of freshly cloned
# pronunciations. (Rust derived Clone; the port needs it explicitly for merge —
# see shbdk_dict_merge.) Order is preserved, so no re-sort is needed.
#must_use
fn shbdk_dict_entry_clone(e): i64 {
    var prons = load64(e + 0);
    var out = vec_new();
    var n = vec_len(prons);
    var i = 0;
    while (i < n) {
        vec_push(out, shbdk_pronunciation_clone(vec_get(prons, i)));
        i = i + 1;
    }
    var c = alloc(8);
    if (c == 0) { return 0; }
    store64(c + 0, out);
    return c;
}

# Add a pronunciation variant; re-sorts by frequency.
fn shbdk_dict_entry_add_pronunciation(e, pronunciation): i64 {
    var prons = load64(e + 0);
    vec_push(prons, pronunciation);
    _shbdk_sort_by_frequency(prons);
    return 0;
}

# Primary (highest-frequency) pronunciation. Invariant: entry is non-empty.
#must_use
fn shbdk_dict_entry_primary(e): i64 {
    return vec_get(load64(e + 0), 0);
}

# Phonemes of the primary pronunciation.
#must_use
fn shbdk_dict_entry_primary_phonemes(e): i64 {
    return shbdk_pronunciation_phonemes(shbdk_dict_entry_primary(e));
}

# All pronunciations (the vec).
#must_use
fn shbdk_dict_entry_all(e): i64 {
    return load64(e + 0);
}

# First pronunciation matching `region`, or 0 (None). SHBDK_REGION_NONE is not a
# region, so it matches nothing (3.1.3: it returned the first unregioned variant, so
# for_region(region_from_code("XX")) found a pronunciation).
#must_use
fn shbdk_dict_entry_for_region(e, region): i64 {
    if (region == SHBDK_REGION_NONE) { return 0; }
    var prons = load64(e + 0);
    var n = vec_len(prons);
    var i = 0;
    var p = 0;
    while (i < n) {
        p = vec_get(prons, i);
        if (load64(p + 16) == region) { return p; }
        i = i + 1;
    }
    return 0;
}

# Number of pronunciation variants.
#must_use
fn shbdk_dict_entry_len(e): i64 {
    return vec_len(load64(e + 0));
}

# Always 0 (entries are guaranteed non-empty).
#must_use
fn shbdk_dict_entry_is_empty(e): i64 {
    return 0;
}

# --- morphology.cyr ---

# morphology.cyr — morphological decomposition (prefix / root / suffix / infix).
#
# Ports 3.1.3:rust-old/src/dictionary/morphology.rs. Phoneme-agnostic (stores phoneme
# ordinals in vecs) — stdlib only, no svara. Container serde (Morpheme /
# Decomposition) is handled by the format layer (L5) per the serde stance.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkMorpheme layout (24 bytes): [0]=text(cstr) [8]=kind(SHBDK_MORPH_*)
#   [16]=phonemes(vec of i64).
# ShbdkDecomposition layout (8 bytes): [0]=morphemes(vec of ShbdkMorpheme*).

# ---- MorphemeKind (#[non_exhaustive] enum) -----------------------------------
var SHBDK_MORPH_PREFIX = 0;
var SHBDK_MORPH_ROOT   = 1;
var SHBDK_MORPH_SUFFIX = 2;
var SHBDK_MORPH_INFIX  = 3;

# ---- Morpheme ----------------------------------------------------------------
# new(text, kind, phonemes). The text is copied, as the Rust's String was (3.1.3:
# it was stored by reference, so a caller reusing its buffer rewrote the morpheme).
#must_use
fn shbdk_morpheme_new(text, kind, phonemes): i64 {
    var m = alloc(24);
    if (text == 0) { text = ""; }
    store64(m + 0, shbdk_copyz(text, strlen(text)));
    store64(m + 8, kind);
    store64(m + 16, phonemes);
    return m;
}

# Written form (cstr).
#must_use
fn shbdk_morpheme_text(m): cstring {
    return load64(m + 0);
}

# Morpheme kind (SHBDK_MORPH_*).
#must_use
fn shbdk_morpheme_kind(m): i64 {
    return load64(m + 8);
}

# Isolated pronunciation (vec of phoneme ordinals).
#must_use
fn shbdk_morpheme_phonemes(m): i64 {
    return load64(m + 16);
}

# ---- Decomposition -----------------------------------------------------------
#must_use
fn shbdk_decomposition_new(morphemes): i64 {
    var d = alloc(8);
    store64(d + 0, morphemes);
    return d;
}

# The morphemes in order (vec of ShbdkMorpheme*).
#must_use
fn shbdk_decomposition_morphemes(d): i64 {
    return load64(d + 0);
}

# Composite pronunciation: concatenation of every morpheme's phonemes (flat_map).
#must_use
fn shbdk_decomposition_composite_phonemes(d): i64 {
    var out = vec_new();
    var ms = load64(d + 0);
    var n = vec_len(ms);
    var i = 0;
    var ph = 0;
    var pn = 0;
    var k = 0;
    while (i < n) {
        ph = load64(vec_get(ms, i) + 16);
        pn = vec_len(ph);
        k = 0;
        while (k < pn) {
            vec_push(out, vec_get(ph, k));
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

# Full written form: concatenation of every morpheme's text.
#must_use
fn shbdk_decomposition_text(d): cstring {
    var sb = str_builder_new();
    var ms = load64(d + 0);
    var n = vec_len(ms);
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, load64(vec_get(ms, i) + 0));
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# Number of morphemes.
#must_use
fn shbdk_decomposition_len(d): i64 {
    return vec_len(load64(d + 0));
}

# 1 if the decomposition has no morphemes.
#must_use
fn shbdk_decomposition_is_empty(d): i64 {
    if (vec_len(load64(d + 0)) == 0) { return 1; }
    return 0;
}

# Root morpheme, or 0 (None).
#must_use
fn shbdk_decomposition_root(d): i64 {
    var ms = load64(d + 0);
    var n = vec_len(ms);
    var i = 0;
    var m = 0;
    while (i < n) {
        m = vec_get(ms, i);
        if (load64(m + 8) == SHBDK_MORPH_ROOT) { return m; }
        i = i + 1;
    }
    return 0;
}

# Morphemes of a given kind (backs prefixes / suffixes).
fn _shbdk_decomposition_by_kind(d, kind): i64 {
    var out = vec_new();
    var ms = load64(d + 0);
    var n = vec_len(ms);
    var i = 0;
    var m = 0;
    while (i < n) {
        m = vec_get(ms, i);
        if (load64(m + 8) == kind) { vec_push(out, m); }
        i = i + 1;
    }
    return out;
}

# All prefix morphemes (vec of ShbdkMorpheme*).
#must_use
fn shbdk_decomposition_prefixes(d): i64 {
    return _shbdk_decomposition_by_kind(d, SHBDK_MORPH_PREFIX);
}

# All suffix morphemes (vec of ShbdkMorpheme*).
#must_use
fn shbdk_decomposition_suffixes(d): i64 {
    return _shbdk_decomposition_by_kind(d, SHBDK_MORPH_SUFFIX);
}

# --- syllable.cyr ---

# syllable.cyr — syllable structure + Maximal Onset Principle syllabification.
#
# Ports 3.1.3:rust-old/src/dictionary/syllable.rs. Operates on svara phoneme ordinals
# and asks svara which class each is (svara_phoneme_class), so it needs
# lib/svara.cyr ahead of it (3.1.3; it was stdlib only).
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkSyllable layout (16 bytes): [0]=phonemes(vec of i64) [8]=stress(SHBDK_STRESS_*).

# ---- StressLevel (#[non_exhaustive] enum) ------------------------------------
var SHBDK_STRESS_UNSTRESSED = 0;
var SHBDK_STRESS_PRIMARY    = 1;   # IPA ˈ
var SHBDK_STRESS_SECONDARY  = 2;   # IPA ˌ

# ---- Syllable ----------------------------------------------------------------
# new(phonemes) — unstressed.
#must_use
fn shbdk_syllable_new(phonemes): i64 {
    var s = alloc(16);
    store64(s + 0, phonemes);
    store64(s + 8, SHBDK_STRESS_UNSTRESSED);
    return s;
}

# Builder: set stress level. Mutates + returns self.
#must_use
fn shbdk_syllable_with_stress(s, stress): i64 {
    store64(s + 8, stress);
    return s;
}

# Phonemes in this syllable (vec of ordinals).
#must_use
fn shbdk_syllable_phonemes(s): i64 {
    return load64(s + 0);
}

# Stress level (SHBDK_STRESS_*).
#must_use
fn shbdk_syllable_stress(s): i64 {
    return load64(s + 8);
}

# Number of phonemes.
#must_use
fn shbdk_syllable_len(s): i64 {
    return vec_len(load64(s + 0));
}

# 1 if the syllable has no phonemes.
#must_use
fn shbdk_syllable_is_empty(s): i64 {
    if (vec_len(load64(s + 0)) == 0) { return 1; }
    return 0;
}

# ---- Syllabification ---------------------------------------------------------
# 3.1.3: two accuracy fixes, both wrong in the Rust as well.
#
# (1) A nucleus is any vowel or diphthong svara has, by svara_phoneme_class. The
#     Rust listed the 20 English ones, so the extended vowels y ø œ ɯ ɤ ɨ ʉ (46..52)
#     were consonants: "über" /ybə/ was one syllable.
# (2) It is the Maximal Onset Principle the doc always claimed: between two nuclei,
#     the next syllable takes the LONGEST run of consonants that is a legal onset.
#     The Rust kept exactly one consonant as coda whenever there were two or more,
#     so "astray" split as [əs][tɹeɪ] (MOP: [ə][stɹeɪ]), and "handbag" / "pumpkin"
#     got the illegal onsets /db/ and /pk/.
#
# Legal onsets: English's (below) when every consonant is an English phoneme, the
# Sonority Sequencing Principle otherwise (rising sonority toward the nucleus, with
# the s + stop exception). ŋ never begins a syllable. syllabify takes no language,
# and the crate's base dictionary is English.

# 1 if the phoneme is a vowel or diphthong (a syllable nucleus).
fn _shbdk_is_nucleus(p): i64 {
    var c = svara_phoneme_class(p);
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

# 1 if `p` is one of English's consonants (svara 20..45).
fn _shbdk_is_english_consonant(p): i64 {
    if (p >= 20 && p <= 45) { return 1; }
    return 0;
}

# Sonority rank for the SSP: stops / affricates / clicks / ejectives / implosives 1,
# fricatives 2, nasals 3, laterals / trills 4, approximants 5.
fn _shbdk_sonority(p): i64 {
    var c = svara_phoneme_class(p);
    if (c == SVARA_CLASS_FRICATIVE) { return 2; }
    if (c == SVARA_CLASS_NASAL) { return 3; }
    if (c == SVARA_CLASS_LATERAL || c == SVARA_CLASS_TRILL) { return 4; }
    if (c == SVARA_CLASS_APPROXIMANT) { return 5; }
    return 1;
}

# 1 if (a, b) is a two-consonant English onset (play, try, quick, few, thread,
# shrimp, huge, music, new; s + p t k m n l w f j).
fn _shbdk_en_onset2(a, b): i64 {
    if (a == SVARA_PH_FRIC_S) {
        if (b == SVARA_PH_PLOSIVE_P || b == SVARA_PH_PLOSIVE_T || b == SVARA_PH_PLOSIVE_K) { return 1; }
        if (b == SVARA_PH_NASAL_M || b == SVARA_PH_NASAL_N || b == SVARA_PH_LATERAL_L) { return 1; }
        if (b == SVARA_PH_APPROX_W || b == SVARA_PH_FRIC_F || b == SVARA_PH_APPROX_J) { return 1; }
        return 0;
    }
    var l = (b == SVARA_PH_LATERAL_L);
    var r = (b == SVARA_PH_APPROX_R);
    var w = (b == SVARA_PH_APPROX_W);
    var j = (b == SVARA_PH_APPROX_J);
    if (a == SVARA_PH_PLOSIVE_P || a == SVARA_PH_PLOSIVE_B || a == SVARA_PH_FRIC_F) { return l | r | j; }
    if (a == SVARA_PH_PLOSIVE_T || a == SVARA_PH_PLOSIVE_D) { return r | w | j; }
    if (a == SVARA_PH_PLOSIVE_K || a == SVARA_PH_PLOSIVE_G) { return l | r | w | j; }
    if (a == SVARA_PH_FRIC_TH) { return r | w; }
    if (a == SVARA_PH_FRIC_SH) { return r; }
    if (a == SVARA_PH_FRIC_V || a == SVARA_PH_FRIC_H || a == SVARA_PH_NASAL_M || a == SVARA_PH_NASAL_N) { return j; }
    return 0;
}

# 1 if phonemes v[i..j) can begin a syllable.
fn _shbdk_onset_ok(v, i, j): i64 {
    var n = j - i;
    if (n == 0) { return 1; }
    if (vec_get(v, i) == SVARA_PH_NASAL_NG) { return 0; }
    if (n == 1) { return 1; }
    var english = 1;
    var k = i;
    while (k < j) {
        if (_shbdk_is_english_consonant(vec_get(v, k)) == 0) { english = 0; }
        k = k + 1;
    }
    var a = vec_get(v, i);
    var b = vec_get(v, i + 1);
    if (english == 1) {
        if (n == 2) { return _shbdk_en_onset2(a, b); }
        if (n == 3) {
            var c = vec_get(v, i + 2);
            if (a != SVARA_PH_FRIC_S) { return 0; }
            var cl = (c == SVARA_PH_LATERAL_L);
            var cr = (c == SVARA_PH_APPROX_R);
            var cw = (c == SVARA_PH_APPROX_W);
            var cj = (c == SVARA_PH_APPROX_J);
            if (b == SVARA_PH_PLOSIVE_P) { return cl | cr | cj; }
            if (b == SVARA_PH_PLOSIVE_T) { return cr | cj; }
            if (b == SVARA_PH_PLOSIVE_K) { return cl | cr | cw | cj; }
            return 0;
        }
        return 0;
    }
    # SSP: s + stop may precede a rising run
    k = i;
    if (a == SVARA_PH_FRIC_S && svara_phoneme_class(b) == SVARA_CLASS_PLOSIVE) { k = i + 1; }
    while (k + 1 < j) {
        if (_shbdk_sonority(vec_get(v, k)) >= _shbdk_sonority(vec_get(v, k + 1))) { return 0; }
        k = k + 1;
    }
    return 1;
}

# Copy v[start..end] into a fresh vec.
fn _shbdk_slice(v, start, end): i64 {
    var out = vec_new();
    var i = start;
    while (i < end) {
        vec_push(out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# Syllabify a phoneme sequence (Maximal Onset Principle). Returns a vec of
# ShbdkSyllable*. Empty input -> empty vec; no nucleus -> a single whole-sequence
# syllable; else one syllable per nucleus, each consonant run between two nuclei
# split so the next syllable takes the longest legal onset. Consonants before the
# first nucleus join the first syllable, those after the last join the last.
#must_use
fn shbdk_syllabify(phonemes): i64 {
    var out = vec_new();
    var n = vec_len(phonemes);
    if (n == 0) { return out; }

    # nucleus indices
    var nuclei = vec_new();
    var i = 0;
    while (i < n) {
        if (_shbdk_is_nucleus(vec_get(phonemes, i)) == 1) { vec_push(nuclei, i); }
        i = i + 1;
    }
    var nn = vec_len(nuclei);

    # no vowels -> whole sequence is one syllable
    if (nn == 0) {
        vec_push(out, shbdk_syllable_new(_shbdk_slice(phonemes, 0, n)));
        return out;
    }

    var start = 0;
    var end = 0;
    var k = 0;
    var gap_start = 0;
    var gap_end = 0;
    while (k < nn) {
        if (k + 1 < nn) {
            gap_start = vec_get(nuclei, k) + 1;
            gap_end = vec_get(nuclei, k + 1);
            # the earliest split point whose remainder is a legal onset
            end = gap_start;
            while (end < gap_end && _shbdk_onset_ok(phonemes, end, gap_end) == 0) { end = end + 1; }
        } else {
            end = n;   # last syllable: take everything to the end
        }
        vec_push(out, shbdk_syllable_new(_shbdk_slice(phonemes, start, end)));
        start = end;
        k = k + 1;
    }
    return out;
}

# --- notation.cyr ---

# notation.cyr — unified phoneme-notation bridge (ARPABET / IPA / X-SAMPA).
#
# Ports 3.1.3:rust-old/src/notation.rs. CYRIUS has no traits, so the Rust
# `PhonemeNotation` trait + its three ZST impls become a NOTATION TAG
# (SHBDK_NOTATION_*) plus dispatch functions that switch on the tag and delegate
# to arpabet.cyr / ipa.cyr (already ported) and the X-SAMPA table below.
#
# Included after svara + error + arpabet + ipa (it calls into all of them) — the
# entry file orders it.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- Notation tag (was: the three trait impls) -------------------------------
var SHBDK_NOTATION_ARPABET = 0;
var SHBDK_NOTATION_IPA     = 1;
var SHBDK_NOTATION_XSAMPA  = 2;

# ---- X-SAMPA table (was: private xsampa_to_phoneme / phoneme_to_xsampa) -------
# 3.1.3: covers every svara phoneme with an X-SAMPA symbol (0..99; the Rust's
# covered 46), and `r` is the alveolar trill as X-SAMPA defines it — the English
# approximant is `r\` (it read `r` as the approximant). Also accepts the rhotic
# 3` and @`, and the t_S / d_Z affricate spellings.

# X-SAMPA symbol -> svara phoneme ordinal, or SHBDK_PH_NONE.
#must_use
fn _shbdk_xsampa_to_phoneme(sym): i64 {
    if (sym == 0) { return SHBDK_PH_NONE; }
    if (streq(sym, "a") == 1) { return SVARA_PH_VOWEL_A; }
    if (streq(sym, "e") == 1) { return SVARA_PH_VOWEL_E; }
    if (streq(sym, "i") == 1) { return SVARA_PH_VOWEL_I; }
    if (streq(sym, "o") == 1) { return SVARA_PH_VOWEL_O; }
    if (streq(sym, "u") == 1) { return SVARA_PH_VOWEL_U; }
    if (streq(sym, "@") == 1) { return SVARA_PH_VOWEL_SCHWA; }
    if (streq(sym, "O") == 1) { return SVARA_PH_VOWEL_OPEN_O; }
    if (streq(sym, "{") == 1) { return SVARA_PH_VOWEL_ASH; }
    if (streq(sym, "I") == 1) { return SVARA_PH_VOWEL_NEAR_I; }
    if (streq(sym, "U") == 1) { return SVARA_PH_VOWEL_NEAR_U; }
    if (streq(sym, "A") == 1) { return SVARA_PH_VOWEL_OPEN_A; }
    if (streq(sym, "E") == 1) { return SVARA_PH_VOWEL_OPEN_E; }
    if (streq(sym, "V") == 1) { return SVARA_PH_VOWEL_CUP_V; }
    if (streq(sym, "3") == 1) { return SVARA_PH_VOWEL_BIRD; }
    if (streq(sym, "i:") == 1) { return SVARA_PH_VOWEL_LONG_I; }
    if (streq(sym, "aI") == 1) { return SVARA_PH_DIPH_AI; }
    if (streq(sym, "aU") == 1) { return SVARA_PH_DIPH_AU; }
    if (streq(sym, "OI") == 1) { return SVARA_PH_DIPH_OI; }
    if (streq(sym, "eI") == 1) { return SVARA_PH_DIPH_EI; }
    if (streq(sym, "oU") == 1) { return SVARA_PH_DIPH_OU; }
    if (streq(sym, "p") == 1) { return SVARA_PH_PLOSIVE_P; }
    if (streq(sym, "b") == 1) { return SVARA_PH_PLOSIVE_B; }
    if (streq(sym, "t") == 1) { return SVARA_PH_PLOSIVE_T; }
    if (streq(sym, "d") == 1) { return SVARA_PH_PLOSIVE_D; }
    if (streq(sym, "k") == 1) { return SVARA_PH_PLOSIVE_K; }
    if (streq(sym, "g") == 1) { return SVARA_PH_PLOSIVE_G; }
    if (streq(sym, "f") == 1) { return SVARA_PH_FRIC_F; }
    if (streq(sym, "v") == 1) { return SVARA_PH_FRIC_V; }
    if (streq(sym, "s") == 1) { return SVARA_PH_FRIC_S; }
    if (streq(sym, "z") == 1) { return SVARA_PH_FRIC_Z; }
    if (streq(sym, "S") == 1) { return SVARA_PH_FRIC_SH; }
    if (streq(sym, "Z") == 1) { return SVARA_PH_FRIC_ZH; }
    if (streq(sym, "T") == 1) { return SVARA_PH_FRIC_TH; }
    if (streq(sym, "D") == 1) { return SVARA_PH_FRIC_DH; }
    if (streq(sym, "h") == 1) { return SVARA_PH_FRIC_H; }
    if (streq(sym, "m") == 1) { return SVARA_PH_NASAL_M; }
    if (streq(sym, "n") == 1) { return SVARA_PH_NASAL_N; }
    if (streq(sym, "N") == 1) { return SVARA_PH_NASAL_NG; }
    if (streq(sym, "tS") == 1) { return SVARA_PH_AFFR_CH; }
    if (streq(sym, "dZ") == 1) { return SVARA_PH_AFFR_J; }
    if (streq(sym, "?") == 1) { return SVARA_PH_GLOTTAL_STOP; }
    if (streq(sym, "4") == 1) { return SVARA_PH_TAP_FLAP; }
    if (streq(sym, "l") == 1) { return SVARA_PH_LATERAL_L; }
    if (streq(sym, "r\\") == 1) { return SVARA_PH_APPROX_R; }
    if (streq(sym, "w") == 1) { return SVARA_PH_APPROX_W; }
    if (streq(sym, "j") == 1) { return SVARA_PH_APPROX_J; }
    if (streq(sym, "y") == 1) { return SVARA_PH_VOWEL_Y; }
    if (streq(sym, "2") == 1) { return SVARA_PH_VOWEL_FRONT_ROUND_O; }
    if (streq(sym, "9") == 1) { return SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O; }
    if (streq(sym, "M") == 1) { return SVARA_PH_VOWEL_CLOSE_BACK_UNROUNDED; }
    if (streq(sym, "7") == 1) { return SVARA_PH_VOWEL_MID_BACK_UNROUNDED; }
    if (streq(sym, "1") == 1) { return SVARA_PH_VOWEL_CLOSE_CENTRAL; }
    if (streq(sym, "}") == 1) { return SVARA_PH_VOWEL_CLOSE_CENTRAL_ROUNDED; }
    if (streq(sym, "q") == 1) { return SVARA_PH_PLOSIVE_UVULAR_Q; }
    if (streq(sym, "G\\") == 1) { return SVARA_PH_PLOSIVE_UVULAR_G; }
    if (streq(sym, "t`") == 1) { return SVARA_PH_PLOSIVE_RETRO_T; }
    if (streq(sym, "d`") == 1) { return SVARA_PH_PLOSIVE_RETRO_D; }
    if (streq(sym, "p\\") == 1) { return SVARA_PH_FRIC_BILABIAL_PH; }
    if (streq(sym, "B") == 1) { return SVARA_PH_FRIC_BILABIAL_B; }
    if (streq(sym, "C") == 1) { return SVARA_PH_FRIC_PALATAL_C; }
    if (streq(sym, "j\\") == 1) { return SVARA_PH_FRIC_PALATAL_J; }
    if (streq(sym, "X") == 1) { return SVARA_PH_FRIC_UVULAR_CH; }
    if (streq(sym, "R") == 1) { return SVARA_PH_FRIC_UVULAR_R; }
    if (streq(sym, "X\\") == 1) { return SVARA_PH_FRIC_PHARYNGEAL_H; }
    if (streq(sym, "?\\") == 1) { return SVARA_PH_FRIC_PHARYNGEAL_A; }
    if (streq(sym, "s`") == 1) { return SVARA_PH_FRIC_RETRO_S; }
    if (streq(sym, "z`") == 1) { return SVARA_PH_FRIC_RETRO_Z; }
    if (streq(sym, "K") == 1) { return SVARA_PH_FRIC_LATERAL_S; }
    if (streq(sym, "K\\") == 1) { return SVARA_PH_FRIC_LATERAL_Z; }
    if (streq(sym, "h\\") == 1) { return SVARA_PH_FRIC_GLOTTAL_H; }
    if (streq(sym, "n`") == 1) { return SVARA_PH_NASAL_RETRO; }
    if (streq(sym, "J") == 1) { return SVARA_PH_NASAL_PALATAL; }
    if (streq(sym, "N\\") == 1) { return SVARA_PH_NASAL_UVULAR; }
    if (streq(sym, "B\\") == 1) { return SVARA_PH_TRILL_BILABIAL; }
    if (streq(sym, "r") == 1) { return SVARA_PH_TRILL_ALVEOLAR; }
    if (streq(sym, "R\\") == 1) { return SVARA_PH_TRILL_UVULAR; }
    if (streq(sym, "r\\`") == 1) { return SVARA_PH_APPROX_RETRO; }
    if (streq(sym, "L") == 1) { return SVARA_PH_LATERAL_PALATAL; }
    if (streq(sym, "L\\") == 1) { return SVARA_PH_LATERAL_VELAR; }
    if (streq(sym, "r`") == 1) { return SVARA_PH_FLAP_RETRO; }
    if (streq(sym, "l\\") == 1) { return SVARA_PH_FLAP_LATERAL; }
    if (streq(sym, "ts") == 1) { return SVARA_PH_AFFR_TS; }
    if (streq(sym, "dz") == 1) { return SVARA_PH_AFFR_DZ; }
    if (streq(sym, "ts`") == 1) { return SVARA_PH_AFFR_RETRO; }
    if (streq(sym, "dz`") == 1) { return SVARA_PH_AFFR_RETRO_VOICED; }
    if (streq(sym, "pf") == 1) { return SVARA_PH_AFFR_PF; }
    if (streq(sym, "tK") == 1) { return SVARA_PH_AFFR_LATERAL; }
    if (streq(sym, "O\\") == 1) { return SVARA_PH_CLICK_BILABIAL; }
    if (streq(sym, "|\\") == 1) { return SVARA_PH_CLICK_DENTAL; }
    if (streq(sym, "!\\") == 1) { return SVARA_PH_CLICK_ALVEOLAR; }
    if (streq(sym, "=\\") == 1) { return SVARA_PH_CLICK_PALATAL; }
    if (streq(sym, "|\\|\\") == 1) { return SVARA_PH_CLICK_LATERAL; }
    if (streq(sym, "p_>") == 1) { return SVARA_PH_EJECTIVE_P; }
    if (streq(sym, "t_>") == 1) { return SVARA_PH_EJECTIVE_T; }
    if (streq(sym, "k_>") == 1) { return SVARA_PH_EJECTIVE_K; }
    if (streq(sym, "s_>") == 1) { return SVARA_PH_EJECTIVE_S; }
    if (streq(sym, "tS_>") == 1) { return SVARA_PH_EJECTIVE_CH; }
    if (streq(sym, "b_<") == 1) { return SVARA_PH_IMPLOSIVE_B; }
    if (streq(sym, "d_<") == 1) { return SVARA_PH_IMPLOSIVE_D; }
    if (streq(sym, "g_<") == 1) { return SVARA_PH_IMPLOSIVE_G; }
    if (streq(sym, "3`") == 1) { return SVARA_PH_VOWEL_BIRD; }
    if (streq(sym, "@`") == 1) { return SVARA_PH_VOWEL_BIRD; }
    if (streq(sym, "t_S") == 1) { return SVARA_PH_AFFR_CH; }
    if (streq(sym, "d_Z") == 1) { return SVARA_PH_AFFR_J; }
    return SHBDK_PH_NONE;
}

# svara phoneme ordinal -> X-SAMPA symbol (canonical), or 0 (no equivalent).
#must_use
fn _shbdk_phoneme_to_xsampa(ph): cstring {
    if (ph == SVARA_PH_VOWEL_A) { return "a"; }
    if (ph == SVARA_PH_VOWEL_E) { return "e"; }
    if (ph == SVARA_PH_VOWEL_I) { return "i"; }
    if (ph == SVARA_PH_VOWEL_O) { return "o"; }
    if (ph == SVARA_PH_VOWEL_U) { return "u"; }
    if (ph == SVARA_PH_VOWEL_SCHWA) { return "@"; }
    if (ph == SVARA_PH_VOWEL_OPEN_O) { return "O"; }
    if (ph == SVARA_PH_VOWEL_ASH) { return "{"; }
    if (ph == SVARA_PH_VOWEL_NEAR_I) { return "I"; }
    if (ph == SVARA_PH_VOWEL_NEAR_U) { return "U"; }
    if (ph == SVARA_PH_VOWEL_OPEN_A) { return "A"; }
    if (ph == SVARA_PH_VOWEL_OPEN_E) { return "E"; }
    if (ph == SVARA_PH_VOWEL_CUP_V) { return "V"; }
    if (ph == SVARA_PH_VOWEL_BIRD) { return "3"; }
    if (ph == SVARA_PH_VOWEL_LONG_I) { return "i:"; }
    if (ph == SVARA_PH_DIPH_AI) { return "aI"; }
    if (ph == SVARA_PH_DIPH_AU) { return "aU"; }
    if (ph == SVARA_PH_DIPH_OI) { return "OI"; }
    if (ph == SVARA_PH_DIPH_EI) { return "eI"; }
    if (ph == SVARA_PH_DIPH_OU) { return "oU"; }
    if (ph == SVARA_PH_PLOSIVE_P) { return "p"; }
    if (ph == SVARA_PH_PLOSIVE_B) { return "b"; }
    if (ph == SVARA_PH_PLOSIVE_T) { return "t"; }
    if (ph == SVARA_PH_PLOSIVE_D) { return "d"; }
    if (ph == SVARA_PH_PLOSIVE_K) { return "k"; }
    if (ph == SVARA_PH_PLOSIVE_G) { return "g"; }
    if (ph == SVARA_PH_FRIC_F) { return "f"; }
    if (ph == SVARA_PH_FRIC_V) { return "v"; }
    if (ph == SVARA_PH_FRIC_S) { return "s"; }
    if (ph == SVARA_PH_FRIC_Z) { return "z"; }
    if (ph == SVARA_PH_FRIC_SH) { return "S"; }
    if (ph == SVARA_PH_FRIC_ZH) { return "Z"; }
    if (ph == SVARA_PH_FRIC_TH) { return "T"; }
    if (ph == SVARA_PH_FRIC_DH) { return "D"; }
    if (ph == SVARA_PH_FRIC_H) { return "h"; }
    if (ph == SVARA_PH_NASAL_M) { return "m"; }
    if (ph == SVARA_PH_NASAL_N) { return "n"; }
    if (ph == SVARA_PH_NASAL_NG) { return "N"; }
    if (ph == SVARA_PH_AFFR_CH) { return "tS"; }
    if (ph == SVARA_PH_AFFR_J) { return "dZ"; }
    if (ph == SVARA_PH_GLOTTAL_STOP) { return "?"; }
    if (ph == SVARA_PH_TAP_FLAP) { return "4"; }
    if (ph == SVARA_PH_LATERAL_L) { return "l"; }
    if (ph == SVARA_PH_APPROX_R) { return "r\\"; }
    if (ph == SVARA_PH_APPROX_W) { return "w"; }
    if (ph == SVARA_PH_APPROX_J) { return "j"; }
    if (ph == SVARA_PH_VOWEL_Y) { return "y"; }
    if (ph == SVARA_PH_VOWEL_FRONT_ROUND_O) { return "2"; }
    if (ph == SVARA_PH_VOWEL_OPEN_FRONT_ROUND_O) { return "9"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_BACK_UNROUNDED) { return "M"; }
    if (ph == SVARA_PH_VOWEL_MID_BACK_UNROUNDED) { return "7"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_CENTRAL) { return "1"; }
    if (ph == SVARA_PH_VOWEL_CLOSE_CENTRAL_ROUNDED) { return "}"; }
    if (ph == SVARA_PH_PLOSIVE_UVULAR_Q) { return "q"; }
    if (ph == SVARA_PH_PLOSIVE_UVULAR_G) { return "G\\"; }
    if (ph == SVARA_PH_PLOSIVE_RETRO_T) { return "t`"; }
    if (ph == SVARA_PH_PLOSIVE_RETRO_D) { return "d`"; }
    if (ph == SVARA_PH_FRIC_BILABIAL_PH) { return "p\\"; }
    if (ph == SVARA_PH_FRIC_BILABIAL_B) { return "B"; }
    if (ph == SVARA_PH_FRIC_PALATAL_C) { return "C"; }
    if (ph == SVARA_PH_FRIC_PALATAL_J) { return "j\\"; }
    if (ph == SVARA_PH_FRIC_UVULAR_CH) { return "X"; }
    if (ph == SVARA_PH_FRIC_UVULAR_R) { return "R"; }
    if (ph == SVARA_PH_FRIC_PHARYNGEAL_H) { return "X\\"; }
    if (ph == SVARA_PH_FRIC_PHARYNGEAL_A) { return "?\\"; }
    if (ph == SVARA_PH_FRIC_RETRO_S) { return "s`"; }
    if (ph == SVARA_PH_FRIC_RETRO_Z) { return "z`"; }
    if (ph == SVARA_PH_FRIC_LATERAL_S) { return "K"; }
    if (ph == SVARA_PH_FRIC_LATERAL_Z) { return "K\\"; }
    if (ph == SVARA_PH_FRIC_GLOTTAL_H) { return "h\\"; }
    if (ph == SVARA_PH_NASAL_RETRO) { return "n`"; }
    if (ph == SVARA_PH_NASAL_PALATAL) { return "J"; }
    if (ph == SVARA_PH_NASAL_UVULAR) { return "N\\"; }
    if (ph == SVARA_PH_TRILL_BILABIAL) { return "B\\"; }
    if (ph == SVARA_PH_TRILL_ALVEOLAR) { return "r"; }
    if (ph == SVARA_PH_TRILL_UVULAR) { return "R\\"; }
    if (ph == SVARA_PH_APPROX_RETRO) { return "r\\`"; }
    if (ph == SVARA_PH_LATERAL_PALATAL) { return "L"; }
    if (ph == SVARA_PH_LATERAL_VELAR) { return "L\\"; }
    if (ph == SVARA_PH_FLAP_RETRO) { return "r`"; }
    if (ph == SVARA_PH_FLAP_LATERAL) { return "l\\"; }
    if (ph == SVARA_PH_AFFR_TS) { return "ts"; }
    if (ph == SVARA_PH_AFFR_DZ) { return "dz"; }
    if (ph == SVARA_PH_AFFR_RETRO) { return "ts`"; }
    if (ph == SVARA_PH_AFFR_RETRO_VOICED) { return "dz`"; }
    if (ph == SVARA_PH_AFFR_PF) { return "pf"; }
    if (ph == SVARA_PH_AFFR_LATERAL) { return "tK"; }
    if (ph == SVARA_PH_CLICK_BILABIAL) { return "O\\"; }
    if (ph == SVARA_PH_CLICK_DENTAL) { return "|\\"; }
    if (ph == SVARA_PH_CLICK_ALVEOLAR) { return "!\\"; }
    if (ph == SVARA_PH_CLICK_PALATAL) { return "=\\"; }
    if (ph == SVARA_PH_CLICK_LATERAL) { return "|\\|\\"; }
    if (ph == SVARA_PH_EJECTIVE_P) { return "p_>"; }
    if (ph == SVARA_PH_EJECTIVE_T) { return "t_>"; }
    if (ph == SVARA_PH_EJECTIVE_K) { return "k_>"; }
    if (ph == SVARA_PH_EJECTIVE_S) { return "s_>"; }
    if (ph == SVARA_PH_EJECTIVE_CH) { return "tS_>"; }
    if (ph == SVARA_PH_IMPLOSIVE_B) { return "b_<"; }
    if (ph == SVARA_PH_IMPLOSIVE_D) { return "d_<"; }
    if (ph == SVARA_PH_IMPLOSIVE_G) { return "g_<"; }
    return 0;
}

# ---- Notation dispatch (was: the trait methods) ------------------------------
# Short name of a notation.
#must_use
fn shbdk_notation_name(n): cstring {
    if (n == SHBDK_NOTATION_ARPABET) { return "arpabet"; }
    if (n == SHBDK_NOTATION_IPA)     { return "ipa"; }
    if (n == SHBDK_NOTATION_XSAMPA)  { return "x-sampa"; }
    return 0;
}

# Notation symbol -> svara phoneme ordinal, or SHBDK_PH_NONE. An ARPABET symbol
# may carry its stress digit (`OW1`, `AH0`), as render writes it and CMUdict
# text spells it.
#
# 3.1.3: ARPABET went through shbdk_arpabet_to_phoneme, which takes no stress
# digit (the Rust's Arpabet::str_to_phoneme did the same), so `parse(render(v))`
# kept only the consonants and every `AH0` / `AH1` was lost.
#must_use
fn shbdk_notation_str_to_phoneme(n, symbol): i64 {
    if (n == SHBDK_NOTATION_ARPABET) { return shbdk_arpabet_to_phoneme_with_stress(symbol); }
    if (n == SHBDK_NOTATION_IPA)     { return shbdk_ipa_to_phoneme(symbol); }
    if (n == SHBDK_NOTATION_XSAMPA)  { return _shbdk_xsampa_to_phoneme(symbol); }
    return SHBDK_PH_NONE;
}

# svara phoneme ordinal -> notation symbol cstr, or 0 (no representation).
#must_use
fn shbdk_notation_phoneme_to_str(n, phoneme): cstring {
    if (n == SHBDK_NOTATION_ARPABET) { return shbdk_phoneme_to_arpabet(phoneme); }
    if (n == SHBDK_NOTATION_IPA)     { return shbdk_phoneme_to_ipa(phoneme); }
    if (n == SHBDK_NOTATION_XSAMPA)  { return _shbdk_phoneme_to_xsampa(phoneme); }
    return 0;
}

# Copy s[start..end] into a fresh NUL-terminated cstr.
fn _shbdk_substr_cstr(s, start, end): i64 {
    return shbdk_copyz(s + start, end - start);
}

# Default parse: split on whitespace, convert each token, drop unrecognized ones.
fn _shbdk_notation_parse_ws(n, trans): i64 {
    var out = vec_new();
    var len = strlen(trans);
    var i = 0;
    var start = 0;
    var in_tok = 0;
    var w = 0;
    var ph = 0;
    while (i < len) {
        w = shbdk_ws_len(trans, i, len);   # 3.1.3: Unicode White_Space, as split_whitespace
        if (w > 0) {
            if (in_tok == 1) {
                ph = shbdk_notation_str_to_phoneme(n, _shbdk_substr_cstr(trans, start, i));
                if (ph != SHBDK_PH_NONE) { vec_push(out, ph); }
                in_tok = 0;
            }
            i = i + w;
        } else {
            if (in_tok == 0) {
                start = i;
                in_tok = 1;
            }
            i = i + 1;
        }
    }
    if (in_tok == 1) {
        ph = shbdk_notation_str_to_phoneme(n, _shbdk_substr_cstr(trans, start, len));
        if (ph != SHBDK_PH_NONE) { vec_push(out, ph); }
    }
    return out;
}

# Parse a transcription into a vec of phoneme ordinals. IPA uses greedy
# longest-match (multi-char symbols); ARPABET/X-SAMPA split on whitespace.
#must_use
fn shbdk_notation_parse(n, trans): i64 {
    if (n == SHBDK_NOTATION_IPA) { return shbdk_parse_ipa_word(trans); }
    return _shbdk_notation_parse_ws(n, trans);
}

# Default render: join notation symbols with single spaces (skipping phonemes
# with no representation).
fn _shbdk_notation_render_join(n, phonemes): cstring {
    var sb = str_builder_new();
    var nn = vec_len(phonemes);
    var i = 0;
    var added = 0;
    var s = 0;
    while (i < nn) {
        s = shbdk_notation_phoneme_to_str(n, vec_get(phonemes, i));
        if (s != 0) {
            if (added > 0) { str_builder_add_cstr(sb, " "); }
            str_builder_add_cstr(sb, s);
            added = added + 1;
        }
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# Render a phoneme sequence to a notation string. IPA concatenates (no
# separator); ARPABET/X-SAMPA space-join.
#must_use
fn shbdk_notation_render(n, phonemes): cstring {
    if (n == SHBDK_NOTATION_IPA) { return shbdk_phonemes_to_ipa(phonemes); }
    return _shbdk_notation_render_join(n, phonemes);
}

# --- _cmudict_data.cyr ---

# _cmudict_data.cyr - AUTO-GENERATED by programs/gen_cmudict.cyr from
