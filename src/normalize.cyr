# normalize.cyr — text normalization for G2P (ports rust-old/src/normalize.rs).
#
# Leaf module: depends on stdlib only (string/str/vec/fmt/alloc). OWNS the
# SentenceType surface — the SHABDA_STYPE_* tags are hoisted in error.cyr (L0);
# the detect fn (shabda_detect_intonation) lives here.
#
# Ports: normalize, normalize_with_emphasis, expand_abbreviations,
# expand_acronyms, is_foreign_word, strip_diacritics, expand_numbers,
# detect_intonation. Plus the private helpers (match_abbreviation,
# split_trailing_punct, is_acronym, is_pronounceable_acronym, collect_number,
# expand_number_token, digits_to_words, number_to_words, hundreds/tens_to_words,
# is_latin_extended, normalize_token_into).
#
# CYRIUS STRING MODEL: strings are cstr byte pointers (NUL-terminated). Rust's
# `.chars()` scalar iteration is replaced by a UTF-8 decoder (_shabda_utf8_next,
# copied from shabdakosh detect.cyr) that walks code points. Output is built into
# a growable byte buffer (a "SB": a heap struct that owns a cstr + len + cap and
# appends bytes / cstr literals / UTF-8-encoded code points) so we never touch the
# Str<->cstr trap.
#
# SB layout (24 bytes): [0]=data ptr, [8]=len (bytes, excl NUL), [16]=cap (bytes
# of the backing alloc, incl room for NUL).
#
# tracing trace! calls in the Rust are dropped (no-op).
#
# DIVERGENCE (number parsing): Rust parses integer tokens with str::parse::<u64>()
# (range 0..=u64::MAX). Cyrius is i64-only, so _shabda_parse_u64 accepts 0..=i64::MAX
# and falls back to digit-by-digit (Rust digits_to_words) on i64 overflow. This is
# faithful for every value <= i64::MAX; values in (i64::MAX, u64::MAX] parse in Rust
# but overflow here. Rust's own number_to_words only handles up to billions, so it
# renders those huge values as garbage anyway; no ported test covers that range.
#
# Dep position: included after src/error.cyr (which hoists SHABDA_STYPE_*). Never
# includes other modules. NAMING: every top-level symbol is shabda_/SHABDA_-prefixed.

# ================================================================
# Constants — MATCH the Rust literal values in normalize.rs exactly.
# COMMA_PAUSE=",pause"  PERIOD_PAUSE=".pause"
# EMPHASIS_START="<emph>"  EMPHASIS_END="</emph>"
# ================================================================
var SHABDA_COMMA_PAUSE    = ",pause";
var SHABDA_PERIOD_PAUSE   = ".pause";
var SHABDA_EMPHASIS_START = "<emph>";
var SHABDA_EMPHASIS_END   = "</emph>";

# ================================================================
# UTF-8 code-point decoder — verbatim from shabdakosh detect.cyr. Decodes one
# code point at byte pointer p; writes the scalar to *out_cp; returns bytes
# consumed (1..4), or 0 at the NUL terminator.
# ================================================================
fn _shabda_utf8_next(p, out_cp): i64 {
    var b0 = load8(p);
    var b1 = 0;
    var b2 = 0;
    var b3 = 0;
    if (b0 == 0) { return 0; }
    if (b0 < 128) { store64(out_cp, b0); return 1; }
    if (b0 < 224) {
        b1 = load8(p + 1);
        if (b1 == 0) { store64(out_cp, b0); return 1; }
        store64(out_cp, ((b0 & 31) << 6) | (b1 & 63));
        return 2;
    }
    if (b0 < 240) {
        b1 = load8(p + 1);
        if (b1 == 0) { store64(out_cp, b0); return 1; }
        b2 = load8(p + 2);
        if (b2 == 0) { store64(out_cp, b0); return 1; }
        store64(out_cp, ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63));
        return 3;
    }
    b1 = load8(p + 1);
    if (b1 == 0) { store64(out_cp, b0); return 1; }
    b2 = load8(p + 2);
    if (b2 == 0) { store64(out_cp, b0); return 1; }
    b3 = load8(p + 3);
    if (b3 == 0) { store64(out_cp, b0); return 1; }
    store64(out_cp, ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63));
    return 4;
}

# ================================================================
# Growable cstr byte buffer ("SB"). Owns a NUL-terminated backing alloc.
# ================================================================
var SHABDA_SB_DATA = 0;
var SHABDA_SB_LEN  = 8;
var SHABDA_SB_CAP  = 16;
var SHABDA_SB_SIZE = 24;

fn _shabda_sb_new_a(a): i64 {
    var sb = alloc_via(a, SHABDA_SB_SIZE);
    var buf = alloc_via(a, 16);
    store8(buf, 0);
    store64(sb + SHABDA_SB_DATA, buf);
    store64(sb + SHABDA_SB_LEN, 0);
    store64(sb + SHABDA_SB_CAP, 16);
    return sb;
}

# Ensure room for `extra` more bytes plus the NUL terminator. Returns 0, or -1 when
# the larger buffer is refused.
fn _shabda_sb_reserve(sb, extra): i64 {
    return _shabda_sb_reserve_a(default_alloc(), sb, extra);
}

# _shabda_sb_reserve, with every allocation drawn from Allocator `a`.
fn _shabda_sb_reserve_a(a, sb, extra): i64 {
    var len = load64(sb + SHABDA_SB_LEN);
    var cap = load64(sb + SHABDA_SB_CAP);
    var need = len + extra + 1;
    if (need <= cap) { return 0; }
    var newcap = cap;
    while (newcap < need) { newcap = newcap * 2; }
    var old = load64(sb + SHABDA_SB_DATA);
    var buf = alloc_via(a, newcap);
    # alloc returns 0 for a request over ALLOC_MAX (2 GiB) or on exhaustion, and an
    # Allocator may refuse sooner. Leaving the old buffer in place keeps the SB usable
    # at its current capacity; the caller sees a truncated build rather than a write
    # through address 0. Through 3.1.1 this returned 0 here and every push wrote past
    # the old buffer anyway; the pushes now stop on the -1.
    if (buf == 0) { return 0 - 1; }
    memcpy(buf, old, len);
    store8(buf + len, 0);
    store64(sb + SHABDA_SB_DATA, buf);
    store64(sb + SHABDA_SB_CAP, newcap);
    return 0;
}

# Append one raw byte.
fn _shabda_sb_push_byte_a(a, sb, b): i64 {
    if (_shabda_sb_reserve_a(a, sb, 1) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    store8(data + len, b);
    store8(data + len + 1, 0);
    store64(sb + SHABDA_SB_LEN, len + 1);
    return 0;
}

# Append a NUL-terminated cstring.
fn _shabda_sb_push_cstr_a(a, sb, s): i64 {
    var n = strlen(s);
    if (_shabda_sb_reserve_a(a, sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, s, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# Append `n` bytes from a raw pointer.
fn _shabda_sb_push_bytes(sb, p, n): i64 {
    if (_shabda_sb_reserve(sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, p, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# UTF-8-encode a code point and append it.
fn _shabda_sb_push_cp_a(a, sb, cp): i64 {
    if (cp < 128) {
        _shabda_sb_push_byte_a(a, sb, cp);
        return 0;
    }
    if (cp < 2048) {
        _shabda_sb_push_byte_a(a, sb, 192 | (cp >> 6));
        _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
        return 0;
    }
    if (cp < 65536) {
        _shabda_sb_push_byte_a(a, sb, 224 | (cp >> 12));
        _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 6) & 63));
        _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
        return 0;
    }
    _shabda_sb_push_byte_a(a, sb, 240 | (cp >> 18));
    _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 12) & 63));
    _shabda_sb_push_byte_a(a, sb, 128 | ((cp >> 6) & 63));
    _shabda_sb_push_byte_a(a, sb, 128 | (cp & 63));
    return 0;
}

# Finalize: return the cstr pointer (NUL-terminated).
fn _shabda_sb_cstr(sb): cstring {
    return load64(sb + SHABDA_SB_DATA);
}

fn _shabda_sb_len(sb): i64 {
    return load64(sb + SHABDA_SB_LEN);
}

# Last byte of the buffer, or 0 if empty.
fn _shabda_sb_last(sb): i64 {
    var len = load64(sb + SHABDA_SB_LEN);
    if (len == 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    return load8(data + len - 1);
}

# ================================================================
# Code-point predicates (mirror Rust char methods on the paths normalize uses).
# ================================================================
# Rust char::is_alphabetic. Covers the scripts this crate feeds: ASCII letters,
# Latin-1/Extended accented letters, and — for the Hindi/Sanskrit (Devanagari) and
# Arabic G2P engines — those scripts' letters + alphabetic combining marks. Rust's
# Rust char::is_alphabetic() = Alphabetic = L* + Nl + Other_Alphabetic. normalize
# keeps exactly the alphabetic code points, so matching this is load-bearing for
# native-script convert (regression: dropping Devanagari/Arabic here made
# "नमस्ते"/"كتاب" normalize to empty -> 0 events).
#
# L* and Nl come from the stdlib's Unicode 17 GeneralCategory table, so every
# script is covered rather than the five ranges this used to hard-code (which
# silently deleted Greek, Cyrillic, Hebrew, Thai, Han, Hangul ... from normalize
# output). Other_Alphabetic is a derived property the table does not carry, so the
# marks that belong to it stay listed by range below — Devanagari matras /
# anusvara / visarga and Arabic harakat / shadda COUNT, while nukta (093C),
# virama (094D), Vedic tone marks (0951..0954) and sukun (0652) do NOT.
fn _shabda_is_alpha(cp): i64 {
    # ASCII fast path — by far the hottest input, and it skips a binary search.
    if (cp >= 65 && cp <= 90) { return 1; }
    if (cp >= 97 && cp <= 122) { return 1; }
    if (cp < 128) { return 0; }

    # L* (Lu Ll Lt Lm Lo) + Nl.
    var gc = unicode_category(cp);
    if (gc <= GC_LO) { return 1; }
    if (gc == GC_NL) { return 1; }

    # Other_Alphabetic, for the two mark-bearing scripts shabda converts.
    # Devanagari (U+0900..U+0963): matras + anusvara/visarga/chandrabindu.
    if (cp >= 0x0900 && cp <= 0x0963) {
        if (cp == 0x093C) { return 0; }                  # nukta (Mn, not alphabetic)
        if (cp == 0x094D) { return 0; }                  # virama / halant (Mn)
        if (cp >= 0x0951 && cp <= 0x0954) { return 0; }  # Vedic tone/accent marks (Mn)
        return 1;
    }
    # Arabic harakat (fatha/kasra/damma/tanween) + shadda, U+064B..U+0651.
    if (cp >= 0x064B && cp <= 0x0651) { return 1; }
    return 0;
}

# 1 if `cp` is a combining mark (General Category Mn, Mc or Me). normalize keeps a mark
# that follows a letter in the word: the Devanagari virama U+094D and nukta U+093C,
# the Vedic accents, Arabic sukun U+0652, maddah / hamza U+0653..U+0655 and
# superscript alef U+0670 are not Alphabetic, so through 3.1.2 normalize deleted
# them. The rules read them: without the virama Sanskrit धर्मः became धरमः (every
# conjunct gained a vowel), and a nukta letter lost its nukta (NFC keeps ड़ as ड +
# U+093C, U+0958..U+095F being composition exclusions).
fn _shabda_is_mark(cp): i64 {
    if (cp < 0x0300) { return 0; }
    var gc = unicode_category(cp);
    if (gc == GC_MN || gc == GC_MC || gc == GC_ME) { return 1; }
    return 0;
}

fn _shabda_is_ascii_alpha(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }
    if (cp >= 97 && cp <= 122) { return 1; }
    return 0;
}

fn _shabda_is_ascii_upper(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }
    return 0;
}

fn _shabda_is_ascii_digit(cp): i64 {
    if (cp >= 48 && cp <= 57) { return 1; }
    return 0;
}

# Rust char::is_alphanumeric — for our inputs = alpha OR ascii digit.
fn _shabda_is_alnum(cp): i64 {
    if (_shabda_is_alpha(cp) == 1) { return 1; }
    if (_shabda_is_ascii_digit(cp) == 1) { return 1; }
    return 0;
}

# Rust char::is_whitespace — the full Unicode White_Space property (shabda_is_ws_cp
# in L0). Was ASCII-only, which glued NBSP-separated words into one token.
fn _shabda_is_ws(cp): i64 {
    return shabda_is_ws_cp(cp);
}

# Rust char::is_uppercase — the Uppercase property, via the stdlib GeneralCategory
# table. Was ASCII + Latin-1 only, so an ALL-CAPS word in Greek, Cyrillic, or even
# Latin Extended-A (U+0100..U+024F) was silently not emphasised. Residual: Uppercase
# is Lu + Other_Uppercase, and the ~130 Other_Uppercase code points (Roman-numeral
# forms U+2160..216F, circled capitals U+24B6..24CF, some math alphanumerics) are
# not GeneralCategory Lu; none of them is a letter shabda pronounces.
fn _shabda_is_upper(cp): i64 {
    if (cp >= 65 && cp <= 90) { return 1; }      # ASCII fast path
    if (cp < 128) { return 0; }
    return unicode_category(cp) == GC_LU;
}

# Rust `ch.to_lowercase().next().unwrap_or(ch)` — the simple lowercase mapping,
# via the stdlib casefold table. Was ASCII-only, so "CAFÉ" lowered to "cafÉ" and
# every accented capital reached the letter-to-sound rules in the wrong case.
# Residual: Rust takes the first char of the FULL mapping; the two differ only
# where a full mapping expands to several chars, and there the first char is the
# simple mapping anyway (e.g. U+0130 -> 'i' both ways).
fn _shabda_to_lower_cp(cp): i64 {
    if (cp >= 65 && cp <= 90) { return cp + 32; }    # ASCII fast path
    if (cp < 128) { return cp; }
    return unicode_to_lower(cp);
}

# ================================================================
# ASCII-lowercase copy of a cstring (Rust str::to_lowercase for the ASCII-only
# words match_abbreviation / is_pronounceable_acronym pass it — those inputs are
# ASCII, so ASCII folding matches Rust's Unicode folding on them).
# ================================================================
fn _shabda_lower_cstr_a(a, s): cstring {
    var n = strlen(s);
    var out = alloc_via(a, n + 1);
    if (out == 0) { return ""; }
    var i = 0;
    var c = 0;
    while (i < n) {
        c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# cstr starts_with(prefix): 1 if s begins with the bytes of prefix.
fn _shabda_starts_with(s, prefix): i64 {
    var i = 0;
    var pc = 0;
    var sc = 0;
    while (1 == 1) {
        pc = load8(prefix + i);
        if (pc == 0) { return 1; }
        sc = load8(s + i);
        if (sc != pc) { return 0; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# ONES[0..20] / TENS[0..10] number-word tables (static cstrs).
# ================================================================
fn _shabda_ones(i): cstring {
    if (i == 0)  { return "zero"; }
    if (i == 1)  { return "one"; }
    if (i == 2)  { return "two"; }
    if (i == 3)  { return "three"; }
    if (i == 4)  { return "four"; }
    if (i == 5)  { return "five"; }
    if (i == 6)  { return "six"; }
    if (i == 7)  { return "seven"; }
    if (i == 8)  { return "eight"; }
    if (i == 9)  { return "nine"; }
    if (i == 10) { return "ten"; }
    if (i == 11) { return "eleven"; }
    if (i == 12) { return "twelve"; }
    if (i == 13) { return "thirteen"; }
    if (i == 14) { return "fourteen"; }
    if (i == 15) { return "fifteen"; }
    if (i == 16) { return "sixteen"; }
    if (i == 17) { return "seventeen"; }
    if (i == 18) { return "eighteen"; }
    if (i == 19) { return "nineteen"; }
    return "";
}

fn _shabda_tens(i): cstring {
    if (i == 2) { return "twenty"; }
    if (i == 3) { return "thirty"; }
    if (i == 4) { return "forty"; }
    if (i == 5) { return "fifty"; }
    if (i == 6) { return "sixty"; }
    if (i == 7) { return "seventy"; }
    if (i == 8) { return "eighty"; }
    if (i == 9) { return "ninety"; }
    return "";
}

# ================================================================
# number_to_words / hundreds_to_words / tens_to_words — append into an SB.
# Rust builds Vec<String> + join(" "); we append directly with " " separators.
# ================================================================

# Converts 1..99 to words, appended to sb. (Rust tens_to_words)
fn _shabda_tens_to_words_a(a, sb, n): i64 {
    if (n < 20) {
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(n));
        return 0;
    }
    _shabda_sb_push_cstr_a(a, sb, _shabda_tens(n / 10));
    var one = n % 10;
    if (one > 0) {
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(one));
    }
    return 0;
}

# Converts 1..999 to words, appended to sb. (Rust hundreds_to_words)
fn _shabda_hundreds_to_words_a(a, sb, n): i64 {
    var wrote = 0;
    if (n >= 100) {
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(n / 100));
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "hundred");
        wrote = 1;
    }
    var remainder = n % 100;
    if (remainder > 0) {
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_tens_to_words_a(a, sb, remainder);
    }
    return 0;
}

# Converts 0..999,999,999+ to words, appended to sb. (Rust number_to_words)
fn _shabda_number_to_words_a(a, sb, n): i64 {
    if (n == 0) {
        _shabda_sb_push_cstr_a(a, sb, "zero");
        return 0;
    }
    var wrote = 0;
    if (n >= 1000000000) {
        var billions = n / 1000000000;
        _shabda_number_to_words_a(a, sb, billions);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "billion");
        wrote = 1;
    }
    var remainder = n % 1000000000;
    if (remainder >= 1000000) {
        var millions = remainder / 1000000;
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_number_to_words_a(a, sb, millions);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "million");
        wrote = 1;
    }
    remainder = remainder % 1000000;
    if (remainder >= 1000) {
        var thousands = remainder / 1000;
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_number_to_words_a(a, sb, thousands);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, "thousand");
        wrote = 1;
    }
    remainder = remainder % 1000;
    if (remainder > 0) {
        if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
        _shabda_hundreds_to_words_a(a, sb, remainder);
    }
    return 0;
}

# ================================================================
# Number-token parsing. `token` is a cstr of digits + optional single '.'.
# ================================================================

# Parse a cstr of ASCII digits into an integer. Returns the value; sets *ok_out to
# 1 on success (all digits, non-empty, no overflow), 0 on failure -> Rust's
# digits_to_words fallback. Rust used str::parse::<u64>() (accepts up to u64::MAX);
# Cyrius is i64-only, so we accept up to i64::MAX (9223372036854775807) and treat
# genuine i64 overflow as the failure/fallback path. See the DIVERGENCE note in the
# header: values in (i64::MAX, u64::MAX] parse in Rust but overflow here — Rust
# itself renders those as garbage via its billions-only number_to_words, and no
# ported test exercises that range. Bound check: v*10+d overflows i64 when
# v > 922337203685477580, or v == 922337203685477580 && d > 7.
fn _shabda_parse_u64(s, ok_out): i64 {
    var n = strlen(s);
    if (n == 0) { store64(ok_out, 0); return 0; }
    var i = 0;
    var v = 0;
    var c = 0;
    var d = 0;
    while (i < n) {
        c = load8(s + i);
        if (c < 48 || c > 57) { store64(ok_out, 0); return 0; }
        d = c - 48;
        # i64 overflow guard (i64::MAX = 9223372036854775807).
        if (v > 922337203685477580) { store64(ok_out, 0); return 0; }
        if (v == 922337203685477580 && d > 7) { store64(ok_out, 0); return 0; }
        v = v * 10 + d;
        i = i + 1;
    }
    store64(ok_out, 1);
    return v;
}

# Reads digits one by one as fallback for very large numbers. (Rust digits_to_words)
fn _shabda_digits_to_words_a(a, sb, s): i64 {
    var n = strlen(s);
    var i = 0;
    var c = 0;
    var wrote = 0;
    while (i < n) {
        c = load8(s + i);
        if (c >= 48 && c <= 57) {
            if (wrote == 1) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, _shabda_ones(c - 48));
            wrote = 1;
        }
        i = i + 1;
    }
    return 0;
}

# Expands a number token cstr to words, appended to sb. (Rust expand_number_token)
fn _shabda_expand_number_token_a(a, sb, token): i64 {
    var dot = strchr(token, 46);
    if (dot >= 0) {
        # Decimal: "3.14" -> "three point one four"
        var tlen = strlen(token);
        # integer_part = token[..dot], decimal_part = token[dot+1..]
        var intbuf = alloc_via(a, dot + 1);
        if (intbuf == 0) { return 0; }
        memcpy(intbuf, token, dot);
        store8(intbuf + dot, 0);
        var declen = tlen - dot - 1;
        var decbuf = alloc_via(a, declen + 1);
        if (decbuf == 0) { return 0; }
        memcpy(decbuf, token + dot + 1, declen);
        store8(decbuf + declen, 0);

        if (strlen(intbuf) == 0) {
            _shabda_sb_push_cstr_a(a, sb, "zero");
        } else {
            var ok = alloc_via(a, 8);
            var v = _shabda_parse_u64(intbuf, ok);
            if (load64(ok) == 1) {
                _shabda_number_to_words_a(a, sb, v);
            } else {
                _shabda_digits_to_words_a(a, sb, intbuf);
            }
        }
        _shabda_sb_push_cstr_a(a, sb, " point");
        var i = 0;
        var c = 0;
        while (i < declen) {
            c = load8(decbuf + i);
            if (c >= 48 && c <= 57) {
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, _shabda_ones(c - 48));
            }
            i = i + 1;
        }
        return 0;
    }
    var ok2 = alloc_via(a, 8);
    var v2 = _shabda_parse_u64(token, ok2);
    if (load64(ok2) == 1) {
        _shabda_number_to_words_a(a, sb, v2);
    } else {
        _shabda_digits_to_words_a(a, sb, token);
    }
    return 0;
}

# Collects a contiguous number token from a codepoint vec starting at index `start`.
# Digits go into sb-out buffer; commas between digits skipped; one decimal point.
# Returns bytes... actually returns count of code points consumed; the collected
# token cstr is written via out_tok (a pointer to a cstr slot).
fn _shabda_collect_number_a(a, cps, start, out_tok): i64 {
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = start;
    var has_dot = 0;
    var c = 0;
    var nx = 0;
    var brk = 0;
    while (i < n && brk == 0) {
        c = vec_get(cps, i);
        if (c >= 48 && c <= 57) {
            _shabda_sb_push_byte_a(a, sb, c);
            i = i + 1;
        } elif (c == 44 && i + 1 < n) {
            nx = vec_get(cps, i + 1);
            if (nx >= 48 && nx <= 57) {
                i = i + 1;
            } else {
                brk = 1;
            }
        } elif (c == 46 && has_dot == 0 && i + 1 < n) {
            nx = vec_get(cps, i + 1);
            if (nx >= 48 && nx <= 57) {
                _shabda_sb_push_byte_a(a, sb, 46);
                has_dot = 1;
                i = i + 1;
            } else {
                brk = 1;
            }
        } else {
            brk = 1;
        }
    }
    store64(out_tok, _shabda_sb_cstr(sb));
    return i - start;
}

# ================================================================
# Decode a whole cstring into a vec of code points (Rust `text.chars().collect()`).
# ================================================================
fn _shabda_decode_cps_a(a, text): i64 {
    var cps = vec_new_a(a);
    var p = text;
    var cp = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cp);
    while (adv > 0) {
        _shabda_vec_push_a(a, cps, load64(cp));
        p = p + adv;
        adv = _shabda_utf8_next(p, cp);
    }
    return cps;
}

# ================================================================
# Number readings beyond the cardinal: ordinals, currency, percentages, clock
# times, years, digit strings. Each is how an English reader says the token
# (Chicago Manual of Style 17th ed., ch. 9, for the conventions); through 3.1.2 each
# was read as a plain cardinal with its suffix or sign glued on or dropped: "1st"
# said "onest", "$3.50" "three point five zero", "50%" "fifty", "3:05" "three five",
# "1999" "one thousand nine hundred ninety nine", "10-20" "ten negative twenty".
# ================================================================

# 1 if cps[i] is an ASCII digit (0 past the end).
fn _shabda_cp_digit_at(cps, i): i64 {
    if (i < 0 || i >= vec_len(cps)) { return 0; }
    return _shabda_is_ascii_digit(vec_get(cps, i));
}

# ASCII-lowercase of cps[i], or 0 past the end.
fn _shabda_cp_lower_at(cps, i): i64 {
    if (i < 0 || i >= vec_len(cps)) { return 0; }
    var c = vec_get(cps, i);
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# The ordinal of a cardinal's last word: one -> first, twenty -> twentieth, six -> sixth.
fn _shabda_ordinal_word(w): cstring {
    if (streq(w, "one") == 1) { return "first"; }
    if (streq(w, "two") == 1) { return "second"; }
    if (streq(w, "three") == 1) { return "third"; }
    if (streq(w, "five") == 1) { return "fifth"; }
    if (streq(w, "eight") == 1) { return "eighth"; }
    if (streq(w, "nine") == 1) { return "ninth"; }
    if (streq(w, "twelve") == 1) { return "twelfth"; }
    return 0;
}

# Append the ordinal of `v` ("twenty first", "one hundredth") to sb.
fn _shabda_ordinal_to_words_a(a, sb, v): i64 {
    var tmp = _shabda_sb_new_a(a);
    _shabda_number_to_words_a(a, tmp, v);
    var words = _shabda_sb_cstr(tmp);
    var n = _shabda_sb_len(tmp);
    var ls = n;
    while (ls > 0 && load8(words + ls - 1) != 32) { ls = ls - 1; }
    _shabda_sb_push_bytes_a(a, sb, words, ls);
    var last = words + ls;
    var irregular = _shabda_ordinal_word(last);
    if (irregular != 0) {
        _shabda_sb_push_cstr_a(a, sb, irregular);
        return 0;
    }
    var ln = n - ls;
    if (ln > 0 && load8(last + ln - 1) == 121) {          # -y -> -ieth
        _shabda_sb_push_bytes_a(a, sb, last, ln - 1);
        _shabda_sb_push_cstr_a(a, sb, "ieth");
        return 0;
    }
    _shabda_sb_push_cstr_a(a, sb, last);
    _shabda_sb_push_cstr_a(a, sb, "th");
    return 0;
}

# Append a year 1001..1999 the way it is said: 1999 -> "nineteen ninety nine",
# 1905 -> "nineteen oh five", 1900 -> "nineteen hundred", 1066 -> "ten sixty six".
fn _shabda_year_to_words_a(a, sb, v): i64 {
    _shabda_tens_to_words_a(a, sb, v / 100);
    var lo = v % 100;
    if (lo == 0) {
        _shabda_sb_push_cstr_a(a, sb, " hundred");
    } elif (lo < 10) {
        _shabda_sb_push_cstr_a(a, sb, " oh ");
        _shabda_sb_push_cstr_a(a, sb, _shabda_ones(lo));
    } else {
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_tens_to_words_a(a, sb, lo);
    }
    return 0;
}

# 1 if the four-digit number at cps[start..j) is a year by its context: a decade
# plural follows ("1990s"), or BC / AD / BCE / CE, or the word before it is a month
# or one that introduces a date (in, since, from, until, till, by, of, circa, during,
# before, after, around, year). Elsewhere it is a quantity ("1234" "one thousand two
# hundred thirty four").
fn _shabda_year_context_a(a, cps, start, j): i64 {
    var n = vec_len(cps);
    if (_shabda_cp_lower_at(cps, j) == 115 && _shabda_is_alpha(_shabda_cp_lower_at(cps, j + 1)) == 0) { return 1; }
    var k = j;
    while (k < n && _shabda_is_ws(vec_get(cps, k)) == 1) { k = k + 1; }
    if (k > j && k + 1 < n) {
        var e0 = _shabda_cp_lower_at(cps, k);
        var e1 = _shabda_cp_lower_at(cps, k + 1);
        var era = ((e0 == 98) & (e1 == 99)) | ((e0 == 97) & (e1 == 100)) | ((e0 == 99) & (e1 == 101));   # bc ad ce
        if (era == 1 && _shabda_is_alpha(_shabda_cp_lower_at(cps, k + 2)) == 0) { return 1; }
        if (e0 == 98 && e1 == 99 && _shabda_cp_lower_at(cps, k + 2) == 101) { return 1; }                 # bce
    }
    # the word before
    var e = start;
    while (e > 0 && _shabda_is_ws(vec_get(cps, e - 1)) == 1) { e = e - 1; }
    var b = e;
    while (b > 0 && _shabda_is_ascii_alpha(vec_get(cps, b - 1)) == 1) { b = b - 1; }
    var len = e - b;
    if (len == 0 || len > 9 || e == start) { return 0; }
    var w = alloc_via(a, len + 1);
    if (w == 0) { return 0; }
    var q = 0;
    while (q < len) { store8(w + q, _shabda_cp_lower_at(cps, b + q)); q = q + 1; }
    store8(w + len, 0);
    var intro = "in since from until till by of circa during before after around year";
    var months = "january february march april may june july august september october november december";
    if (_shabda_word_in_list(w, intro) == 1) { return 1; }
    return _shabda_word_in_list(w, months);
}

# 1 if cstr `w` is one of the space-separated words of cstr `list`.
fn _shabda_word_in_list(w, list): i64 {
    var n = strlen(w);
    var i = 0;
    while (load8(list + i) != 0) {
        var e = i;
        while (load8(list + e) != 0 && load8(list + e) != 32) { e = e + 1; }
        if (e - i == n) {
            var k = 0;
            while (k < n && load8(list + i + k) == load8(w + k)) { k = k + 1; }
            if (k == n) { return 1; }
        }
        i = e;
        if (load8(list + i) == 32) { i = i + 1; }
    }
    return 0;
}

# Currency units: kind 1 = $, 2 = £, 3 = €. `which` 0 = the main unit, 1 = the
# hundredth; `plural` 1 for anything but exactly one.
fn _shabda_currency_unit(kind, which, plural): cstring {
    if (kind == 2) {
        if (which == 0) { if (plural == 1) { return "pounds"; } return "pound"; }
        if (plural == 1) { return "pence"; }
        return "penny";
    }
    if (which == 1) { if (plural == 1) { return "cents"; } return "cent"; }
    if (kind == 3) { if (plural == 1) { return "euros"; } return "euro"; }
    if (plural == 1) { return "dollars"; }
    return "dollar";
}

# The currency kind of code point `c` ($ £ €), or 0.
fn _shabda_currency_kind(c): i64 {
    if (c == 36) { return 1; }        # $
    if (c == 0xA3) { return 2; }      # £
    if (c == 0x20AC) { return 3; }    # €
    return 0;
}

# If cps[j..] is white space then "thousand" / "million" / "billion" / "trillion"
# and a non-letter, the index after that word; else -1. ("$5 million" is five
# million dollars.)
fn _shabda_magnitude_after_a(a, cps, j): i64 {
    var n = vec_len(cps);
    var k = j;
    while (k < n && _shabda_is_ws(vec_get(cps, k)) == 1) { k = k + 1; }
    if (k == j || k >= n) { return 0 - 1; }
    var e = k;
    while (e < n && _shabda_is_ascii_alpha(vec_get(cps, e)) == 1) { e = e + 1; }
    var len = e - k;
    if (len < 7 || len > 8) { return 0 - 1; }
    var buf = alloc_via(a, 9);
    if (buf == 0) { return 0 - 1; }
    var q = 0;
    while (q < len) { store8(buf + q, _shabda_cp_lower_at(cps, k + q)); q = q + 1; }
    store8(buf + len, 0);
    if (streq(buf, "thousand") == 1 || streq(buf, "million") == 1) { return e; }
    if (streq(buf, "billion") == 1 || streq(buf, "trillion") == 1) { return e; }
    return 0 - 1;
}

# Append the currency reading of number token `tok` (digits, at most one '.') in
# currency `kind`: "$3.50" -> "three dollars and fifty cents", "$1" -> "one dollar",
# "$0.99" -> "ninety nine cents". A fraction of more than two digits is read as a
# decimal, then the unit.
fn _shabda_currency_to_words_a(a, sb, tok, kind): i64 {
    var dot = strchr(tok, 46);
    var tlen = strlen(tok);
    var ok = alloc_via(a, 8);
    if (ok == 0) { return 0; }
    if (dot < 0 || tlen - dot - 1 > 2) {
        var whole = 0;
        if (dot < 0) { whole = _shabda_parse_u64(tok, ok); }
        _shabda_expand_number_token_a(a, sb, tok);
        _shabda_sb_push_byte_a(a, sb, 32);
        var one = (dot < 0) & (load64(ok) == 1) & (whole == 1);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 0, 1 - one));
        return 0;
    }
    var ibuf = alloc_via(a, dot + 1);
    if (ibuf == 0) { return 0; }
    memcpy(ibuf, tok, dot);
    store8(ibuf + dot, 0);
    var units = 0;
    if (dot > 0) { units = _shabda_parse_u64(ibuf, ok); }
    if (dot > 0 && load64(ok) == 0) { _shabda_expand_number_token_a(a, sb, tok); return 0; }
    var cents = load8(tok + dot + 1) - 48;
    if (tlen - dot - 1 == 2) { cents = cents * 10 + (load8(tok + dot + 2) - 48); } else { cents = cents * 10; }
    if (units > 0 || cents == 0) {
        _shabda_number_to_words_a(a, sb, units);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 0, units != 1));
    }
    if (cents > 0) {
        if (units > 0) { _shabda_sb_push_cstr_a(a, sb, " and "); }
        _shabda_tens_to_words_a(a, sb, cents);
        _shabda_sb_push_byte_a(a, sb, 32);
        _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(kind, 1, cents != 1));
    }
    return 0;
}

# "1990s", "80s": an 's' straight after the number (then no letter) makes its last
# word plural, -y -> -ies ("nineteen nineties", "eighties"). Returns the index after
# the 's', or `j` unchanged.
fn _shabda_decade_plural_a(a, sb, cps, j): i64 {
    if (_shabda_cp_lower_at(cps, j) != 115) { return j; }
    if (_shabda_is_alpha(_shabda_cp_lower_at(cps, j + 1)) == 1) { return j; }
    var len = load64(sb + SHABDA_SB_LEN);
    if (len > 0 && _shabda_sb_last(sb) == 121) {
        store64(sb + SHABDA_SB_LEN, len - 1);
        store8(load64(sb + SHABDA_SB_DATA) + len - 1, 0);
        _shabda_sb_push_cstr_a(a, sb, "ies");
    } else {
        _shabda_sb_push_byte_a(a, sb, 115);
    }
    return j + 1;
}

# Append raw bytes p[0..n) to sb.
fn _shabda_sb_push_bytes_a(a, sb, p, n): i64 {
    if (_shabda_sb_reserve_a(a, sb, n) < 0) { return 0; }
    var data = load64(sb + SHABDA_SB_DATA);
    var len = load64(sb + SHABDA_SB_LEN);
    memcpy(data + len, p, n);
    store8(data + len + n, 0);
    store64(sb + SHABDA_SB_LEN, len + n);
    return 0;
}

# ================================================================
# expand_numbers — public. (Rust expand_numbers)
# ================================================================
#must_use
fn shabda_expand_numbers(text): cstring {
    return _shabda_expand_numbers_a(default_alloc(), text);
}

# shabda_expand_numbers, with every allocation drawn from Allocator `a`.
#
# At each number: a minus sign is a '-' before a digit that does not follow a letter
# or digit ("-5", not "10-20" or "COVID-19"); a currency sign before it gives the
# currency reading; then, in this order, a '%' after it, an ordinal suffix st / nd /
# rd / th, a clock time H:MM, a year 1001..1999 in a date's context, a digit string with a
# leading zero (read digit by digit: "007" "zero zero seven"), else the cardinal or
# decimal reading. A '-' or '–' between two numbers is "to" (a range, CMOS 6.78). A
# letter straight after a number is a separate word ("5km" "five km").
#must_use
fn _shabda_expand_numbers_a(a, text): cstring {
    var cps = _shabda_decode_cps_a(a, text);
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var c = 0;
    var tokslot = alloc_via(a, 8);
    var ok = alloc_via(a, 8);
    var consumed = 0;
    var last = 0;
    while (i < n) {
        c = vec_get(cps, i);
        var start = 0 - 1;
        var neg = 0;
        var cur = 0;
        if (_shabda_is_ascii_digit(c) == 1) {
            start = i;
        } elif (c == 45 && _shabda_cp_digit_at(cps, i + 1) == 1) {
            if (i == 0 || _shabda_is_alnum(vec_get(cps, i - 1)) == 0) {
                neg = 1;
                start = i + 1;
            }
        } elif (_shabda_currency_kind(c) != 0 && _shabda_cp_digit_at(cps, i + 1) == 1) {
            cur = _shabda_currency_kind(c);
            start = i + 1;
        }
        if (start < 0) {
            # A hyphen joining a word to a number ("COVID-19", "F-16") separates them.
            if (c == 45 && _shabda_cp_digit_at(cps, i + 1) == 1) { c = 32; }
            _shabda_sb_push_cp_a(a, sb, c);
            i = i + 1;
            continue;
        }
        consumed = _shabda_collect_number_a(a, cps, start, tokslot);
        var tok = load64(tokslot);
        var j = start + consumed;
        last = _shabda_sb_last(sb);
        if (_shabda_sb_len(sb) != 0 && last != 32) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        if (neg == 1) { _shabda_sb_push_cstr_a(a, sb, "negative "); }
        var tlen = strlen(tok);
        var integer = (strchr(tok, 46) < 0);
        var plain = integer & (tlen == consumed);   # no '.', no grouping comma
        var v = 0;
        store64(ok, 0);
        if (integer == 1) { v = _shabda_parse_u64(tok, ok); }
        var whole = integer & (load64(ok) == 1);    # an integer that fits, grouped or not
        var parsed = plain & whole;
        var s0 = _shabda_cp_lower_at(cps, j);
        var s1 = _shabda_cp_lower_at(cps, j + 1);
        var ord = 0;
        if (whole == 1 && _shabda_is_alpha(_shabda_cp_lower_at(cps, j + 2)) == 0) {
            if ((s0 == 115 && s1 == 116) || (s0 == 110 && s1 == 100)) { ord = 1; }   # st nd
            if ((s0 == 114 && s1 == 100) || (s0 == 116 && s1 == 104)) { ord = 1; }   # rd th
        }
        var clock = 0;
        if (parsed == 1 && consumed <= 2 && v <= 23 && s0 == 58) {                   # ':'
            if (_shabda_cp_digit_at(cps, j + 1) == 1 && _shabda_cp_digit_at(cps, j + 2) == 1) {
                if (_shabda_cp_digit_at(cps, j + 3) == 0 && (s1 - 48) <= 5) { clock = 1; }
            }
        }
        if (cur != 0) {
            var mag = _shabda_magnitude_after_a(a, cps, j);
            if (mag > 0) {
                # "$5 million" -> "five million dollars"
                _shabda_expand_number_token_a(a, sb, tok);
                _shabda_sb_push_byte_a(a, sb, 32);
                var mk = j;
                while (_shabda_is_ws(vec_get(cps, mk)) == 1) { mk = mk + 1; }
                while (mk < mag) { _shabda_sb_push_byte_a(a, sb, _shabda_cp_lower_at(cps, mk)); mk = mk + 1; }
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, _shabda_currency_unit(cur, 0, 1));
                j = mag;
            } else {
                _shabda_currency_to_words_a(a, sb, tok, cur);
            }
        } elif (s0 == 37) {                                                          # '%'
            _shabda_expand_number_token_a(a, sb, tok);
            _shabda_sb_push_cstr_a(a, sb, " percent");
            j = j + 1;
        } elif (ord == 1) {
            _shabda_ordinal_to_words_a(a, sb, v);
            j = j + 2;
        } elif (clock == 1) {
            var mm = (s1 - 48) * 10 + (vec_get(cps, j + 2) - 48);
            _shabda_number_to_words_a(a, sb, v);
            if (mm > 0 && mm < 10) {
                _shabda_sb_push_cstr_a(a, sb, " oh ");
                _shabda_sb_push_cstr_a(a, sb, _shabda_ones(mm));
            } elif (mm >= 10) {
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_tens_to_words_a(a, sb, mm);
            }
            j = j + 3;
        } elif (parsed == 1 && neg == 0 && consumed == 4 && v >= 1001 && v <= 1999
            && _shabda_year_context_a(a, cps, start, j) == 1) {
            _shabda_year_to_words_a(a, sb, v);
            j = _shabda_decade_plural_a(a, sb, cps, j);
        } elif (plain == 1 && consumed >= 2 && load8(tok) == 48) {
            _shabda_digits_to_words_a(a, sb, tok);
        } else {
            _shabda_expand_number_token_a(a, sb, tok);
            if (whole == 1) { j = _shabda_decade_plural_a(a, sb, cps, j); }
        }
        # A range: "10-20", "1990–1995".
        if (j < n && (vec_get(cps, j) == 45 || vec_get(cps, j) == 0x2013) && _shabda_cp_digit_at(cps, j + 1) == 1) {
            _shabda_sb_push_cstr_a(a, sb, " to");
            j = j + 1;
        } elif (j < n && _shabda_is_alpha(vec_get(cps, j)) == 1) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        i = j;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# Abbreviation table + match_abbreviation. (Rust match_abbreviation)
# Ordered exactly as the Rust ABBREVIATIONS slice.
# ================================================================
fn _shabda_abbr_at(idx, out_expansion): cstring {
    # Returns the abbr cstr for index idx (or 0 past the end); writes expansion.
    if (idx == 0)  { store64(out_expansion, "approximately"); return "approx."; }
    if (idx == 1)  { store64(out_expansion, "boulevard");     return "blvd."; }
    if (idx == 2)  { store64(out_expansion, "captain");       return "capt."; }
    if (idx == 3)  { store64(out_expansion, "colonel");       return "col."; }
    if (idx == 4)  { store64(out_expansion, "corporation");   return "corp."; }
    if (idx == 5)  { store64(out_expansion, "department");    return "dept."; }
    if (idx == 6)  { store64(out_expansion, "government");     return "govt."; }
    if (idx == 7)  { store64(out_expansion, "professor");     return "prof."; }
    if (idx == 8)  { store64(out_expansion, "missus");        return "mrs."; }
    if (idx == 9)  { store64(out_expansion, "mister");        return "mr."; }
    if (idx == 10) { store64(out_expansion, "doctor");        return "dr."; }
    if (idx == 11) { store64(out_expansion, "senior");        return "sr."; }
    if (idx == 12) { store64(out_expansion, "junior");        return "jr."; }
    if (idx == 13) { store64(out_expansion, "saint");         return "st."; }
    if (idx == 14) { store64(out_expansion, "avenue");        return "ave."; }
    if (idx == 15) { store64(out_expansion, "et cetera");     return "etc."; }
    if (idx == 16) { store64(out_expansion, "versus");        return "vs."; }
    if (idx == 17) { store64(out_expansion, "incorporated");  return "inc."; }
    if (idx == 18) { store64(out_expansion, "limited");       return "ltd."; }
    if (idx == 19) { store64(out_expansion, "general");       return "gen."; }
    if (idx == 20) { store64(out_expansion, "sergeant");      return "sgt."; }
    if (idx == 21) { store64(out_expansion, "lieutenant");    return "lt."; }
    if (idx == 22) { store64(out_expansion, "point");         return "pt."; }
    if (idx == 23) { store64(out_expansion, "feet");          return "ft."; }
    if (idx == 24) { store64(out_expansion, "mount");         return "mt."; }
    if (idx == 25) { store64(out_expansion, "for example");   return "e.g."; }
    if (idx == 26) { store64(out_expansion, "that is");       return "i.e."; }
    store64(out_expansion, 0);
    return 0;
}

# Tries to match an abbreviation at the start of `text` (a cstr word).
# Returns bytes_consumed (>0) with *out_exp set to the expansion, or 0 = no match.
fn _shabda_match_abbreviation_a(a, text, out_exp): i64 {
    var lower = _shabda_lower_cstr_a(a, text);
    var idx = 0;
    var abbr = 0;
    var expslot = alloc_via(a, 8);
    var alen = 0;
    var afterc = 0;
    abbr = _shabda_abbr_at(idx, expslot);
    while (abbr != 0) {
        if (_shabda_starts_with(lower, abbr) == 1) {
            alen = strlen(abbr);
            # after = text[abbr.len()..]; must be empty OR start with ws / non-alpha.
            afterc = load8(text + alen);
            if (afterc == 0) {
                store64(out_exp, load64(expslot));
                return alen;
            }
            # Decode the first code point after the abbreviation.
            var cpo = alloc_via(a, 8);
            _shabda_utf8_next(text + alen, cpo);
            var cpa = load64(cpo);
            if (_shabda_is_ws(cpa) == 1 || _shabda_is_alpha(cpa) == 0) {
                store64(out_exp, load64(expslot));
                return alen;
            }
        }
        idx = idx + 1;
        abbr = _shabda_abbr_at(idx, expslot);
    }
    store64(out_exp, 0);
    return 0;
}

# ================================================================
# split_whitespace over a cstr -> vec of cstr words (Rust str::split_whitespace:
# collapses runs, drops leading/trailing ws, no empty tokens).
# ================================================================
fn _shabda_split_ws_a(a, text): i64 {
    var words = vec_new_a(a);
    var cps = _shabda_decode_cps_a(a, text);
    var n = vec_len(cps);
    var i = 0;
    var c = 0;
    var sb = 0;
    var inword = 0;
    while (i < n) {
        c = vec_get(cps, i);
        if (_shabda_is_ws(c) == 1) {
            if (inword == 1) {
                _shabda_vec_push_a(a, words, _shabda_sb_cstr(sb));
                inword = 0;
            }
        } else {
            if (inword == 0) {
                sb = _shabda_sb_new_a(a);
                inword = 1;
            }
            _shabda_sb_push_cp_a(a, sb, c);
        }
        i = i + 1;
    }
    if (inword == 1) {
        _shabda_vec_push_a(a, words, _shabda_sb_cstr(sb));
    }
    return words;
}

# ================================================================
# expand_abbreviations — public. (Rust expand_abbreviations)
# ================================================================
#must_use
fn shabda_expand_abbreviations(text): cstring {
    return _shabda_expand_abbreviations_a(default_alloc(), text);
}

# shabda_expand_abbreviations, with every allocation drawn from Allocator `a`.
#
# Two readings depend on the neighbours. "St." and "Dr." after a capitalized word and
# before a lowercase one (or the end) are "street" / "drive" ("Main St. near"), else
# "saint" / "doctor" ("St. Paul", "Dr. Smith"). And an abbreviation's period also
# ends the sentence when the next word is capitalized or there is none ("pears,
# etc. Then"), so a period is kept after the expansion there for the sentence pause;
# a title (Mr. Mrs. Dr. Prof. Capt. Col. Gen. Sgt. Lt. St. Mt.) is followed by a name,
# so its period never ends one. A dotted initialism ("U.S.", "a.m.") is spelled out as
# shabda_expand_acronyms spells a word ("u-s").
#must_use
fn _shabda_expand_abbreviations_a(a, text): cstring {
    var words = _shabda_split_ws_a(a, text);
    var n = vec_len(words);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var word = 0;
    var expslot = alloc_via(a, 8);
    var consumed = 0;
    while (i < n) {
        if (i > 0) { _shabda_sb_push_byte_a(a, sb, 32); }
        word = vec_get(words, i);
        var prev_cap = 0;
        if (i > 0) { prev_cap = _shabda_is_ascii_upper(load8(vec_get(words, i - 1))); }
        var next_cap = 1;                                  # the end of the text counts
        if (i + 1 < n) { next_cap = _shabda_word_starts_upper(vec_get(words, i + 1)); }
        consumed = _shabda_match_abbreviation_a(a, word, expslot);
        var dotted = 0;
        if (consumed == 0) { dotted = _shabda_dotted_initialism_len(word); }
        if (consumed > 0) {
            var exp = load64(expslot);
            var title = _shabda_abbr_is_title(exp);
            # e.g. and i.e. introduce what follows, so their period ends no sentence,
            # even before a capital ("rock, e.g. Elvis"); "etc. Then" can.
            if (streq(exp, "for example") == 1 || streq(exp, "that is") == 1) { title = 1; }
            var place = prev_cap & ((next_cap == 0) | (i + 1 >= n));
            if (place == 1 && streq(exp, "saint") == 1) { exp = "street"; title = 0; }
            if (place == 1 && streq(exp, "doctor") == 1) { exp = "drive"; title = 0; }
            if (i + 1 >= n && title == 1) { title = 0; }
            _shabda_sb_push_cstr_a(a, sb, exp);
            # Append remaining bytes after the abbreviation: word[consumed..].
            var rest = word + consumed;
            if (title == 0 && next_cap == 1 && load8(rest) == 0) { _shabda_sb_push_byte_a(a, sb, 46); }
            _shabda_sb_push_cstr_a(a, sb, rest);
        } elif (dotted > 0) {
            var k = 0;
            while (k < dotted) {
                if (k > 0) { _shabda_sb_push_byte_a(a, sb, 45); }
                _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(load8(word + k)));
                k = k + 2;
            }
            var drest = word + dotted;
            if (next_cap == 1 && load8(drest) == 0) { _shabda_sb_push_byte_a(a, sb, 46); }
            _shabda_sb_push_cstr_a(a, sb, drest);
        } else {
            _shabda_sb_push_cstr_a(a, sb, word);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# 1 if `word` begins (after any opening quote or bracket) with an uppercase letter.
fn _shabda_word_starts_upper(word): i64 {
    var k = 0;
    var c = load8(word);
    while (c == 34 || c == 39 || c == 40 || c == 91) { k = k + 1; c = load8(word + k); }
    if (c == 0xE2) { return 0; }
    return _shabda_is_ascii_upper(c);
}

# 1 if an abbreviation's expansion is a title, which a name follows.
fn _shabda_abbr_is_title(exp): i64 {
    if (streq(exp, "mister") == 1 || streq(exp, "missus") == 1 || streq(exp, "doctor") == 1) { return 1; }
    if (streq(exp, "professor") == 1 || streq(exp, "captain") == 1 || streq(exp, "colonel") == 1) { return 1; }
    if (streq(exp, "general") == 1 || streq(exp, "sergeant") == 1 || streq(exp, "lieutenant") == 1) { return 1; }
    if (streq(exp, "saint") == 1 || streq(exp, "mount") == 1) { return 1; }
    return 0;
}

# Byte length of a dotted initialism at the start of `word` — two or more letters,
# each followed by '.' ("U.S.", "a.m.", "U.S.A.") — when what follows is not a
# letter, else 0.
fn _shabda_dotted_initialism_len(word): i64 {
    var k = 0;
    while (_shabda_is_ascii_alpha(load8(word + k)) == 1 && load8(word + k + 1) == 46) { k = k + 2; }
    if (k < 4) { return 0; }
    if (_shabda_is_ascii_alpha(load8(word + k)) == 1) { return 0; }
    return k;
}

# ================================================================
# Acronyms. split_trailing_punct / is_acronym / is_pronounceable_acronym.
# ================================================================

# Splits trailing (non-alphanumeric) punctuation from a word. Writes the byte
# offset where trailing punct begins to *out_end (i.e. core = word[..end],
# trailing = word[end..]). (Rust split_trailing_punct)
fn _shabda_split_trailing_punct_a(a, word, out_end): i64 {
    # Decode into (cp, byte_offset) pairs, find the last run of non-alnum at the end.
    var cps = vec_new_a(a);
    var offs = vec_new_a(a);
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var off = 0;
    while (adv > 0) {
        _shabda_vec_push_a(a, cps, load64(cpo));
        _shabda_vec_push_a(a, offs, off);
        off = off + adv;
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    var total = off;
    var m = vec_len(cps);
    # Rust: char_indices().rev().take_while(!alnum).last().map(|(i,_)| i)
    #       .unwrap_or(word.len()). "end" = byte index of the FIRST char (scanning
    # from the tail) in the maximal trailing non-alnum run; if no trailing punct,
    # end = word.len().
    var end = total;
    var j = m - 1;
    var stop = 0;
    while (j >= 0 && stop == 0) {
        if (_shabda_is_alnum(vec_get(cps, j)) == 0) {
            end = vec_get(offs, j);
            j = j - 1;
        } else {
            stop = 1;
        }
    }
    store64(out_end, end);
    return 0;
}

# Returns 1 if `word` (cstr) is an acronym: 3..=5 ASCII-uppercase letters.
# NOTE: Rust checks len (byte length) in 3..=5; core is ASCII so byte==char count.
fn _shabda_is_acronym(word): i64 {
    var n = strlen(word);
    if (n < 3 || n > 5) { return 0; }
    var i = 0;
    var c = 0;
    while (i < n) {
        c = load8(word + i);
        if (c < 65 || c > 90) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _shabda_is_vowel(c): i64 {
    if (c == 97) { return 1; }
    if (c == 101) { return 1; }
    if (c == 105) { return 1; }
    if (c == 111) { return 1; }
    if (c == 117) { return 1; }
    return 0;
}

# Valid onset cluster check: is (a,b) in the Rust valid_onsets table?
fn _shabda_valid_onset(a, b): i64 {
    if (a == 98 && b == 108) { return 1; }  # bl
    if (a == 98 && b == 114) { return 1; }  # br
    if (a == 99 && b == 108) { return 1; }  # cl
    if (a == 99 && b == 114) { return 1; }  # cr
    if (a == 100 && b == 114) { return 1; } # dr
    if (a == 102 && b == 108) { return 1; } # fl
    if (a == 102 && b == 114) { return 1; } # fr
    if (a == 103 && b == 108) { return 1; } # gl
    if (a == 103 && b == 114) { return 1; } # gr
    if (a == 112 && b == 108) { return 1; } # pl
    if (a == 112 && b == 114) { return 1; } # pr
    if (a == 115 && b == 99)  { return 1; } # sc
    if (a == 115 && b == 107) { return 1; } # sk
    if (a == 115 && b == 108) { return 1; } # sl
    if (a == 115 && b == 109) { return 1; } # sm
    if (a == 115 && b == 110) { return 1; } # sn
    if (a == 115 && b == 112) { return 1; } # sp
    if (a == 115 && b == 116) { return 1; } # st
    if (a == 115 && b == 119) { return 1; } # sw
    if (a == 116 && b == 114) { return 1; } # tr
    if (a == 116 && b == 119) { return 1; } # tw
    if (a == 116 && b == 104) { return 1; } # th
    if (a == 115 && b == 104) { return 1; } # sh
    if (a == 99 && b == 104)  { return 1; } # ch
    if (a == 119 && b == 104) { return 1; } # wh
    return 0;
}

# 1 if byte `c` is one of the bytes of cstr `set`.
fn _shabda_byte_in(c, set): i64 {
    var k = 0;
    while (load8(set + k) != 0) {
        if (load8(set + k) == c) { return 1; }
        k = k + 1;
    }
    return 0;
}

# 1 if the two vowel letters (b0, b1) are an English vowel digraph (rain, cause, day,
# sea, see, vein, feud, they, pie, boat, toe, coin, moon, out, boy, cue, suit).
fn _shabda_vowel_digraph(b0, b1): i64 {
    if (b0 == 97) { return _shabda_byte_in(b1, "iuy"); }
    if (b0 == 101) { return _shabda_byte_in(b1, "aeiuy"); }
    if (b0 == 105) { return b1 == 101; }
    if (b0 == 111) { return _shabda_byte_in(b1, "aeiouy"); }
    if (b0 == 117) { return _shabda_byte_in(b1, "ei"); }
    return 0;
}

# 1 if the consonant letters word[s..e) can end an English word: one letter but h j
# q v, or a common two-letter coda (act, gift, cold, golf, milk, film, help, salt,
# lamp, hand, pink, tent, apt, ... , cats, dogs, fish, rich, path, sing).
fn _shabda_letter_coda(word, s, e): i64 {
    var n = e - s;
    if (n == 0) { return 1; }
    var c0 = load8(word + s);
    if (n == 1) { return 1 - _shabda_byte_in(c0, "hjqv"); }
    if (n > 2) { return 0; }
    var c1 = load8(word + s + 1);
    if (c1 == 115) { return _shabda_byte_in(c0, "ptdmnlk"); }      # ps ts ds ms ns ls ks
    if (c1 == 104) { return _shabda_byte_in(c0, "sct"); }          # sh ch th
    if (c1 == 116) { return _shabda_byte_in(c0, "cflnprs"); }      # ct ft lt nt pt rt st
    if (c1 == 100) { return _shabda_byte_in(c0, "lnr"); }          # ld nd rd
    if (c1 == 107) { return _shabda_byte_in(c0, "lnrs"); }         # lk nk rk sk
    if (c1 == 112) { return _shabda_byte_in(c0, "lmrs"); }         # lp mp rp sp
    if (c1 == 109) { return _shabda_byte_in(c0, "lr"); }           # lm rm
    if (c1 == 102) { return _shabda_byte_in(c0, "lr"); }           # lf rf
    if (c1 == 110) { return c0 == 114; }                           # rn
    if (c1 == 103) { return c0 == 110; }                           # ng
    return 0;
}

# 1 if the consonant letters word[s..e) can begin an English word: one letter, a pair
# in the onset table, or s + p / t / c + l / r (split, street, scream).
fn _shabda_letter_onset(word, s, e): i64 {
    var n = e - s;
    if (n <= 1) { return 1; }
    var c0 = load8(word + s);
    var c1 = load8(word + s + 1);
    if (n == 2) { return _shabda_valid_onset(c0, c1); }
    if (n > 3 || c0 != 115) { return 0; }
    var c2 = load8(word + s + 2);
    if (c1 == 112 || c1 == 99) { return (c2 == 108) | (c2 == 114); }
    if (c1 == 116) { return c2 == 114; }
    return 0;
}

# Returns 1 if an acronym (cstr, ASCII upper) is read as a word, 0 if it is spelled.
# (Rust is_pronounceable_acronym.) It is a word when its letters spell a possible
# English word: every vowel run one vowel or a digraph, the consonants before the
# first vowel an onset, those after the last a coda, and each run between two vowels
# a coda + onset. NASA, NATO, SCUBA, LASER, AIDS, OPEC, IKEA, NAFTA are words; IBM
# (bm), ATM (tm), ESPN (spn), FAQ (q), CIA (ia), CEO (eo), NAACP (aa) are spelled.
# A three-letter acronym that starts with a lone vowel is spelled as well (USA, UFO,
# ICU, EPA, IRS, ATV): English reads nearly all of them letter by letter. Through
# 3.1.2 an acronym was a word whenever it started with a vowel or a consonant + vowel,
# so IBM, ATM, ESPN, USA and CIA were read as words.
fn _shabda_is_pronounceable_acronym_a(a, word): i64 {
    var lower = _shabda_lower_cstr_a(a, word);
    var n = strlen(lower);
    if (n == 0) { return 0; }
    var c0 = load8(lower);
    if (n == 3 && _shabda_is_vowel(c0) == 1) {
        if (_shabda_is_vowel(load8(lower + 1)) == 0) { return 0; }
        if (_shabda_vowel_digraph(c0, load8(lower + 1)) == 0) { return 0; }
    }
    var i = 0;
    var runs = 0;          # vowel runs seen
    var cstart = 0;        # start of the current consonant run
    while (i < n) {
        if (_shabda_is_vowel(load8(lower + i)) == 1) {
            var vs = i;
            while (i < n && _shabda_is_vowel(load8(lower + i)) == 1) { i = i + 1; }
            var vlen = i - vs;
            if (vlen > 2) { return 0; }
            if (vlen == 2 && _shabda_vowel_digraph(load8(lower + vs), load8(lower + vs + 1)) == 0) { return 0; }
            if (runs == 0) {
                if (_shabda_letter_onset(lower, cstart, vs) == 0) { return 0; }
            } else {
                # a medial run: some split into coda + onset
                var ok = 0;
                var k = cstart;
                while (k <= vs && ok == 0) {
                    if (_shabda_letter_coda(lower, cstart, k) == 1) { ok = _shabda_letter_onset(lower, k, vs); }
                    k = k + 1;
                }
                if (ok == 0) { return 0; }
            }
            runs = runs + 1;
            cstart = i;
        } else {
            i = i + 1;
        }
    }
    if (runs == 0) { return 0; }
    return _shabda_letter_coda(lower, cstart, n);
}

# ================================================================
# expand_acronyms — public. (Rust expand_acronyms)
# ================================================================
#must_use
fn shabda_expand_acronyms(text): cstring {
    return _shabda_expand_acronyms_a(default_alloc(), text);
}

# shabda_expand_acronyms, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_expand_acronyms_a(a, text): cstring {
    var words = _shabda_split_ws_a(a, text);
    var n = vec_len(words);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var word = 0;
    var endslot = alloc_via(a, 8);
    while (i < n) {
        if (i > 0) { _shabda_sb_push_byte_a(a, sb, 32); }
        word = vec_get(words, i);
        # Split trailing punct: core = word[..end], trailing = word[end..].
        _shabda_split_trailing_punct_a(a, word, endslot);
        var end = load64(endslot);
        var core = alloc_via(a, end + 1);
        if (core == 0) { return _shabda_sb_cstr(sb); }
        memcpy(core, word, end);
        store8(core + end, 0);
        var trailing = word + end;

        if (_shabda_is_acronym(core) == 1) {
            if (_shabda_is_pronounceable_acronym_a(a, core) == 1) {
                # lowercase it as a word.
                var k = 0;
                var clen = strlen(core);
                var cc = 0;
                while (k < clen) {
                    cc = load8(core + k);
                    _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(cc));
                    k = k + 1;
                }
            } else {
                # spell out: "FBI" -> "f-b-i", one token, which the English engine says
                # letter by letter by the letters' names. Through 3.1.2 it was
                # "f b i", three words the rules said as the bare sounds /f b aɪ/.
                var k2 = 0;
                var clen2 = strlen(core);
                var cc2 = 0;
                while (k2 < clen2) {
                    if (k2 > 0) { _shabda_sb_push_byte_a(a, sb, 45); }
                    cc2 = load8(core + k2);
                    _shabda_sb_push_byte_a(a, sb, _shabda_to_lower_cp(cc2));
                    k2 = k2 + 1;
                }
            }
            _shabda_sb_push_cstr_a(a, sb, trailing);
        } else {
            _shabda_sb_push_cstr_a(a, sb, word);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# is_foreign_word / is_latin_extended / strip_diacritics.
# ================================================================
fn _shabda_is_latin_extended(cp): i64 {
    if (cp >= 0x00C0 && cp <= 0x024F) { return 1; }
    return 0;
}

# 1 if `word` contains a non-ASCII Latin letter (accented or extended Latin), suggesting a
# foreign loan word; 0 otherwise. (Rust is_foreign_word)
#must_use
fn shabda_is_foreign_word(word): i64 {
    return _shabda_is_foreign_word_a(default_alloc(), word);
}

# shabda_is_foreign_word, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_is_foreign_word_a(a, word): i64 {
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var cp = 0;
    while (adv > 0) {
        cp = load64(cpo);
        if (_shabda_is_alpha(cp) == 1 && _shabda_is_ascii_alpha(cp) == 0 && _shabda_is_latin_extended(cp) == 1) {
            return 1;
        }
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    return 0;
}

# Map an accented code point to its ASCII base, or return it unchanged.
# (Rust strip_diacritics match arms.)
fn _shabda_strip_cp(cp): i64 {
    # a: á à â ä ã  = 0xE1 0xE0 0xE2 0xE4 0xE3
    if (cp == 0x00E1 || cp == 0x00E0 || cp == 0x00E2 || cp == 0x00E4 || cp == 0x00E3) { return 97; }
    # e: é è ê ë  = 0xE9 0xE8 0xEA 0xEB
    if (cp == 0x00E9 || cp == 0x00E8 || cp == 0x00EA || cp == 0x00EB) { return 101; }
    # i: í ì î ï  = 0xED 0xEC 0xEE 0xEF
    if (cp == 0x00ED || cp == 0x00EC || cp == 0x00EE || cp == 0x00EF) { return 105; }
    # o: ó ò ô ö õ = 0xF3 0xF2 0xF4 0xF6 0xF5
    if (cp == 0x00F3 || cp == 0x00F2 || cp == 0x00F4 || cp == 0x00F6 || cp == 0x00F5) { return 111; }
    # u: ú ù û ü  = 0xFA 0xF9 0xFB 0xFC
    if (cp == 0x00FA || cp == 0x00F9 || cp == 0x00FB || cp == 0x00FC) { return 117; }
    # ñ = 0xF1 -> n
    if (cp == 0x00F1) { return 110; }
    # ç = 0xE7 -> s
    if (cp == 0x00E7) { return 115; }
    return cp;
}

# `word` with accented Latin letters mapped to their ASCII equivalents; other characters pass
# through. (Rust strip_diacritics)
#must_use
fn shabda_strip_diacritics(word): cstring {
    return _shabda_strip_diacritics_a(default_alloc(), word);
}

# shabda_strip_diacritics, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_strip_diacritics_a(a, word): cstring {
    var sb = _shabda_sb_new_a(a);
    var p = word;
    var cpo = alloc_via(a, 8);
    var adv = _shabda_utf8_next(p, cpo);
    var cp = 0;
    while (adv > 0) {
        cp = load64(cpo);
        _shabda_sb_push_cp_a(a, sb, _shabda_strip_cp(cp));
        p = p + adv;
        adv = _shabda_utf8_next(p, cpo);
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# normalize / normalize_token_into / normalize_with_emphasis.
# ================================================================

# Append a phrase-boundary marker (SHABDA_COMMA_PAUSE or SHABDA_PERIOD_PAUSE) after
# a space. Consecutive boundaries are one pause: an ellipsis "..." or "?!" makes one
# sentence pause, not three, and a sentence boundary after a comma replaces it.
fn _shabda_push_pause_a(a, sb, marker): i64 {
    var len = _shabda_sb_len(sb);
    var data = _shabda_sb_cstr(sb);
    if (len >= 6 && streq(data + len - 6, SHABDA_PERIOD_PAUSE) == 1) { return 0; }
    if (len >= 6 && streq(data + len - 6, SHABDA_COMMA_PAUSE) == 1) {
        if (streq(marker, SHABDA_PERIOD_PAUSE) == 1) { store8(data + len - 6, 46); }
        return 0;
    }
    _shabda_sb_push_byte_a(a, sb, 32);
    _shabda_sb_push_cstr_a(a, sb, marker);
    return 0;
}

# Process a single token's code points into sb (Rust normalize_token_into).
fn _shabda_normalize_token_into_a(a, token, sb): i64 {
    var cps = _shabda_decode_cps_a(a, token);
    var n = vec_len(cps);
    var i = 0;
    var ch = 0;
    var prev_space = 0;
    var last = 0;
    var inword = 0;
    while (i < n) {
        ch = vec_get(cps, i);
        var mark = inword & _shabda_is_mark(ch);
        if (_shabda_is_alpha(ch) == 1 || ch == 39 || ch == 45 || mark == 1) {
            last = _shabda_sb_last(sb);
            if (prev_space == 1 && _shabda_sb_len(sb) != 0 && last != 32) {
                _shabda_sb_push_byte_a(a, sb, 32);
            }
            _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(ch));
            prev_space = 0;
            inword = (ch != 39) & (ch != 45);
        } elif (ch == 44) {
            _shabda_push_pause_a(a, sb, SHABDA_COMMA_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 46 || ch == 59 || ch == 33 || ch == 63) {
            # '!' and '?' end a sentence as '.' does; through 3.1.2 they made no pause,
            # so "Really? Yes." ran the two sentences together.
            _shabda_push_pause_a(a, sb, SHABDA_PERIOD_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 38) {
            # '&' is the word "and".
            if (_shabda_sb_len(sb) != 0 && _shabda_sb_last(sb) != 32) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, "and");
            prev_space = 1;
            inword = 0;
        } elif (_shabda_is_ws(ch) == 1) {
            prev_space = 1;
            inword = 0;
        }
        i = i + 1;
    }
    return 0;
}

# Normalizes text for G2P: expands abbreviations, acronyms and numbers, lowercases, keeps the
# comma / period pause markers (',' is a comma pause; '.', ';', '!' and '?' a period pause,
# one per run of them), reads '&' as "and", strips the other non-alphabetic characters (keeping
# spaces, apostrophes and hyphens) and collapses runs of spaces. (Rust normalize)
#must_use
fn shabda_normalize(text): cstring {
    return _shabda_normalize_a(default_alloc(), text);
}

# shabda_normalize, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_normalize_a(a, text): cstring {
    var abbr = _shabda_expand_abbreviations_a(a, text);
    var acro = _shabda_expand_acronyms_a(a, abbr);
    var expanded = _shabda_expand_numbers_a(a, acro);

    var cps = _shabda_decode_cps_a(a, expanded);
    var n = vec_len(cps);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var ch = 0;
    var prev_space = 0;
    var inword = 0;          # the last code point kept was a letter or a mark
    while (i < n) {
        ch = vec_get(cps, i);
        var mark = inword & _shabda_is_mark(ch);
        if (_shabda_is_alpha(ch) == 1 || ch == 39 || ch == 45 || mark == 1) {
            if (prev_space == 1 && _shabda_sb_len(sb) != 0) {
                _shabda_sb_push_byte_a(a, sb, 32);
            }
            _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(ch));
            prev_space = 0;
            inword = (ch != 39) & (ch != 45);
        } elif (ch == 44) {
            _shabda_push_pause_a(a, sb, SHABDA_COMMA_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 46 || ch == 59 || ch == 33 || ch == 63) {
            # '!' and '?' end a sentence as '.' does; through 3.1.2 they made no pause,
            # so "Really? Yes." ran the two sentences together.
            _shabda_push_pause_a(a, sb, SHABDA_PERIOD_PAUSE);
            prev_space = 1;
            inword = 0;
        } elif (ch == 38) {
            # '&' is the word "and".
            if (_shabda_sb_len(sb) != 0 && _shabda_sb_last(sb) != 32) { _shabda_sb_push_byte_a(a, sb, 32); }
            _shabda_sb_push_cstr_a(a, sb, "and");
            prev_space = 1;
            inword = 0;
        } elif (_shabda_is_ws(ch) == 1) {
            prev_space = 1;
            inword = 0;
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# As shabda_normalize, but ALL-CAPS words (3+ letters) and *asterisk-wrapped* words are
# wrapped in SHABDA_EMPHASIS_START / SHABDA_EMPHASIS_END, and acronyms are not expanded.
# (Rust normalize_with_emphasis)
#must_use
fn shabda_normalize_with_emphasis(text): cstring {
    return _shabda_normalize_with_emphasis_a(default_alloc(), text);
}

# shabda_normalize_with_emphasis, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_normalize_with_emphasis_a(a, text): cstring {
    var abbr = _shabda_expand_abbreviations_a(a, text);
    var expanded = _shabda_expand_numbers_a(a, abbr);

    var tokens = _shabda_split_ws_a(a, expanded);
    var nt = vec_len(tokens);
    var sb = _shabda_sb_new_a(a);
    var i = 0;
    var token = 0;
    while (i < nt) {
        if (i > 0 && _shabda_sb_len(sb) != 0) {
            _shabda_sb_push_byte_a(a, sb, 32);
        }
        token = vec_get(tokens, i);
        var tlen = strlen(token);
        var handled = 0;

        # *asterisk-wrapped* emphasis: token.len() >= 3, starts+ends with '*'.
        if (tlen >= 3 && load8(token) == 42 && load8(token + tlen - 1) == 42) {
            # inner = token[1..len-1].
            var ilen = tlen - 2;
            var inner = alloc_via(a, ilen + 1);
            if (inner == 0) { return _shabda_sb_cstr(sb); }
            memcpy(inner, token + 1, ilen);
            store8(inner + ilen, 0);
            # inner non-empty and all chars alphabetic.
            var icps = _shabda_decode_cps_a(a, inner);
            var im = vec_len(icps);
            var allalpha = 1;
            var k = 0;
            while (k < im) {
                var ic = vec_get(icps, k);
                if (_shabda_is_alpha(ic) == 0 && (k == 0 || _shabda_is_mark(ic) == 0)) { allalpha = 0; }
                k = k + 1;
            }
            if (im > 0 && allalpha == 1) {
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_START);
                _shabda_sb_push_byte_a(a, sb, 32);
                var k2 = 0;
                while (k2 < im) {
                    _shabda_sb_push_cp_a(a, sb, _shabda_to_lower_cp(vec_get(icps, k2)));
                    k2 = k2 + 1;
                }
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_END);
                handled = 1;
            }
        }

        # ALL-CAPS emphasis: >= 3 alphabetic chars, all uppercase.
        if (handled == 0) {
            var tcps = _shabda_decode_cps_a(a, token);
            var tm = vec_len(tcps);
            var alpha_count = 0;
            var all_upper = 1;
            var j = 0;
            var tc = 0;
            while (j < tm) {
                tc = vec_get(tcps, j);
                if (_shabda_is_alpha(tc) == 1) {
                    alpha_count = alpha_count + 1;
                    if (_shabda_is_upper(tc) == 0) { all_upper = 0; }
                }
                j = j + 1;
            }
            if (alpha_count >= 3 && all_upper == 1) {
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_START);
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_normalize_token_into_a(a, token, sb);
                _shabda_sb_push_byte_a(a, sb, 32);
                _shabda_sb_push_cstr_a(a, sb, SHABDA_EMPHASIS_END);
                handled = 1;
            }
        }

        if (handled == 0) {
            _shabda_normalize_token_into_a(a, token, sb);
        }
        i = i + 1;
    }
    return _shabda_sb_cstr(sb);
}

# ================================================================
# detect_intonation — public. (Rust detect_intonation) Returns a SHABDA_STYPE_* tag.
# ================================================================
#must_use
fn shabda_detect_intonation(text): i64 {
    # Rust str::trim_end — the Unicode White_Space property, not an ASCII subset.
    # A trailing U+00A0 or U+3000 used to hide the terminal '?' / '!' and make every
    # such sentence read as a Statement.
    var n = strlen(text);
    var end = n;
    var m = shabda_ws_len_before(text, 0, end);
    while (m > 0) {
        end = end - m;
        m = shabda_ws_len_before(text, 0, end);
    }
    if (end == 0) { return SHABDA_STYPE_STATEMENT; }
    var lastc = load8(text + end - 1);
    if (lastc == 63) { return SHABDA_STYPE_QUESTION; }
    if (lastc == 33) { return SHABDA_STYPE_EXCLAMATION; }
    return SHABDA_STYPE_STATEMENT;
}

# ================================================================
# sentence_type alias — the spec lists shabda_sentence_type; it is the detector.
# ================================================================
#must_use
fn shabda_sentence_type(text): i64 {
    return shabda_detect_intonation(text);
}
