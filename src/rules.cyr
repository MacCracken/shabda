# rules.cyr — rule-based grapheme-to-phoneme conversion (6 language engines).
#
# The capabilities of rust-old/src/rules.rs (1545 LOC); since 3.1.3 their output is
# accurate rather than the Rust's (ADR-0002, the 3.1.3 CHANGELOG entry). Six public
# #must_use engines, each taking a cstring word and returning a `vec` of svara
# phoneme ordinals:
#   shabda_english_rules(word)   — context-sensitive NRL rules + vowel reduction
#   shabda_spanish_rules(word)   — /a e i o u/, glides, trill / tap, yeísmo
#   shabda_german_rules(word)    — vowel length, schwa, ç / χ, ʁ, affricates, devoicing
#   shabda_hindi_rules(word)     — Devanagari + Ohala's final and medial schwa deletion
#   shabda_sanskrit_rules(word)  — Devanagari + IAST, schwa PRESERVATION
#   shabda_arabic_rules(word)    — abjad + harakat/tanween/shadda, matres, the article
#
# DEPENDENCY POSITION: needs the vendored svara bundle (SVARA_PH_* ordinals) and
# src/error.cyr (for shared L0 tags — not strictly used here but part of the
# include chain). Modules never `include` each other; the entry file orders
# includes: lib/hisab, lib/goonj, lib/naad, lib/svara, src/error, src/rules.
#
# PORTING MODEL — everything operates on a codepoint array:
#   _shabda_word_chars(word) UTF-8-decodes the cstring into a `vec` of i64
#   codepoints ONCE; every engine indexes that vec. Devanagari/Arabic literals
#   port as exact codepoint compares against the hex values (load-bearing).
#
# Rust's PatternResult{Static/Dynamic} + custom iterator is FLATTENED: each
# match helper returns the number of chars 'consumed' and pushes the phoneme
# sequence directly into the caller's out vec. No iterator adapter.
#
# Rust `char` `to_lowercase()` → we ASCII-lowercase codepoints in
# _shabda_word_chars for the Latin engines (matching Rust's word.to_lowercase()
# for the ASCII range; the non-ASCII accented literals á/é/ñ/ä/ö/ü/ß are already
# lowercase in the test inputs, same as Rust). The Devanagari/Arabic engines take
# the raw (un-lowercased) codepoints, mirroring Rust's `word.chars()` there.
#
# Option<Phoneme> / sentinels: SHABDA_PH_NONE from error.cyr. Every match helper
# has a mandatory final fallback arm (the #[non_exhaustive]-style default).
#
# NAMING: every top-level symbol is `shabda_`/`SHABDA_`/`_shabda_`-prefixed
# (flat link namespace; coexists with shbdk_ / svara_ / varna / sakshi).

# ================================================================
# Codepoint helpers
# ================================================================

# Is `cp` an ASCII vowel letter (a/e/i/o/u)? Ports is_vowel_char.
#must_use
fn _shabda_is_vowel_char(cp): i64 {
    if (cp == 0x61) { return 1; }   # a
    if (cp == 0x65) { return 1; }   # e
    if (cp == 0x69) { return 1; }   # i
    if (cp == 0x6F) { return 1; }   # o
    if (cp == 0x75) { return 1; }   # u
    return 0;
}

# ASCII-lowercase a single codepoint (A..Z -> a..z), leaving all else untouched.
# Mirrors Rust `char::to_lowercase().next()` for the ASCII range.
#must_use
fn _shabda_ascii_lower(cp): i64 {
    if (cp >= 0x41) {
        if (cp <= 0x5A) {
            return cp + 0x20;
        }
    }
    return cp;
}

# UTF-8-decode a NUL-terminated cstring into a `vec` of i64 codepoints.
# Optionally ASCII-lowercases each (lower != 0) — Latin engines lowercase, the
# Devanagari/Arabic engines pass raw. Returns a vec of codepoints.
#must_use
fn _shabda_decode_chars(word, lower): i64 {
    return _shabda_decode_chars_a(default_alloc(), word, lower);
}

# _shabda_decode_chars, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_decode_chars_a(a, word, lower): i64 {
    var out = vec_new_a(a);
    var n = strlen(word);
    var i = 0;
    while (i < n) {
        var b0 = load8(word + i);
        var cp = 0;
        var adv = 1;
        # Every continuation byte is bounds-checked against `n`. A sequence whose
        # lead byte promises more bytes than the string holds decodes as the lead
        # byte alone and advances 1 — exactly what _shabda_utf8_next (normalize.cyr)
        # does at its NUL guard, so the crate's two decoders agree. Without this the
        # loads ran up to 3 bytes past the NUL terminator, reading whatever the bump
        # allocator held there and turning it into phonemes.
        if (b0 < 0x80) {
            cp = b0;
        } elif (b0 < 0xE0) {
            # 2-byte sequence
            if (i + 1 >= n) { cp = b0; } else {
                var b1 = load8(word + i + 1);
                cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                adv = 2;
            }
        } elif (b0 < 0xF0) {
            # 3-byte sequence (Devanagari, Arabic presentation etc.)
            if (i + 2 >= n) { cp = b0; } else {
                var b1b = load8(word + i + 1);
                var b2b = load8(word + i + 2);
                cp = ((b0 & 0x0F) << 12) | ((b1b & 0x3F) << 6) | (b2b & 0x3F);
                adv = 3;
            }
        } else {
            # 4-byte sequence
            if (i + 3 >= n) { cp = b0; } else {
                var b1c = load8(word + i + 1);
                var b2c = load8(word + i + 2);
                var b3c = load8(word + i + 3);
                cp = ((b0 & 0x07) << 18) | ((b1c & 0x3F) << 12) | ((b2c & 0x3F) << 6) | (b3c & 0x3F);
                adv = 4;
            }
        }
        if (lower != 0) {
            cp = _shabda_ascii_lower(cp);
        }
        _shabda_vec_push_a(a, out, cp);
        i = i + adv;
    }
    return out;
}

# Build the lowercased codepoint array for a word (Latin engines).
#must_use
fn _shabda_word_chars(word): i64 {
    return _shabda_word_chars_a(default_alloc(), word);
}

# _shabda_word_chars, with every allocation drawn from Allocator `a`.
#must_use
fn _shabda_word_chars_a(a, word): i64 {
    return _shabda_decode_chars_a(a, word, 1);
}

# Safe vec_get: returns -1 when idx is out of bounds (Rust's chars.get(i)).
#must_use
fn _shabda_cp_at(chars, idx): i64 {
    if (idx < 0) { return (0 - 1); }
    if (idx >= vec_len(chars)) { return (0 - 1); }
    return vec_get(chars, idx);
}

# ================================================================
# English letter-to-sound rules (3.1.3).
#
# A context-sensitive rule set after Elovitz, Johnson, McHugh and Shore, "Letter-to-Sound
# Rules for Automatic Translation of English Text to Phonetics", NRL Report 7948 (1976;
# a US Government work, public domain), with additions measured against CMUdict (the
# 3.1.3 CHANGELOG entry lists them and the accuracy). Through 3.1.2 the rules were the
# Rust's: one phoneme per letter plus 2- to 4-letter patterns with no context, which got
# 13.5% of CMUdict's words exactly right.
#
# A rule is LEFT [MATCH] RIGHT -> ARPABET. The word is scanned left to right; at each
# position the first rule for the letter there whose MATCH spells the next letters and
# whose LEFT / RIGHT contexts fit gives the phonemes, and the scan moves past MATCH.
# Context symbols (NRL's):
#   ' '  a word boundary (any non-letter)     #  one or more vowels (a e i o u)
#   ':'  zero or more consonants              ^  one consonant (y counts as one)
#   '.'  a voiced consonant b d v g j l m n r w z
#   '+'  a front vowel e i y                  %  a suffix: er e es ed ing ely
#   '&'  a sibilant s c g z x j ch sh         @  t s r d l z n j th ch sh
# Letters match themselves. LEFT is read right to left from the letter before MATCH.
#
# The ARPABET maps to svara exactly as shabdakosh maps CMUdict (AH0 is schwa, AH1 / AH2
# is /ʌ/, IY is /iː/), so the rules and the dictionary never disagree on a symbol;
# tests/engine.tcyr checks every symbol against shbdk_arpabet_to_phoneme_with_stress.
#
# The table is built once per process on the default heap, like the heteronym rules,
# and shabda_g2p_new builds it, so a conversion through an Allocator never builds it.
# ================================================================

var _SHABDA_EN_RULES = 0;

# Rule record (40 bytes): left, match, right (cstrings), phonemes (vec), match length.
var SHABDA_EN_LEFT   = 0;
var SHABDA_EN_MATCH  = 8;
var SHABDA_EN_RIGHT  = 16;
var SHABDA_EN_PH     = 24;
var SHABDA_EN_MLEN   = 32;
var SHABDA_EN_SIZE   = 40;

# ARPABET symbol (the `len` bytes at `s`, with or without a stress digit) -> svara
# ordinal, or -1. shabdakosh's mapping: AH with stress 0 is schwa.
fn _shabda_en_arpabet(s, len): i64 {
    var d = load8(s + len - 1);
    var base = len;
    if (d >= 48 && d <= 50) { base = len - 1; }
    var c0 = load8(s);
    var c1 = 0;
    if (base >= 2) { c1 = load8(s + 1); }
    if (base == 2) {
        if (c0 == 65 && c1 == 65) { return SVARA_PH_VOWEL_OPEN_A; }                   # AA
        if (c0 == 65 && c1 == 69) { return SVARA_PH_VOWEL_ASH; }                      # AE
        if (c0 == 65 && c1 == 72) {                                                    # AH
            if (d == 48) { return SVARA_PH_VOWEL_SCHWA; }
            return SVARA_PH_VOWEL_CUP_V;
        }
        if (c0 == 65 && c1 == 79) { return SVARA_PH_VOWEL_OPEN_O; }                   # AO
        if (c0 == 65 && c1 == 87) { return SVARA_PH_DIPH_AU; }                        # AW
        if (c0 == 65 && c1 == 89) { return SVARA_PH_DIPH_AI; }                        # AY
        if (c0 == 69 && c1 == 72) { return SVARA_PH_VOWEL_OPEN_E; }                   # EH
        if (c0 == 69 && c1 == 82) { return SVARA_PH_VOWEL_BIRD; }                     # ER
        if (c0 == 69 && c1 == 89) { return SVARA_PH_DIPH_EI; }                        # EY
        if (c0 == 73 && c1 == 72) { return SVARA_PH_VOWEL_NEAR_I; }                   # IH
        if (c0 == 73 && c1 == 89) { return SVARA_PH_VOWEL_LONG_I; }                   # IY
        if (c0 == 79 && c1 == 87) { return SVARA_PH_DIPH_OU; }                        # OW
        if (c0 == 79 && c1 == 89) { return SVARA_PH_DIPH_OI; }                        # OY
        if (c0 == 85 && c1 == 72) { return SVARA_PH_VOWEL_NEAR_U; }                   # UH
        if (c0 == 85 && c1 == 87) { return SVARA_PH_VOWEL_U; }                        # UW
        if (c0 == 67 && c1 == 72) { return SVARA_PH_AFFR_CH; }                        # CH
        if (c0 == 68 && c1 == 72) { return SVARA_PH_FRIC_DH; }                        # DH
        if (c0 == 72 && c1 == 72) { return SVARA_PH_FRIC_H; }                         # HH
        if (c0 == 74 && c1 == 72) { return SVARA_PH_AFFR_J; }                         # JH
        if (c0 == 78 && c1 == 71) { return SVARA_PH_NASAL_NG; }                       # NG
        if (c0 == 83 && c1 == 72) { return SVARA_PH_FRIC_SH; }                        # SH
        if (c0 == 84 && c1 == 72) { return SVARA_PH_FRIC_TH; }                        # TH
        if (c0 == 90 && c1 == 72) { return SVARA_PH_FRIC_ZH; }                        # ZH
        return 0 - 1;
    }
    if (base != 1) { return 0 - 1; }
    if (c0 == 66) { return SVARA_PH_PLOSIVE_B; }
    if (c0 == 68) { return SVARA_PH_PLOSIVE_D; }
    if (c0 == 70) { return SVARA_PH_FRIC_F; }
    if (c0 == 71) { return SVARA_PH_PLOSIVE_G; }
    if (c0 == 75) { return SVARA_PH_PLOSIVE_K; }
    if (c0 == 76) { return SVARA_PH_LATERAL_L; }
    if (c0 == 77) { return SVARA_PH_NASAL_M; }
    if (c0 == 78) { return SVARA_PH_NASAL_N; }
    if (c0 == 80) { return SVARA_PH_PLOSIVE_P; }
    if (c0 == 82) { return SVARA_PH_APPROX_R; }
    if (c0 == 83) { return SVARA_PH_FRIC_S; }
    if (c0 == 84) { return SVARA_PH_PLOSIVE_T; }
    if (c0 == 86) { return SVARA_PH_FRIC_V; }
    if (c0 == 87) { return SVARA_PH_APPROX_W; }
    if (c0 == 89) { return SVARA_PH_APPROX_J; }
    if (c0 == 90) { return SVARA_PH_FRIC_Z; }
    return 0 - 1;
}

# Space-separated ARPABET -> vec of svara ordinals (default heap; the table only).
fn _shabda_en_phonemes(spec): i64 {
    var v = vec_new();
    var n = strlen(spec);
    var i = 0;
    while (i < n) {
        while (i < n && load8(spec + i) == 32) { i = i + 1; }
        var j = i;
        while (j < n && load8(spec + j) != 32) { j = j + 1; }
        if (j > i) {
            var ph = _shabda_en_arpabet(spec + i, j - i);
            if (ph >= 0) { vec_push(v, ph); }
        }
        i = j;
    }
    return v;
}

# Bucket index of a letter: a..z -> 0..25, apostrophe 26, anything else -1.
fn _shabda_en_bucket(c): i64 {
    if (c >= 97 && c <= 122) { return c - 97; }
    if (c == 39) { return 26; }
    return 0 - 1;
}

# Append one rule to the bucket of its first MATCH letter.
fn _shabda_en_r(tab, left, spell, right, spec): i64 {
    var r = alloc(SHABDA_EN_SIZE);
    store64(r + SHABDA_EN_LEFT, left);
    store64(r + SHABDA_EN_MATCH, spell);
    store64(r + SHABDA_EN_RIGHT, right);
    store64(r + SHABDA_EN_PH, _shabda_en_phonemes(spec));
    store64(r + SHABDA_EN_MLEN, strlen(spell));
    vec_push(vec_get(tab, _shabda_en_bucket(load8(spell))), r);
    return 0;
}

# The rule table, built on first use (on the default heap) and kept.
fn _shabda_en_rules_table(): i64 {
    if (_SHABDA_EN_RULES != 0) { return _SHABDA_EN_RULES; }
    var tab = vec_new();
    var k = 0;
    while (k < 27) { vec_push(tab, vec_new()); k = k + 1; }
    _shabda_en_rules_a_e(tab);
    _shabda_en_rules_f_n(tab);
    _shabda_en_rules_o_s(tab);
    _shabda_en_rules_t_z(tab);
    _shabda_en_stress_lists();
    _SHABDA_EN_RULES = tab;
    return tab;
}

# ASCII alphabetic test (Rust char::is_alphabetic for ASCII inputs). The Hindi, Sanskrit
# and Arabic rules use it for their romanized input.
#must_use
fn _shabda_rules_is_ascii_alpha(cp): i64 {
    if (cp >= 0x61) { if (cp <= 0x7A) { return 1; } }
    if (cp >= 0x41) { if (cp <= 0x5A) { return 1; } }
    return 0;
}

# ---- character classes over the word, with a boundary outside it ----------------
# The letter at i, or 32 (a boundary) outside the word or at a non-letter. An
# apostrophe stays itself so the rules can name it.
fn _shabda_en_ch(chars, i): i64 {
    if (i < 0) { return 32; }
    if (i >= vec_len(chars)) { return 32; }
    var c = vec_get(chars, i);
    if (c >= 97 && c <= 122) { return c; }
    if (c == 39) { return 39; }
    return 32;
}

fn _shabda_en_is_vowel(c): i64 {
    if (c == 97 || c == 101 || c == 105 || c == 111 || c == 117) { return 1; }
    return 0;
}

fn _shabda_en_is_cons(c): i64 {
    if (c < 97 || c > 122) { return 0; }
    if (_shabda_en_is_vowel(c) == 1) { return 0; }
    return 1;
}

fn _shabda_en_is_voiced(c): i64 {
    if (c == 98 || c == 100 || c == 118 || c == 103 || c == 106 || c == 108) { return 1; }
    if (c == 109 || c == 110 || c == 114 || c == 119 || c == 122) { return 1; }
    return 0;
}

fn _shabda_en_is_front(c): i64 {
    if (c == 101 || c == 105 || c == 121) { return 1; }
    return 0;
}

fn _shabda_en_is_sib1(c): i64 {
    if (c == 115 || c == 99 || c == 103 || c == 122 || c == 120 || c == 106) { return 1; }
    return 0;
}

fn _shabda_en_is_at1(c): i64 {
    if (c == 116 || c == 115 || c == 114 || c == 100 || c == 108 || c == 122) { return 1; }
    if (c == 110 || c == 106) { return 1; }
    return 0;
}

# LEFT context `pat` against the letters before `pos`, read right to left. 1 or 0.
fn _shabda_en_left_ok(chars, pos, pat): i64 {
    var t = pos - 1;
    var k = strlen(pat) - 1;
    while (k >= 0) {
        var p = load8(pat + k);
        var c = _shabda_en_ch(chars, t);
        if (p == 35) {                                       # '#'
            if (_shabda_en_is_vowel(c) == 0) { return 0; }
            t = t - 1;
            while (_shabda_en_is_vowel(_shabda_en_ch(chars, t)) == 1) { t = t - 1; }
        } elif (p == 58) {                                   # ':'
            while (_shabda_en_is_cons(_shabda_en_ch(chars, t)) == 1) { t = t - 1; }
        } elif (p == 94) {                                   # '^'
            if (_shabda_en_is_cons(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 46) {                                   # '.'
            if (_shabda_en_is_voiced(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 43) {                                   # '+'
            if (_shabda_en_is_front(c) == 0) { return 0; }
            t = t - 1;
        } elif (p == 38) {                                   # '&'
            if (_shabda_en_is_sib1(c) == 1) {
                t = t - 1;
            } elif (c == 104 && (_shabda_en_ch(chars, t - 1) == 99 || _shabda_en_ch(chars, t - 1) == 115)) {
                t = t - 2;
            } else { return 0; }
        } elif (p == 64) {                                   # '@'
            if (_shabda_en_is_at1(c) == 1) {
                t = t - 1;
            } elif (c == 104 && (_shabda_en_ch(chars, t - 1) == 116 || _shabda_en_ch(chars, t - 1) == 99
                || _shabda_en_ch(chars, t - 1) == 115)) {
                t = t - 2;
            } else { return 0; }
        } elif (p == 32) {                                   # boundary
            if (c != 32) { return 0; }
            t = t - 1;
        } else {
            if (c != p) { return 0; }
            t = t - 1;
        }
        k = k - 1;
    }
    return 1;
}

# RIGHT context `pat` against the letters from `pos` on, read left to right. 1 or 0.
fn _shabda_en_right_ok(chars, pos, pat): i64 {
    var t = pos;
    var n = strlen(pat);
    var k = 0;
    while (k < n) {
        var p = load8(pat + k);
        var c = _shabda_en_ch(chars, t);
        if (p == 35) {
            if (_shabda_en_is_vowel(c) == 0) { return 0; }
            t = t + 1;
            while (_shabda_en_is_vowel(_shabda_en_ch(chars, t)) == 1) { t = t + 1; }
        } elif (p == 58) {
            while (_shabda_en_is_cons(_shabda_en_ch(chars, t)) == 1) { t = t + 1; }
        } elif (p == 94) {
            if (_shabda_en_is_cons(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 46) {
            if (_shabda_en_is_voiced(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 43) {
            if (_shabda_en_is_front(c) == 0) { return 0; }
            t = t + 1;
        } elif (p == 37) {                                   # '%': er e es ed ing ely
            if (c == 101) {
                t = t + 1;
                var c2 = _shabda_en_ch(chars, t);
                if (c2 == 108 && _shabda_en_ch(chars, t + 1) == 121) {
                    t = t + 2;
                } elif (c2 == 114 || c2 == 115 || c2 == 100) {
                    t = t + 1;
                }
            } elif (c == 105 && _shabda_en_ch(chars, t + 1) == 110 && _shabda_en_ch(chars, t + 2) == 103) {
                t = t + 3;
            } else { return 0; }
        } elif (p == 38) {
            if (c == 99 || c == 115) {
                if (_shabda_en_ch(chars, t + 1) == 104) { t = t + 2; } else { t = t + 1; }
            } elif (_shabda_en_is_sib1(c) == 1) {
                t = t + 1;
            } else { return 0; }
        } elif (p == 64) {
            if ((c == 116 || c == 99 || c == 115) && _shabda_en_ch(chars, t + 1) == 104) {
                t = t + 2;
            } elif (_shabda_en_is_at1(c) == 1) {
                t = t + 1;
            } else { return 0; }
        } elif (p == 32) {
            if (c != 32) { return 0; }
            t = t + 1;
        } else {
            if (c != p) { return 0; }
            t = t + 1;
        }
        k = k + 1;
    }
    return 1;
}

# 1 if rule `r`'s MATCH spells the letters at `pos` and both contexts fit.
fn _shabda_en_fits(chars, pos, r): i64 {
    var m = load64(r + SHABDA_EN_MATCH);
    var ml = load64(r + SHABDA_EN_MLEN);
    var k = 0;
    while (k < ml) {
        if (_shabda_en_ch(chars, pos + k) != load8(m + k)) { return 0; }
        k = k + 1;
    }
    if (_shabda_en_left_ok(chars, pos, load64(r + SHABDA_EN_LEFT)) == 0) { return 0; }
    if (_shabda_en_right_ok(chars, pos + ml, load64(r + SHABDA_EN_RIGHT)) == 0) { return 0; }
    return 1;
}

# Public English engine. Returns a fresh vec of svara phoneme ordinals.
#must_use
fn shabda_english_rules(word): i64 {
    return _shabda_english_rules_a(default_alloc(), word);
}

# shabda_english_rules, with every allocation drawn from Allocator `a`. The rule table
# itself is the process's, built on the default heap (shabda_g2p_new builds it first).
#must_use
fn _shabda_english_rules_a(a, word): i64 {
    var chars = _shabda_word_chars_a(a, word);
    var out = vec_new_a(a);
    var tab = _shabda_en_rules_table();
    var n = vec_len(chars);
    var i = 0;
    while (i < n) {
        var c = vec_get(chars, i);
        if (c == 45) {                                       # '-': a pause
            _shabda_vec_push_a(a, out, SVARA_PH_SILENCE);
            i = i + 1;
            continue;
        }
        var b = _shabda_en_bucket(_shabda_en_ch(chars, i));
        if (b < 0) { i = i + 1; continue; }                  # not a letter: no sound
        var rules = vec_get(tab, b);
        var nr = vec_len(rules);
        var step = 1;
        var k = 0;
        while (k < nr) {
            var r = vec_get(rules, k);
            if (_shabda_en_fits(chars, i, r) == 1) {
                var ph = load64(r + SHABDA_EN_PH);
                var q = 0;
                while (q < vec_len(ph)) { _shabda_vec_push_a(a, out, vec_get(ph, q)); q = q + 1; }
                step = load64(r + SHABDA_EN_MLEN);
                break;
            }
            k = k + 1;
        }
        i = i + step;
    }
    _shabda_en_ed_voicing(chars, out);
    _shabda_en_reduce(chars, out);
    return out;
}

# The -ed of a past tense after a silent e is /t/ after a voiceless consonant and /d/
# otherwise ("walked", "played", "hoped"): the letter rules only see letters, and y or
# a vowel before the e is neither of their voiced-consonant contexts. Fixes the output
# in place.
fn _shabda_en_ed_voicing(chars, out): i64 {
    var n = vec_len(out);
    if (vec_len(chars) < 4 || n < 2) { return 0; }
    if (_shabda_en_ends(chars, "ed") == 0) { return 0; }
    var last = vec_get(out, n - 1);
    if (last != SVARA_PH_PLOSIVE_T && last != SVARA_PH_PLOSIVE_D) { return 0; }
    var prev = vec_get(out, n - 2);
    if (prev == SVARA_PH_PLOSIVE_T || prev == SVARA_PH_PLOSIVE_D) { return 0; }
    if (prev == SVARA_PH_PLOSIVE_P || prev == SVARA_PH_PLOSIVE_K || prev == SVARA_PH_FRIC_F
      || prev == SVARA_PH_FRIC_S || prev == SVARA_PH_FRIC_SH || prev == SVARA_PH_AFFR_CH
      || prev == SVARA_PH_FRIC_TH) {
        vec_set(out, n - 1, SVARA_PH_PLOSIVE_T);
    } else {
        vec_set(out, n - 1, SVARA_PH_PLOSIVE_D);
    }
    return 0;
}

# ---- vowel reduction --------------------------------------------------------------------
# Letter rules cannot see stress, so they give a full vowel where English reduces an
# unstressed one to schwa: CMUdict's AH0 in "abandon", "absolute", "academy". This pass
# predicts the primary stress, keeps a secondary two syllables before it (CMUdict's 2),
# and turns AA, AE, AH, AO and EH in every other syllable into schwa. IH, IY, UW, the
# diphthongs and ER stay: CMUdict keeps them unstressed (IH0, IY0, OW0).
#
# The stress guess, in order: a stress-taking suffix (-ee, -eer, -ese, -ique, -oon,
# -ette, -esque, -aire, -ade) stresses the last syllable; -ity, -ify, -ible, -ical,
# -graphy, -logy, -ometer, -inal, -itive, -ative stress the third from last; -tion,
# -sion, -cian, -tian, -ic, -ically, -ial, -ian, -ious, -eous, -ual, -uous, -ient,
# -ience, -itis, -osis the second from last. Otherwise a two-syllable word is stressed
# on the first syllable unless it starts with an unstressed prefix (a-, be-, de-, re-,
# con-, ex-, …) before a consonant; a longer word follows the Latin rule: the second
# from last if that syllable is heavy (a long vowel or diphthong, or two consonants
# after it), else the third from last. Measured on CMUdict: +3.5 points of exact words
# on both halves (the 3.1.3 CHANGELOG entry).

# 1 if the last letters of `chars` spell `suf`.
fn _shabda_en_ends(chars, suf): i64 {
    var n = vec_len(chars);
    var m = strlen(suf);
    if (m > n) { return 0; }
    var k = 0;
    while (k < m) {
        if (vec_get(chars, n - m + k) != load8(suf + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# 1 if `chars` starts with `pre`, has more than two letters after it, and the letter
# right after it is a consonant.
fn _shabda_en_unstressed_prefix(chars, pre): i64 {
    var n = vec_len(chars);
    var m = strlen(pre);
    if (n <= m + 2) { return 0; }
    var k = 0;
    while (k < m) {
        if (vec_get(chars, k) != load8(pre + k)) { return 0; }
        k = k + 1;
    }
    if (_shabda_en_is_vowel(_shabda_en_ch(chars, m)) == 1) { return 0; }
    return 1;
}

fn _shabda_en_any_suffix(chars, list, count): i64 {
    var k = 0;
    while (k < count) {
        if (_shabda_en_ends(chars, load64(list + k * 8)) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

var _SHABDA_EN_SUF_LAST = 0;
var _SHABDA_EN_SUF_ANTE = 0;
var _SHABDA_EN_SUF_PEN = 0;
var _SHABDA_EN_PREFIXES = 0;
var _SHABDA_EN_PREFIXES2 = 0;

# A list of 17 cstring pointers, built once on the default heap ("" fills the tail).
fn _shabda_en_list(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16): i64 {
    var l = alloc(17 * 8);
    store64(l, a0); store64(l + 8, a1); store64(l + 16, a2); store64(l + 24, a3);
    store64(l + 32, a4); store64(l + 40, a5); store64(l + 48, a6); store64(l + 56, a7);
    store64(l + 64, a8); store64(l + 72, a9); store64(l + 80, a10); store64(l + 88, a11);
    store64(l + 96, a12); store64(l + 104, a13); store64(l + 112, a14); store64(l + 120, a15);
    store64(l + 128, a16);
    return l;
}

fn _shabda_en_stress_lists(): i64 {
    if (_SHABDA_EN_SUF_LAST != 0) { return 0; }
    _SHABDA_EN_SUF_ANTE = _shabda_en_list("ity", "ify", "ible", "ical", "graphy", "logy", "ometer",
      "inal", "itive", "ative", "", "", "", "", "", "", "");
    _SHABDA_EN_SUF_PEN = _shabda_en_list("tion", "sion", "cian", "tian", "ic", "ical", "ically", "ial",
      "ian", "ious", "eous", "ual", "uous", "ient", "ience", "itis", "osis");
    _SHABDA_EN_PREFIXES = _shabda_en_list("a", "be", "de", "re", "pre", "con", "com", "ex", "in", "dis",
      "mis", "ob", "sub", "per", "pro", "sus", "e");
    _SHABDA_EN_PREFIXES2 = _shabda_en_list("en", "em", "ad", "ac", "ap", "as", "at", "af", "al", "an",
      "ar", "im", "un", "for", "fore", "", "");
    _SHABDA_EN_SUF_LAST = _shabda_en_list("ee", "eer", "ese", "ique", "oon", "ette", "esque", "aire",
      "ade", "", "", "", "", "", "", "", "");
    return 0;
}

fn _shabda_en_is_long(ph): i64 {
    if (ph >= SVARA_PH_DIPH_AI && ph <= SVARA_PH_DIPH_OU) { return 1; }
    if (ph == SVARA_PH_VOWEL_LONG_I || ph == SVARA_PH_VOWEL_U || ph == SVARA_PH_VOWEL_O) { return 1; }
    return 0;
}

fn _shabda_en_is_nucleus(ph): i64 {
    var c = svara_phoneme_class(ph);
    if (c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) { return 1; }
    return 0;
}

fn _shabda_en_reducible(ph): i64 {
    if (ph == SVARA_PH_VOWEL_OPEN_A || ph == SVARA_PH_VOWEL_ASH || ph == SVARA_PH_VOWEL_CUP_V) { return 1; }
    if (ph == SVARA_PH_VOWEL_OPEN_O || ph == SVARA_PH_VOWEL_OPEN_E) { return 1; }
    return 0;
}

# The predicted primary-stress syllable (0-based) of an `n`-syllable word.
fn _shabda_en_stress_index(chars, out, n): i64 {
    if (n <= 1) { return 0; }
    if (_shabda_en_any_suffix(chars, _SHABDA_EN_SUF_LAST, 9) == 1) { return n - 1; }
    if (n >= 3 && _shabda_en_any_suffix(chars, _SHABDA_EN_SUF_ANTE, 10) == 1) { return n - 3; }
    if (_shabda_en_any_suffix(chars, _SHABDA_EN_SUF_PEN, 17) == 1) { return n - 2; }
    if (n == 2) {
        var k = 0;
        while (k < 17) {
            if (_shabda_en_unstressed_prefix(chars, load64(_SHABDA_EN_PREFIXES + k * 8)) == 1) { return 1; }
            k = k + 1;
        }
        k = 0;
        while (k < 15) {
            if (_shabda_en_unstressed_prefix(chars, load64(_SHABDA_EN_PREFIXES2 + k * 8)) == 1) { return 1; }
            k = k + 1;
        }
        return 0;
    }
    # Latin rule over the last two nuclei.
    var pen = 0 - 1;
    var fin = 0 - 1;
    var i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { pen = fin; fin = i; }
        i = i + 1;
    }
    if (_shabda_en_is_long(vec_get(out, pen)) == 1 || fin - pen - 1 >= 2) { return n - 2; }
    return n - 3;
}

# Reduce the unstressed full vowels of `out` (in place) to schwa.
fn _shabda_en_reduce(chars, out): i64 {
    _shabda_en_stress_lists();
    var n = 0;
    var i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { n = n + 1; }
        i = i + 1;
    }
    if (n <= 1) { return 0; }
    var s = _shabda_en_stress_index(chars, out, n);
    var k = 0;
    i = 0;
    while (i < vec_len(out)) {
        var ph = vec_get(out, i);
        if (_shabda_en_is_nucleus(ph) == 1) {
            if (k != s && k != s - 2 && _shabda_en_reducible(ph) == 1) { vec_set(out, i, SVARA_PH_VOWEL_SCHWA); }
            k = k + 1;
        }
        i = i + 1;
    }
    # A schwa, r and a vowel after a first syllable is CMUdict's ER0 + vowel ("memory",
    # "accessory"): the r is the vowel's colouring, not a consonant of its own.
    i = 1;
    while (i + 2 < vec_len(out)) {
        if (vec_get(out, i) == SVARA_PH_VOWEL_SCHWA && vec_get(out, i + 1) == SVARA_PH_APPROX_R
          && _shabda_en_is_nucleus(vec_get(out, i + 2)) == 1) {
            vec_set(out, i, SVARA_PH_VOWEL_BIRD);
            vec_remove(out, i + 1);
        }
        i = i + 1;
    }
    # A medial /ɪ/ after a full vowel is unstressed and reduces too ("accident", "ability").
    n = 0;
    i = 0;
    while (i < vec_len(out)) {
        if (_shabda_en_is_nucleus(vec_get(out, i)) == 1) { n = n + 1; }
        i = i + 1;
    }
    if (n < 3) { return 0; }
    k = 0;
    var prev = 0 - 1;
    i = 0;
    while (i < vec_len(out)) {
        var q = vec_get(out, i);
        if (_shabda_en_is_nucleus(q) == 1) {
            if (k > 0 && k < n - 1 && q == SVARA_PH_VOWEL_NEAR_I && prev != SVARA_PH_VOWEL_SCHWA) {
                vec_set(out, i, SVARA_PH_VOWEL_SCHWA);
            }
            prev = vec_get(out, i);
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ---- the rules, by first letter -------------------------------------------------------
# NRL Report 7948's rules in its order, its phoneme codes written as ARPABET (its AX is
# AH0, its AH is AH1). Lines marked `+` are additions beyond NRL (see the CHANGELOG).
fn _shabda_en_rules_a_e(t): i64 {
    # a
    _shabda_en_r(t, "", "a", " ", "AH0");
    _shabda_en_r(t, "", "ay", "", "EY1");
    _shabda_en_r(t, "", "a", "x", "AE1");
    _shabda_en_r(t, "", "alm", "", "AA1 M");
    _shabda_en_r(t, "#:", "ance", " ", "AH0 N S");
    _shabda_en_r(t, "#:", "ancy", " ", "AH0 N S IY0");
    _shabda_en_r(t, "#:", "ant", " ", "AH0 N T");
    _shabda_en_r(t, "#:", "ants", " ", "AH0 N T S");
    _shabda_en_r(t, " ", "are", " ", "AA1 R");
    _shabda_en_r(t, " ", "ar", "o", "AH0 R");
    _shabda_en_r(t, "", "ar", "#", "EH1 R");
    _shabda_en_r(t, "^", "as", "#", "EY1 S");
    _shabda_en_r(t, "", "a", "wa", "AH0");
    _shabda_en_r(t, "", "aw", "", "AO1");
    _shabda_en_r(t, " :", "any", "", "EH1 N IY0");
    _shabda_en_r(t, "", "a", "^+#", "EY1");
    _shabda_en_r(t, "#:", "ally", "", "AH0 L IY0");
    _shabda_en_r(t, " ", "al", "#", "AH0 L");
    _shabda_en_r(t, "", "again", "", "AH0 G EH1 N");
    _shabda_en_r(t, "#:", "ag", "e", "IH0 JH");
    _shabda_en_r(t, "", "a", "^+:#", "AE1");
    _shabda_en_r(t, " :", "a", "^+ ", "EY1");
    _shabda_en_r(t, "", "a", "^%", "EY1");
    _shabda_en_r(t, " ", "arr", "", "AH0 R");
    _shabda_en_r(t, "", "arr", "", "AE1 R");
    _shabda_en_r(t, " :", "ar", " ", "AA1 R");
    _shabda_en_r(t, "", "ar", " ", "ER0");
    _shabda_en_r(t, "", "ar", "", "AA1 R");
    _shabda_en_r(t, "", "air", "", "EH1 R");
    _shabda_en_r(t, "", "ai", "", "EY1");
    _shabda_en_r(t, "", "au", "", "AO1");
    _shabda_en_r(t, "#:", "al", " ", "AH0 L");
    _shabda_en_r(t, "#:", "als", " ", "AH0 L Z");
    _shabda_en_r(t, "", "alk", "", "AO1 K");
    _shabda_en_r(t, "", "al", "^", "AO1 L");
    _shabda_en_r(t, " :", "able", "", "EY1 B AH0 L");
    _shabda_en_r(t, "", "able", "", "AH0 B AH0 L");
    _shabda_en_r(t, "", "ang", "+", "EY1 N JH");
    _shabda_en_r(t, "", "a", "", "AE1");
    # b
    _shabda_en_r(t, "b", "b", "", "");
    _shabda_en_r(t, " ", "be", "^#", "B IH0");
    _shabda_en_r(t, "", "being", "", "B IY1 IH0 NG");
    _shabda_en_r(t, " ", "both", " ", "B OW1 TH");
    _shabda_en_r(t, " ", "bus", "#", "B IH1 Z");
    _shabda_en_r(t, "", "buil", "", "B IH1 L");
    _shabda_en_r(t, "m", "b", " ", "");                                     # + lamb, climb
    _shabda_en_r(t, "", "b", "t ", "");                                     # + debt, doubt
    _shabda_en_r(t, "", "b", "", "B");
    # c
    _shabda_en_r(t, "", "cc", "+", "K S");
    _shabda_en_r(t, "", "cc", "", "K");
    _shabda_en_r(t, " ", "ch", "^", "K");
    _shabda_en_r(t, "^e", "ch", "", "K");
    _shabda_en_r(t, "", "ch", "", "CH");
    _shabda_en_r(t, " s", "ci", "#", "S AY1");
    _shabda_en_r(t, "", "ci", "a", "SH");
    _shabda_en_r(t, "", "ci", "o", "SH");
    _shabda_en_r(t, "", "ci", "en", "SH");
    _shabda_en_r(t, "", "c", "+", "S");
    _shabda_en_r(t, "", "ck", "", "K");
    _shabda_en_r(t, "", "com", "%", "K AH1 M");
    _shabda_en_r(t, "", "c", "", "K");
    # d
    _shabda_en_r(t, "d", "d", "", "");
    _shabda_en_r(t, "", "dg", "+", "JH");
    _shabda_en_r(t, "", "dj", "", "JH");
    _shabda_en_r(t, "#:", "ded", " ", "D IH0 D");
    _shabda_en_r(t, ".e", "d", " ", "D");
    _shabda_en_r(t, "#:^e", "d", " ", "T");
    _shabda_en_r(t, " ", "de", "^#", "D IH0");
    _shabda_en_r(t, " ", "do", " ", "D UW1");
    _shabda_en_r(t, " ", "does", "", "D AH1 Z");
    _shabda_en_r(t, " ", "doing", "", "D UW1 IH0 NG");
    _shabda_en_r(t, " ", "dow", "", "D AW1");
    _shabda_en_r(t, "", "du", "a", "JH UW1");
    _shabda_en_r(t, "", "d", "", "D");
    # e
    _shabda_en_r(t, "#:", "ence", " ", "AH0 N S");
    _shabda_en_r(t, "#:", "ency", " ", "AH0 N S IY0");
    _shabda_en_r(t, "#:", "ent", " ", "AH0 N T");
    _shabda_en_r(t, "#:", "ents", " ", "AH0 N T S");
    _shabda_en_r(t, "#:", "e", " ", "");
    _shabda_en_r(t, "'^:", "e", " ", "");
    _shabda_en_r(t, " :", "e", " ", "IY1");
    _shabda_en_r(t, "#", "ed", " ", "D");
    _shabda_en_r(t, "#:", "e", "d ", "");
    _shabda_en_r(t, "#:", "ere", " ", "IH1 R");
    _shabda_en_r(t, " :", "ere", " ", "IH1 R");
    _shabda_en_r(t, "", "ey", "", "IY0");
    _shabda_en_r(t, "", "ev", "er", "EH1 V");
    _shabda_en_r(t, "", "e", "^%", "IY1");
    _shabda_en_r(t, "", "eri", "#", "IY1 R IY0");
    _shabda_en_r(t, "", "eri", "", "EH1 R IH0");
    _shabda_en_r(t, "#:", "er", "#", "ER0");
    _shabda_en_r(t, "", "er", "#", "EH1 R");
    _shabda_en_r(t, "", "er", "", "ER0");
    _shabda_en_r(t, " ", "even", "", "IY1 V EH0 N");
    _shabda_en_r(t, "#:", "e", "w", "");
    _shabda_en_r(t, "@", "ew", "", "UW1");
    _shabda_en_r(t, "", "ew", "", "Y UW1");
    _shabda_en_r(t, "", "e", "o", "IY0");
    _shabda_en_r(t, "#:&", "es", " ", "IH0 Z");
    _shabda_en_r(t, "#:", "e", "s ", "");
    _shabda_en_r(t, "#:", "ely", " ", "L IY0");
    _shabda_en_r(t, "#:", "ement", "", "M AH0 N T");
    _shabda_en_r(t, "", "eful", "", "F UH0 L");
    _shabda_en_r(t, "", "ee", "", "IY1");
    _shabda_en_r(t, "", "ear", "#", "IH1 R");
    _shabda_en_r(t, "", "ear", " ", "IH1 R");
    _shabda_en_r(t, "", "ear", "s ", "IH1 R");
    _shabda_en_r(t, "", "earn", "", "ER1 N");
    _shabda_en_r(t, " ", "ear", "^", "ER1");
    _shabda_en_r(t, "", "ead", "", "EH1 D");
    _shabda_en_r(t, "#:", "ea", " ", "IY0 AH0");
    _shabda_en_r(t, "", "ea", "su", "EH1");
    _shabda_en_r(t, "", "ea", "", "IY1");
    _shabda_en_r(t, "", "eigh", "", "EY1");
    _shabda_en_r(t, "", "ei", "", "IY1");
    _shabda_en_r(t, " ", "eye", "", "AY1");
    _shabda_en_r(t, "", "eu", "", "Y UW1");
    _shabda_en_r(t, "", "e", "", "EH1");
    return 0;
}

fn _shabda_en_rules_f_n(t): i64 {
    # f
    _shabda_en_r(t, "f", "f", "", "");
    _shabda_en_r(t, "", "ful", "", "F UH0 L");
    _shabda_en_r(t, "", "f", "", "F");
    # g
    _shabda_en_r(t, "", "giv", "", "G IH1 V");
    _shabda_en_r(t, " ", "g", "i^", "G");
    _shabda_en_r(t, "", "ge", "t", "G EH1");
    _shabda_en_r(t, "su", "gges", "", "G JH EH1 S");
    _shabda_en_r(t, "", "gg", "", "G");
    _shabda_en_r(t, " b#", "g", "", "G");
    _shabda_en_r(t, " ", "gn", "", "N");                                    # + gnome, gnaw
    _shabda_en_r(t, "", "gn", " ", "N");                                    # + sign, design
    _shabda_en_r(t, "", "g", "+", "JH");
    _shabda_en_r(t, "", "great", "", "G R EY1 T");
    _shabda_en_r(t, "#", "gh", "", "");
    _shabda_en_r(t, "", "g", "", "G");
    # h
    _shabda_en_r(t, " ", "hav", "", "HH AE1 V");
    _shabda_en_r(t, " ", "here", "", "HH IH1 R");
    _shabda_en_r(t, " ", "hour", "", "AW1 ER0");
    _shabda_en_r(t, "", "how", "", "HH AW1");
    _shabda_en_r(t, "", "h", "#", "HH");
    _shabda_en_r(t, "", "h", "", "");
    # i
    _shabda_en_r(t, "#:^", "ity", " ", "AH0 T IY0");
    _shabda_en_r(t, "", "ible", "", "AH0 B AH0 L");
    _shabda_en_r(t, "t", "ive", " ", "IH0 V");
    _shabda_en_r(t, "s", "ive", " ", "IH0 V");
    _shabda_en_r(t, " ", "in", "", "IH0 N");
    _shabda_en_r(t, " ", "i", " ", "AY1");
    _shabda_en_r(t, "", "in", "d", "AY1 N");
    _shabda_en_r(t, "", "ier", "", "IY0 ER0");
    _shabda_en_r(t, "#:r", "ied", "", "IY0 D");
    _shabda_en_r(t, "", "ied", " ", "AY1 D");
    _shabda_en_r(t, "", "ien", "", "IY0 EH0 N");
    _shabda_en_r(t, "", "ie", "t", "AY1 EH0");
    _shabda_en_r(t, "", "ie", "^e", "IY1");
    _shabda_en_r(t, " :", "i", "%", "AY1");
    _shabda_en_r(t, "", "i", "%", "IY1");
    _shabda_en_r(t, "", "ie", "", "IY1");
    _shabda_en_r(t, "#:^", "i", "#", "IY0");
    _shabda_en_r(t, "", "i", "^+:#", "IH1");
    _shabda_en_r(t, "", "ir", "#", "AY1 R");
