# rules.tcyr — tests for src/rules.cyr (ports rust-old/src/rules.rs #[test] blocks).
# One test_group per Rust test; same assertions. Grows one language at a time.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/rules.cyr"

alloc_init();

# ---- helper: does vec `v` contain value `x`? (Rust .contains) ----
fn _has(v, x): i64 {
    if (vec_find(v, x) == (0 - 1)) { return 0; }
    return 1;
}
fn _last(v): i64 {
    var n = vec_len(v);
    if (n == 0) { return (0 - 1); }
    return vec_get(v, n - 1);
}

# =============================================================================
# English
# =============================================================================
test_group("english basic");
var cat = shabda_english_rules("cat");
assert_neq(vec_len(cat), 0, "cat non-empty");
assert_eq(vec_get(cat, 0), SVARA_PH_PLOSIVE_K, "cat[0] = k");

var she = shabda_english_rules("she");
assert_eq(vec_get(she, 0), SVARA_PH_FRIC_SH, "she[0] = sh");

var the = shabda_english_rules("the");
assert_eq(vec_get(the, 0), SVARA_PH_FRIC_DH, "the[0] = dh");

var chat = shabda_english_rules("chat");
assert_eq(vec_get(chat, 0), SVARA_PH_AFFR_CH, "chat[0] = ch");

var empty = shabda_english_rules("");
assert_eq(vec_len(empty), 0, "empty is empty");

test_group("english silent letters");
var knight = shabda_english_rules("knight");
assert_neq(vec_get(knight, 0), SVARA_PH_PLOSIVE_K, "knight[0] != k");
assert_eq(vec_get(knight, 0), SVARA_PH_NASAL_N, "knight[0] = n");

var gnome = shabda_english_rules("gnome");
assert_eq(vec_get(gnome, 0), SVARA_PH_NASAL_N, "gnome[0] = n");

var write = shabda_english_rules("write");
assert_eq(vec_get(write, 0), SVARA_PH_APPROX_R, "write[0] = r");

var psalm = shabda_english_rules("psalm");
assert_eq(vec_get(psalm, 0), SVARA_PH_FRIC_S, "psalm[0] = s");

var lamb = shabda_english_rules("lamb");
assert_eq(_has(lamb, SVARA_PH_PLOSIVE_B), 0, "lamb has no b");

var go = shabda_english_rules("go");
assert_eq(vec_get(go, 0), SVARA_PH_PLOSIVE_G, "go[0] = g");

var high = shabda_english_rules("high");
assert_eq(_has(high, SVARA_PH_DIPH_AI), 1, "high has AI");

test_group("english magic-e + r-colored");
var make = shabda_english_rules("make");
assert_eq(_has(make, SVARA_PH_DIPH_EI), 1, "make has EI");

var time = shabda_english_rules("time");
assert_eq(_has(time, SVARA_PH_DIPH_AI), 1, "time has AI");

var home = shabda_english_rules("home");
assert_eq(_has(home, SVARA_PH_DIPH_OU), 1, "home has OU");

var car = shabda_english_rules("car");
assert_eq(_has(car, SVARA_PH_VOWEL_OPEN_A), 1, "car has OpenA");
assert_eq(_has(car, SVARA_PH_APPROX_R), 1, "car has R");

var bird = shabda_english_rules("bird");
assert_eq(_has(bird, SVARA_PH_VOWEL_BIRD), 1, "bird has Bird");

test_group("english morphology");
var nation = shabda_english_rules("nation");
assert_eq(_has(nation, SVARA_PH_FRIC_SH), 1, "nation has Sh");

var walked = shabda_english_rules("walked");
assert_eq(_last(walked), SVARA_PH_PLOSIVE_T, "walked ends t");

var wanted = shabda_english_rules("wanted");
var wl = vec_len(wanted);
assert_eq(wl >= 2, 1, "wanted len >= 2");
assert_eq(vec_get(wanted, wl - 2), SVARA_PH_VOWEL_NEAR_I, "wanted[-2] = NearI");
assert_eq(vec_get(wanted, wl - 1), SVARA_PH_PLOSIVE_D, "wanted[-1] = d");

var played = shabda_english_rules("played");
assert_eq(_last(played), SVARA_PH_PLOSIVE_D, "played ends d");

var unhappy = shabda_english_rules("unhappy");
assert_eq(vec_get(unhappy, 0), SVARA_PH_VOWEL_SCHWA, "unhappy[0] = schwa (CMUdict AH0)");
assert_eq(vec_get(unhappy, 1), SVARA_PH_NASAL_N, "unhappy[1] = n");

# =============================================================================
# Spanish
# =============================================================================
test_group("spanish");
var hola = shabda_spanish_rules("hola");
assert_eq(vec_get(hola, 0), SVARA_PH_VOWEL_O, "hola[0] = O");
assert_eq(vec_get(hola, 1), SVARA_PH_LATERAL_L, "hola[1] = L");
assert_eq(vec_get(hola, 2), SVARA_PH_VOWEL_A, "hola[2] = /a/ (was OpenA, English ɑ)");

var chico = shabda_spanish_rules("chico");
assert_eq(vec_get(chico, 0), SVARA_PH_AFFR_CH, "chico[0] = ch");

var llamar = shabda_spanish_rules("llamar");
assert_eq(vec_get(llamar, 0), SVARA_PH_FRIC_PALATAL_J, "llamar[0] = /ʝ/ (ll, yeísmo; was /j/)");

var perro = shabda_spanish_rules("perro");
assert_eq(_has(perro, SVARA_PH_TRILL_ALVEOLAR), 1, "perro has the trill (rr)");

var que = shabda_spanish_rules("que");
assert_eq(vec_get(que, 0), SVARA_PH_PLOSIVE_K, "que[0] = k");
assert_eq(vec_get(que, 1), SVARA_PH_VOWEL_E, "que[1] = /e/ (was OpenE, English ɛ)");

var guitarra = shabda_spanish_rules("guitarra");
assert_eq(vec_get(guitarra, 0), SVARA_PH_PLOSIVE_G, "guitarra[0] = g");

var sp_empty = shabda_spanish_rules("");
assert_eq(vec_len(sp_empty), 0, "spanish empty");

var nino = shabda_spanish_rules("niño");
assert_eq(_has(nino, SVARA_PH_NASAL_PALATAL), 1, "niño has /ɲ/ (was NG)");

# 1 if `v` is exactly the first `n` of p0..p7.
fn _esq(v, n, p0, p1, p2, p3, p4, p5, p6, p7): i64 {
    if (vec_len(v) != n) { return 0; }
    var want = vec_new();
    vec_push(want, p0); vec_push(want, p1); vec_push(want, p2); vec_push(want, p3);
    vec_push(want, p4); vec_push(want, p5); vec_push(want, p6); vec_push(want, p7);
    var i = 0;
    while (i < n) {
        if (vec_get(v, i) != vec_get(want, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}
var _va = SVARA_PH_VOWEL_A;
var _ve = SVARA_PH_VOWEL_E;
var _vi = SVARA_PH_VOWEL_I;
var _vo = SVARA_PH_VOWEL_O;
var _vu = SVARA_PH_VOWEL_U;
var _gj = SVARA_PH_APPROX_J;
var _gw = SVARA_PH_APPROX_W;

test_group("accuracy: Spanish /a e i o u/, not English stand-ins");
# The Rust spelled a e i u with svara's English ɑ ɛ ɪ ʌ, ñ /ŋ/, ll and consonantal y /j/,
# the jota /h/, and an unaccented i / u beside a vowel as a full vowel (ADR-0002).
assert_eq(_esq(shabda_spanish_rules("casa"), 4, SVARA_PH_PLOSIVE_K, _va, SVARA_PH_FRIC_S, _va, 0, 0, 0, 0), 1,
  "casa = k a s a");
assert_eq(_esq(shabda_spanish_rules("tú"), 2, SVARA_PH_PLOSIVE_T, _vu, 0, 0, 0, 0, 0, 0), 1, "tú = t u");
assert_eq(_esq(shabda_spanish_rules("sí"), 2, SVARA_PH_FRIC_S, _vi, 0, 0, 0, 0, 0, 0), 1, "sí = s i");
assert_eq(_esq(shabda_spanish_rules("pequeño"), 6, SVARA_PH_PLOSIVE_P, _ve, SVARA_PH_PLOSIVE_K, _ve,
    SVARA_PH_NASAL_PALATAL, _vo, 0, 0), 1, "pequeño = p e k e ɲ o");
fn _es_clean(word): i64 {
    var v = shabda_spanish_rules(word);
    if (_has(v, SVARA_PH_VOWEL_OPEN_A) == 1 || _has(v, SVARA_PH_VOWEL_OPEN_E) == 1) { return 0; }
    if (_has(v, SVARA_PH_VOWEL_NEAR_I) == 1 || _has(v, SVARA_PH_VOWEL_CUP_V) == 1) { return 0; }
    if (_has(v, SVARA_PH_NASAL_NG) == 1 || _has(v, SVARA_PH_FRIC_H) == 1 || _has(v, SVARA_PH_APPROX_R) == 1) {
        return 0;
    }
    return 1;
}
assert_eq(_es_clean("murciélago"), 1, "murciélago: no stand-in");
assert_eq(_es_clean("universidad"), 1, "universidad: no stand-in");
assert_eq(_es_clean("cumpleaños"), 1, "cumpleaños: no stand-in");
assert_eq(_es_clean("jirafa"), 1, "jirafa: no stand-in");

test_group("accuracy: Spanish glides /j w/ and hiatus");
assert_eq(_esq(shabda_spanish_rules("quién"), 4, SVARA_PH_PLOSIVE_K, _gj, _ve, SVARA_PH_NASAL_N, 0, 0, 0, 0), 1,
  "quién = k j e n");
assert_eq(_esq(shabda_spanish_rules("fuego"), 5, SVARA_PH_FRIC_F, _gw, _ve, SVARA_PH_PLOSIVE_G, _vo, 0, 0, 0), 1,
  "fuego = f w e g o");
assert_eq(_esq(shabda_spanish_rules("aire"), 4, _va, _gj, SVARA_PH_TAP_FLAP, _ve, 0, 0, 0, 0), 1, "aire = a j ɾ e");
assert_eq(_esq(shabda_spanish_rules("auto"), 4, _va, _gw, SVARA_PH_PLOSIVE_T, _vo, 0, 0, 0, 0), 1, "auto = a w t o");
# iu / ui: the second vowel is the nucleus
assert_eq(_esq(shabda_spanish_rules("ciudad"), 6, SVARA_PH_FRIC_TH, _gj, _vu, SVARA_PH_PLOSIVE_D, _va,
    SVARA_PH_PLOSIVE_D, 0, 0), 1, "ciudad = θ j u d a d");
assert_eq(_esq(shabda_spanish_rules("cuidado"), 7, SVARA_PH_PLOSIVE_K, _gw, _vi, SVARA_PH_PLOSIVE_D, _va,
    SVARA_PH_PLOSIVE_D, _vo, 0), 1, "cuidado = k w i d a d o");
# a written accent marks a full vowel: hiatus
assert_eq(_esq(shabda_spanish_rules("día"), 3, SVARA_PH_PLOSIVE_D, _vi, _va, 0, 0, 0, 0, 0), 1, "día = d i a");
assert_eq(_esq(shabda_spanish_rules("baúl"), 4, SVARA_PH_PLOSIVE_B, _va, _vu, SVARA_PH_LATERAL_L, 0, 0, 0, 0), 1,
  "baúl = b a u l");

test_group("accuracy: Spanish gu gü, y ll ñ, the jota, x");
assert_eq(_esq(shabda_spanish_rules("guía"), 3, SVARA_PH_PLOSIVE_G, _vi, _va, 0, 0, 0, 0, 0), 1, "guía: silent u");
assert_eq(_esq(shabda_spanish_rules("agua"), 4, _va, SVARA_PH_PLOSIVE_G, _gw, _va, 0, 0, 0, 0), 1, "agua = a g w a");
assert_eq(_esq(shabda_spanish_rules("pingüino"), 8, SVARA_PH_PLOSIVE_P, _vi, SVARA_PH_NASAL_N, SVARA_PH_PLOSIVE_G,
    _gw, _vi, SVARA_PH_NASAL_N, _vo), 1, "pingüino: gü = g w");
assert_eq(_esq(shabda_spanish_rules("yo"), 2, SVARA_PH_FRIC_PALATAL_J, _vo, 0, 0, 0, 0, 0, 0), 1, "yo = ʝ o");
assert_eq(_esq(shabda_spanish_rules("calle"), 4, SVARA_PH_PLOSIVE_K, _va, SVARA_PH_FRIC_PALATAL_J, _ve,
    0, 0, 0, 0), 1, "calle = k a ʝ e (yeísmo)");
assert_eq(_esq(shabda_spanish_rules("hoy"), 2, _vo, _gj, 0, 0, 0, 0, 0, 0), 1, "hoy = o j");
assert_eq(_esq(shabda_spanish_rules("muy"), 3, SVARA_PH_NASAL_M, _vu, _gj, 0, 0, 0, 0, 0), 1, "muy = m u j");
assert_eq(_esq(shabda_spanish_rules("y"), 1, _vi, 0, 0, 0, 0, 0, 0, 0), 1, "y = i");
assert_eq(vec_get(shabda_spanish_rules("gélido"), 0), SVARA_PH_FRIC_UVULAR_CH, "gé: the jota (accented e)");
assert_eq(vec_get(shabda_spanish_rules("decía"), 2), SVARA_PH_FRIC_TH, "cí: /θ/ (accented i)");
assert_eq(_esq(shabda_spanish_rules("xilófono"), 8, SVARA_PH_FRIC_S, _vi, SVARA_PH_LATERAL_L, _vo, SVARA_PH_FRIC_F,
    _vo, SVARA_PH_NASAL_N, _vo), 1, "x- = /s/ word-initially");

