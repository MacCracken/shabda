# heteronym.tcyr — tests for src/heteronym.cyr (ports rust-old/src/heteronym.rs).
#
# Ports the module's 6 #[test] blocks 1:1, plus the serde-twin roundtrip
# (HeteronymRuleOwned clone + PartialEq) and a select_phonemes behavior check.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "lib/varna.cyr"
include "lib/shabdakosh.cyr"
include "src/error.cyr"
include "src/heteronym.cyr"

alloc_init();

# local helper: build a vec of cstr words
fn _words2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _words4(a, b, c, d): i64 {
    var v = vec_new();
    vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d);
    return v;
}
fn _words1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }

# ================================================================
# test_lookup_known_heteronym
test_group("lookup known heteronym");
assert_neq(shabda_heteronym_lookup("read"), 0, "read is known");
assert_neq(shabda_heteronym_lookup("lead"), 0, "lead is known");
assert_neq(shabda_heteronym_lookup("live"), 0, "live is known");

# ================================================================
# test_lookup_unknown_word
test_group("lookup unknown word");
assert_eq(shabda_heteronym_lookup("hello"), 0, "hello is unknown");
assert_eq(shabda_heteronym_lookup("world"), 0, "world is unknown");

# ================================================================
# test_select_variant_default — no trigger words → default variant (0). "wind" is
# a default-first rule ([/wɪnd/, /waɪnd/]); "read" is not, see the dictionary group.
test_group("select variant default");
var r_read = shabda_heteronym_lookup("read");
var r_wind = shabda_heteronym_lookup("wind");
assert_eq(shabda_select_variant(r_wind, _words2("the", "book")), 0, "default variant");

# ================================================================
# test_select_variant_triggered — "to" triggers non-default variant (1)
test_group("select variant triggered");
assert_eq(shabda_select_variant(r_wind, _words2("want", "to")), 1, "triggered variant");

# ================================================================
# test_select_variant_trigger_in_window — "will" within the 3-word lookback
test_group("select variant trigger in window");
assert_eq(shabda_select_variant(r_wind, _words2("i", "will")), 1, "will triggers");

# ================================================================
# case-insensitive triggering — Rust lowercases each preceding word
# (prev.to_lowercase()) before matching the (lowercase) trigger table.
test_group("select variant case insensitive");
assert_eq(shabda_select_variant(r_wind, _words2("want", "TO")), 1, "uppercase TO triggers");
assert_eq(shabda_select_variant(r_wind, _words2("I", "Will")), 1, "mixed-case Will triggers");

# ================================================================
# 3-word lookback window boundary — a trigger farther back than the last
# 3 preceding words must NOT trigger (Rust .rev().take(3)). Here "to" is the
# 4th-from-end word, so only ["b","c","d"] are examined → default (0).
test_group("select variant window boundary");
assert_eq(shabda_select_variant(r_wind, _words4("to", "b", "c", "d")), 0, "trigger outside 3-window is default");
# trigger exactly at the 3rd-from-end position IS examined → context (1).
assert_eq(shabda_select_variant(r_wind, _words4("x", "to", "c", "d")), 1, "trigger at edge of 3-window triggers");

# ================================================================
# single preceding word that is a trigger → context variant.
test_group("select variant single word");
assert_eq(shabda_select_variant(r_wind, _words1("to")), 1, "single trigger word");
assert_eq(shabda_select_variant(r_wind, _words1("book")), 0, "single non-trigger word");

# ================================================================
# serde roundtrip — HeteronymRuleOwned clone + PartialEq (field equality).
test_group("serde roundtrip");
var owned = shabda_heteronym_rule_clone(r_read);
var roundtripped = shabda_heteronym_rule_clone(owned);
assert_eq(shabda_heteronym_rule_eq(owned, roundtripped), 1, "clone roundtrip equal");
assert_eq(shabda_heteronym_rule_eq(owned, r_read), 1, "clone equals source");

# ================================================================
# test_all_heteronyms_have_triggers
test_group("all heteronyms have triggers");
var rules = _shabda_het_rules();
var i = 0;
var n = vec_len(rules);
var all_have = 1;
while (i < n) {
    var rule = vec_get(rules, i);
    if (vec_len(load64(rule + SHABDA_HET_TRIGGERS)) == 0) { all_have = 0; }
    i = i + 1;
}
assert_eq(all_have, 1, "every heteronym has triggers");
assert_eq(n, 20, "20 heteronym rules");

# ================================================================
# select_phonemes — bounds-checked variant selection over Pronunciations.
# variant 0 = default, variant 1 = context-triggered.
test_group("select phonemes");
var pv0 = vec_new(); vec_push(pv0, 10); vec_push(pv0, 11);
var pv1 = vec_new(); vec_push(pv1, 20); vec_push(pv1, 21);
var prons = vec_new();
vec_push(prons, shbdk_pronunciation_new(pv0));
vec_push(prons, shbdk_pronunciation_new(pv1));

# default context ("the","book") → variant 0 → pv0
var def_ph = shabda_select_phonemes(r_wind, _words2("the", "book"), prons);
assert_eq(vec_get(def_ph, 0), 10, "default phonemes[0]");

# triggered context ("want","to") → variant 1 → pv1
var trig_ph = shabda_select_phonemes(r_wind, _words2("want", "to"), prons);
assert_eq(vec_get(trig_ph, 0), 20, "triggered phonemes[0]");

# out-of-range fallback: single-pronunciation dict, triggered → falls back to prons[0]
var prons1 = vec_new();
vec_push(prons1, shbdk_pronunciation_new(pv0));
var fb_ph = shabda_select_phonemes(r_wind, _words2("want", "to"), prons1);
assert_eq(vec_get(fb_ph, 0), 10, "fallback to prons[0]");

# ================================================================
# 3.0.3 regression
# ================================================================
test_group("3.0.3: select_phonemes survives an empty pronunciation vec");
# Rust's fallback arm is `pronunciations[0]`, which panics on an empty slice. Here
# vec_get(v, 0) reaches lib/vec.cyr's _vec_die() -> syscall(SYS_EXIT, 1): it does
# not unwind and does not return a code, it terminates the HOST process. An empty
# vec is reachable — shbdk_dict_lookup_all returns shbdk_dict_entry_all(e) verbatim
# and a caller-built entry can hold zero pronunciations. Reaching this assertion at
# all is the test.
var empty_prons = vec_new();
var r_read2 = shabda_heteronym_lookup("read");
assert_eq(r_read2 != 0, 1, "'read' is a heteronym");
var ep = shabda_select_phonemes(r_read2, _words2("the", "book"), empty_prons);
assert_eq(vec_len(ep), 0, "empty pronunciations -> empty phonemes, not a process exit");

# ================================================================
# accuracy: each rule picks the sense its name says, from the real dictionary
# ================================================================
test_group("accuracy: every rule's default and context picks, against shabdakosh's entries");
# Through 3.1.2 seven rules assumed the default pronunciation is listed first; the
# dictionary lists read / lead / tear / bow / record / refuse / produce the other way
# round, so each picked the other sense in every context ("I will read" -> /rɛd/).
var hd = shbdk_dict_english();
fn _het_pick(d, word, ctx): cstring {
    var r = shabda_heteronym_lookup(word);
    return shbdk_phonemes_to_ipa(shabda_select_phonemes(r, ctx, shbdk_dict_lookup_all(d, word)));
}
var no_ctx = _words1("xyzzy");
assert_streq(_het_pick(hd, "read", no_ctx), "ɹɛd", "read: default past");
assert_streq(_het_pick(hd, "read", _words2("i", "will")), "ɹiːd", "read: will -> present");
assert_streq(_het_pick(hd, "lead", no_ctx), "liːd", "lead: default /liːd/, the commoner reading");
assert_streq(_het_pick(hd, "lead", _words1("to")), "liːd", "lead: to -> verb");
assert_streq(_het_pick(hd, "tear", _words1("a")), "tɪɹ", "tear: default the eye's");
assert_streq(_het_pick(hd, "tear", _words1("to")), "tɛɹ", "tear: to -> rip");
assert_streq(_het_pick(hd, "bow", _words2("a", "long")), "boʊ", "bow: default the weapon, 'a' is no trigger");
assert_streq(_het_pick(hd, "bow", _words2("take", "a")), "baʊ", "bow: take a -> bend");
assert_streq(_het_pick(hd, "record", _words1("a")), "ɹɛkɜd", "record: default noun");
assert_streq(_het_pick(hd, "record", _words1("to")), "ɹɪkɔɹd", "record: to -> verb");
assert_streq(_het_pick(hd, "refuse", _words1("to")), "ɹɪfjuz", "refuse: to -> verb");
assert_streq(_het_pick(hd, "produce", no_ctx), "pɹɑdus", "produce: default noun");
assert_streq(_het_pick(hd, "produce", _words1("to")), "pɹədus", "produce: to -> verb");
assert_streq(_het_pick(hd, "live", _words1("they")), "lɪv", "live: default verb");
assert_streq(_het_pick(hd, "live", _words1("go")), "laɪv", "live: go -> adjective");
assert_streq(_het_pick(hd, "wind", no_ctx), "wɪnd", "wind: default air");
assert_streq(_het_pick(hd, "close", _words1("too")), "kloʊs", "close: too -> adjective");
assert_streq(_het_pick(hd, "present", _words1("to")), "pɹɪzɛnt", "present: to -> verb");
assert_streq(_het_pick(hd, "object", _words1("i")), "əbd͡ʒɛkt", "object: i -> verb");
assert_streq(_het_pick(hd, "desert", _words1("the")), "dɛzɜt", "desert: default noun");
assert_streq(_het_pick(hd, "minute", _words2("wait", "a")), "mɪnət", "minute: 'a' is no trigger");
assert_streq(_het_pick(hd, "minute", _words1("very")), "maɪnut", "minute: very -> adjective");
assert_streq(_het_pick(hd, "bass", _words2("the", "electric")), "beɪs", "bass: 'the' is no trigger");
assert_streq(_het_pick(hd, "bass", _words2("caught", "a")), "bæs", "bass: caught -> fish");
assert_streq(_het_pick(hd, "dove", _words1("she")), "doʊv", "dove: she -> past of dive");

# ================================================================
test_group("3.2.0: select_pronunciation gives the variant select_phonemes reads");
var sp_rule = shabda_heteronym_lookup("record");
var sp_d = shbdk_dict_english();
var sp_all = shbdk_dict_lookup_all(sp_d, "record");
var sp_none = vec_new();
var sp_to = vec_new();
vec_push(sp_to, "to");
var sp_n = _shabda_select_pronunciation_a(default_alloc(), sp_rule, sp_none, sp_all);
var sp_v = _shabda_select_pronunciation_a(default_alloc(), sp_rule, sp_to, sp_all);
assert_eq(shbdk_pronunciation_phonemes(sp_n), shabda_select_phonemes(sp_rule, sp_none, sp_all), "the default variant");
assert_eq(shbdk_pronunciation_phonemes(sp_v), shabda_select_phonemes(sp_rule, sp_to, sp_all), "the context variant");
assert_eq(shbdk_pronunciation_stress_at(sp_n, 1), SHBDK_STRESS_PRIMARY, "the noun: REcord");
assert_eq(shbdk_pronunciation_stress_at(sp_v, 3), SHBDK_STRESS_PRIMARY, "the verb: reCORD");
assert_eq(_shabda_select_pronunciation_a(default_alloc(), sp_rule, sp_none, vec_new()), 0, "no pronunciation: 0");

var rc = assert_summary();
syscall(SYS_EXIT, rc);
