# normalize.tcyr — tests for src/normalize.cyr (ports rust-old/src/normalize.rs).
# Ports the ~25 inline #[test] blocks 1:1 into assert_streq/assert_eq checks.

include "src/error.cyr"
include "src/normalize.cyr"

alloc_init();

# ================================================================
test_group("normalize basic + punctuation + spaces");
# '!' ends a sentence as '.' does (it was dropped through 3.1.2).
assert_streq(shabda_normalize("Hello World!"), "hello world .pause", "normalize basic");
assert_streq(shabda_normalize("it's a test."), "it's a test .pause", "normalize period");
assert_streq(shabda_normalize("too   many   spaces"), "too many spaces", "normalize multi-space");

# ================================================================
test_group("detect_intonation");
assert_eq(shabda_detect_intonation("hello?"), SHABDA_STYPE_QUESTION, "question");
assert_eq(shabda_detect_intonation("wow!"), SHABDA_STYPE_EXCLAMATION, "exclamation");
assert_eq(shabda_detect_intonation("ok."), SHABDA_STYPE_STATEMENT, "statement");
assert_eq(shabda_sentence_type("hello?"), SHABDA_STYPE_QUESTION, "sentence_type alias");

# ================================================================
test_group("number expansion");
assert_streq(shabda_expand_numbers("0"), "zero", "expand zero");
assert_streq(shabda_expand_numbers("42"), "forty two", "expand small");
assert_streq(shabda_expand_numbers("100"), "one hundred", "expand hundred");
assert_streq(shabda_expand_numbers("1000"), "one thousand", "expand thousand");
assert_streq(shabda_expand_numbers("1234"), "one thousand two hundred thirty four", "expand complex");
assert_streq(shabda_expand_numbers("1,000"), "one thousand", "expand comma");
assert_streq(shabda_expand_numbers("3.14"), "three point one four", "expand decimal");
assert_streq(shabda_expand_numbers("-5"), "negative five", "expand negative");
assert_streq(shabda_expand_numbers("I have 42 cats"), "I have forty two cats", "expand in sentence");
assert_streq(shabda_expand_numbers("no numbers here"), "no numbers here", "expand no numbers");
# large integers: parse::<u64> path up to i64::MAX (matches Rust number_to_words).
assert_streq(shabda_expand_numbers("1000000"), "one million", "expand one million");
assert_streq(shabda_expand_numbers("1000000000"), "one billion", "expand one billion");
var i64max_words = str_builder_new();
str_builder_add_cstr(i64max_words, "nine billion two hundred twenty three million three hundred seventy two thousand ");
str_builder_add_cstr(i64max_words, "thirty six billion eight hundred fifty four million ");
str_builder_add_cstr(i64max_words, "seven hundred seventy five thousand eight hundred seven");
assert_streq(shabda_expand_numbers("9223372036854775807"), str_cstr(str_builder_build(i64max_words)),
  "expand i64::MAX");

# ================================================================
test_group("normalize with numbers + pauses");
assert_streq(shabda_normalize("I have 42 cats!"), "i have forty two cats .pause", "normalize with numbers");
# comma pause: result contains ",pause"
assert_eq(strstr(shabda_normalize("hello, world"), SHABDA_COMMA_PAUSE) >= 0, 1, "comma pause present");
assert_eq(strstr(shabda_normalize("first. second"), SHABDA_PERIOD_PAUSE) >= 0, 1, "period pause present");

# ================================================================
test_group("abbreviations");
assert_streq(shabda_expand_abbreviations("Dr. Smith"), "doctor Smith", "abbr dr");
assert_streq(shabda_expand_abbreviations("Mr. Jones"), "mister Jones", "abbr mr");
assert_streq(shabda_expand_abbreviations("test."), "test.", "abbr not mid-word");
assert_eq(strstr(shabda_normalize("Dr. Smith is here"), "doctor") >= 0, 1, "abbr in normalize");

# ================================================================
test_group("acronyms");
# One token, letters joined by hyphens, which the English engine says by the letters'
# names (through 3.1.2 "f b i", three tokens said /f b aɪ/).
assert_streq(shabda_expand_acronyms("FBI"), "f-b-i", "acronym spell out");
assert_streq(shabda_expand_acronyms("NASA"), "nasa", "acronym pronounceable");
assert_streq(shabda_expand_acronyms("I am OK"), "I am OK", "acronym short not matched");
assert_streq(shabda_expand_acronyms("the FBI and NASA"), "the f-b-i and nasa", "acronym in sentence");

# ================================================================
test_group("foreign words + diacritics");
assert_eq(shabda_is_foreign_word("café"), 1, "foreign café");
assert_eq(shabda_is_foreign_word("naïve"), 1, "foreign naïve");
assert_eq(shabda_is_foreign_word("hello"), 0, "not foreign hello");
assert_streq(shabda_strip_diacritics("café"), "cafe", "strip café");
assert_streq(shabda_strip_diacritics("naïve"), "naive", "strip naïve");
assert_streq(shabda_strip_diacritics("résumé"), "resume", "strip résumé");

# ================================================================
# Emphasis (from the doctest on normalize_with_emphasis).
test_group("normalize_with_emphasis");
var emres = shabda_normalize_with_emphasis("HELLO world");
assert_eq(strstr(emres, SHABDA_EMPHASIS_START) >= 0, 1, "emph start present");
assert_eq(strstr(emres, "hello") >= 0, 1, "emph lowercased word present");
assert_eq(strstr(emres, SHABDA_EMPHASIS_END) >= 0, 1, "emph end present");

# ================================================================
# 3.0.3 regressions — Unicode parity with char::is_whitespace /
# to_lowercase / is_uppercase / is_alphabetic
# ================================================================
test_group("3.0.3: whitespace is the Unicode White_Space property, not ASCII");
# Rust splits on char::is_whitespace, so NBSP separates two words. The ASCII-only
# predicate glued them into one token, which then went to the rules engine whole.
assert_eq(streq(shabda_normalize("hello\xC2\xA0world"), "hello world"), 1,
  "U+00A0 NBSP separates words (was glued)");
assert_eq(streq(shabda_normalize("hello\xE3\x80\x80world"), "hello world"), 1,
  "U+3000 IDEOGRAPHIC SPACE separates words");
assert_eq(streq(shabda_normalize("a\xE2\x80\x89b"), "a b"), 1,
  "U+2009 THIN SPACE separates words");
assert_eq(shabda_is_ws_cp(0xA0), 1, "U+00A0 is whitespace");
assert_eq(shabda_is_ws_cp(0x3000), 1, "U+3000 is whitespace");
assert_eq(shabda_is_ws_cp(0x2028), 1, "U+2028 LINE SEPARATOR is whitespace");
assert_eq(shabda_is_ws_cp(0x200B), 0, "U+200B ZERO WIDTH SPACE is NOT White_Space");
assert_eq(shabda_is_ws_cp(0x0B), 1, "VT is whitespace");
assert_eq(shabda_is_ws_cp(0x0C), 1, "FF is whitespace");

test_group("3.0.3: trailing Unicode whitespace no longer hides the terminal mark");
# detect_intonation inlined an ASCII-only trim_end, so a trailing NBSP left the
# last byte as 0xA0 and every such question read as a Statement.
assert_eq(shabda_detect_intonation("really?\xC2\xA0"), SHABDA_STYPE_QUESTION,
  "'really?' + NBSP is still a Question");
assert_eq(shabda_detect_intonation("wow!\xE3\x80\x80"), SHABDA_STYPE_EXCLAMATION,
  "'wow!' + U+3000 is still an Exclamation");
assert_eq(shabda_detect_intonation("plain."), SHABDA_STYPE_STATEMENT, "'.' is a Statement");
assert_eq(shabda_detect_intonation("really? "), SHABDA_STYPE_QUESTION, "ASCII space still works");

test_group("3.0.3: case folding covers Unicode, not just ASCII");
# to_lowercase() is Unicode in Rust; the ASCII-only fold left accented capitals
# unchanged, so "CAFÉ" reached the letter-to-sound rules as "cafÉ".
assert_eq(streq(shabda_normalize("CAF\xC3\x89"), "caf\xC3\xA9"), 1, "CAFE-acute lowers to cafe-acute");
assert_eq(streq(shabda_normalize("\xC3\x9CBER"), "\xC3\xBCber"), 1, "U-umlaut lowers");

test_group("3.0.3: is_alphabetic covers every script, not five hard-coded ranges");
# Greek / Cyrillic / Hebrew were in NO range, so normalize deleted them outright
# and the whole word became empty.
assert_eq(streq(shabda_normalize("\xCE\x91\xCE\x92\xCE\x93"), "\xCE\xB1\xCE\xB2\xCE\xB3"), 1,
  "Greek survives normalize and lowercases (was deleted)");
assert_eq(streq(shabda_normalize("\xD0\x9C\xD0\xBE\xD1\x81"), "\xD0\xBC\xD0\xBE\xD1\x81"), 1,
  "Cyrillic survives normalize and lowercases (was deleted)");
# The scripts that DID have ranges must be unchanged — this is the regression the
# module header warns about (dropping them made native-script convert emit 0 events).
assert_eq(strlen(shabda_normalize("\xE0\xA4\xA8\xE0\xA4\xAE\xE0\xA4\xB8\xE0\xA5\x8D\xE0\xA4\xA4\xE0\xA5\x87")) > 0, 1,
  "Devanagari still survives (matras are Other_Alphabetic)");
assert_eq(strlen(shabda_normalize("\xD9\x83\xD8\xAA\xD8\xA7\xD8\xA8")) > 0, 1, "Arabic still survives");

test_group("3.0.3: ALL-CAPS emphasis reaches non-ASCII scripts");
var gem = shabda_normalize_with_emphasis("\xCE\x94\xCE\x95\xCE\x96 ok");
assert_eq(strstr(gem, SHABDA_EMPHASIS_START) >= 0, 1, "Greek ALL-CAPS gets an emphasis marker");

test_group("3.1.2: a refused builder grow stops the push instead of overflowing");
# Through 3.1.1 _shabda_sb_reserve returned 0 when the larger buffer was refused,
# and every push then wrote past the old one. An arena of exactly the builder's
# header and 16-byte buffer plus an 8-byte canary refuses the first grow.
var sb_ar = arena_allocator(48);
var sb = _shabda_sb_new_a(sb_ar);
var canary = alloc_via(sb_ar, 8);
store64(canary, 0x5A5A5A5A5A5A5A5A);
var sbi = 0;
while (sbi < 20) { _shabda_sb_push_byte_a(sb_ar, sb, 120); sbi = sbi + 1; }
assert_eq(load64(canary), 0x5A5A5A5A5A5A5A5A, "push_byte leaves the next allocation alone");
assert_eq(_shabda_sb_len(sb), 15, "the build stops at the 16-byte buffer, NUL included");
assert_eq(strlen(_shabda_sb_cstr(sb)), 15, "and stays NUL-terminated");
_shabda_sb_push_cstr_a(sb_ar, sb, "more than fits");
assert_eq(load64(canary), 0x5A5A5A5A5A5A5A5A, "push_cstr leaves it alone too");
assert_eq(_shabda_sb_len(sb), 15, "push_cstr adds nothing it has no room for");

# ================================================================
# accuracy: what an English reader says
# ================================================================
test_group("accuracy: ordinals");
assert_streq(shabda_expand_numbers("1st 2nd 3rd 4th"), "first second third fourth", "1st..4th (was onest twond ...)");
assert_streq(shabda_expand_numbers("21st 12th 20th 100th"), "twenty first twelfth twentieth one hundredth", "compound");
assert_streq(shabda_expand_numbers("1,000th"), "one thousandth", "grouped");
assert_streq(shabda_expand_numbers("5k"), "five k", "not a suffix: a separate word");

test_group("accuracy: currency and percent");
assert_streq(shabda_expand_numbers("$3.50"), "three dollars and fifty cents", "$3.50");
assert_streq(shabda_expand_numbers("$1"), "one dollar", "$1 singular");
assert_streq(shabda_expand_numbers("$0.99"), "ninety nine cents", "$0.99");
assert_streq(shabda_expand_numbers("$1.01"), "one dollar and one cent", "$1.01");
assert_streq(shabda_expand_numbers("$2.5"), "two dollars and fifty cents", "$2.5");
assert_streq(shabda_expand_numbers("$5 million"), "five million dollars", "$5 million");
assert_streq(shabda_expand_numbers("£3 €20.10"), "three pounds twenty euros and ten cents", "pounds, euros");
assert_streq(shabda_expand_numbers("50%"), "fifty percent", "50% (was fifty)");
assert_streq(shabda_expand_numbers("2.5%"), "two point five percent", "2.5%");

test_group("accuracy: clock times, years, digit strings");
assert_streq(shabda_expand_numbers("3:30"), "three thirty", "3:30");
assert_streq(shabda_expand_numbers("3:05"), "three oh five", "3:05 (was three five)");
assert_streq(shabda_expand_numbers("10:00"), "ten", "10:00");
assert_streq(shabda_expand_numbers("in 1999"), "in nineteen ninety nine", "a year after 'in'");
assert_streq(shabda_expand_numbers("May 1905"), "May nineteen oh five", "after a month");
assert_streq(shabda_expand_numbers("since 1900"), "since nineteen hundred", "x00");
assert_streq(shabda_expand_numbers("the 1990s"), "the nineteen nineties", "a decade");
assert_streq(shabda_expand_numbers("the 80s"), "the eighties", "a short decade");
assert_streq(shabda_expand_numbers("1500 BC"), "fifteen hundred BC", "before an era");
assert_streq(shabda_expand_numbers("1234"), "one thousand two hundred thirty four", "no date context: a quantity");
assert_streq(shabda_expand_numbers("007"), "zero zero seven", "a leading zero: digit by digit (was seven)");

test_group("accuracy: minus signs, ranges, hyphens");
assert_streq(shabda_expand_numbers("10-20"), "ten to twenty", "a range (was ten negative twenty)");
assert_streq(shabda_expand_numbers("from 1990\xE2\x80\x9399"), "from nineteen ninety to ninety nine",
  "an en-dash range");
assert_streq(shabda_expand_numbers("COVID-19"), "COVID nineteen", "a word-number hyphen (was negative)");
assert_streq(shabda_expand_numbers("it is -5"), "it is negative five", "a minus sign");
assert_streq(shabda_expand_numbers("5km"), "five km", "a unit glued on is its own word (was fivekm)");

test_group("accuracy: sentence and phrase pauses");
assert_streq(shabda_normalize("Really? Yes."), "really .pause yes .pause", "'?' ends a sentence");
assert_streq(shabda_normalize("Wait... what?!"), "wait .pause what .pause", "an ellipsis, ?! : one pause each");
assert_streq(shabda_normalize("one, . two"), "one .pause two", "a comma then a period: the period");
assert_streq(shabda_normalize("salt & pepper"), "salt and pepper", "'&' is and");

test_group("accuracy: abbreviations in context");
assert_streq(shabda_normalize("Main St. near St. Paul"), "main street near saint paul", "St.: street, then saint");
assert_streq(shabda_normalize("Elm Dr. is near Dr. Smith"), "elm drive is near doctor smith",
  "Dr.: drive, then doctor");
assert_streq(shabda_normalize("pears, etc. Then"), "pears ,pause et cetera .pause then", "etc. ends the sentence");
assert_streq(shabda_normalize("etc. and so"), "et cetera and so", "etc. mid-sentence");
assert_streq(shabda_normalize("Mr. Smith"), "mister smith", "a title's period ends nothing");
assert_streq(shabda_normalize("e.g. this, i.e. that"), "for example this ,pause that is that",
  "e.g. i.e.");
assert_streq(shabda_normalize("the U.S. is big"), "the u-s is big", "a dotted initialism is spelled");
assert_streq(shabda_normalize("at 5 p.m. Then"), "at five p-m .pause then", "p.m. ending a sentence");

test_group("accuracy: acronyms read as words or spelled");
# Through 3.1.2 any acronym starting with a vowel, or a consonant + vowel, was a word.
assert_streq(shabda_expand_acronyms("NASA NATO SCUBA LASER AIDS OPEC IKEA NAFTA AIM"),
  "nasa nato scuba laser aids opec ikea nafta aim", "words");
assert_streq(shabda_expand_acronyms("IBM ATM ESPN USB FAQ NIH HIV"), "i-b-m a-t-m e-s-p-n u-s-b f-a-q n-i-h h-i-v",
  "an impossible English coda: spelled");
assert_streq(shabda_expand_acronyms("CIA CEO IOU NAACP"), "c-i-a c-e-o i-o-u n-a-a-c-p", "vowels in hiatus: spelled");
assert_streq(shabda_expand_acronyms("USA UFO ICU"), "u-s-a u-f-o i-c-u", "three letters from a lone vowel: spelled");

test_group("accuracy: combining marks that follow a letter stay in the word");
# Through 3.1.2 normalize kept only Alphabetic code points, which the virama, nukta,
# sukun, maddah and superscript alef are not: धर्मः became धरमः.
assert_streq(shabda_normalize("धर्मः"), "धर्मः", "Sanskrit: the virama stays");
assert_streq(shabda_normalize("बड़ा"), "बड़ा", "Hindi: ड + nukta stays");
assert_streq(shabda_normalize("مَدْرَسَة"), "مَدْرَسَة", "Arabic: sukun stays");
assert_streq(shabda_normalize("قُرْآن"), "قُرْآن", "Arabic: maddah stays");
assert_streq(shabda_normalize("هٰذا"), "هٰذا", "Arabic: superscript alef stays");
assert_streq(shabda_normalize("e\xCC\x81t\xC3\xA9"), "e\xCC\x81t\xC3\xA9", "a Latin combining acute stays");
assert_streq(shabda_normalize("a \xE0\xA5\x8D b"), "a b", "a mark with no letter before it is dropped");

test_group("3.1.3: e.g. and i.e. end no sentence");
assert_streq(shabda_normalize("Rock, e.g. Elvis."), "rock ,pause for example elvis .pause", "e.g. before a name");
assert_streq(shabda_normalize("One, i.e. Two."), "one ,pause that is two .pause", "i.e. before a capital");
assert_streq(shabda_normalize("Pens, paper, etc. Then go."), "pens ,pause paper ,pause et cetera .pause then go .pause",
  "etc. before a capital still ends the sentence");

var rc = assert_summary();
syscall(SYS_EXIT, rc);
